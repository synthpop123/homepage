{
  "name": "homepage",
  "type": "module",
  "version": "2.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild:assets": "bun scripts/prebuild.ts",
    "dev": "bun run prebuild:assets && astro dev",
    "build": "bun run prebuild:assets && astro check && astro build --force",
    "preview": "astro preview",
    "astro": "astro",
    "test": "bun test",
    "check:links": "bun scripts/check-links.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:staged": "biome format --staged --write --files-ignore-unknown=true --no-errors-on-unmatched",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-collapsible-sections": "^0.42.0",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.8",
    "d3-geo": "^3.1.1",
    "github-slugger": "^2.0.0",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "hastscript": "^9.0.1",
    "mermaid": "^12.2.0",
    "photoswipe": "^5.4.4",
    "satori": "^0.33.5",
    "satteri-expressive-code": "^0.1.24",
    "temml": "^0.14.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.3",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "fflate": "^0.7.5",
    "lodash-es": "^4.18.1",
    "source-map-js": "^1.2.2"
  }
}
