{
  "name": "homepage",
  "type": "module",
  "version": "2.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild:assets": "bun scripts/prebuild.ts",
    "dev": "bun run prebuild:assets && astro dev",
    "build": "bun run prebuild:assets && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "bun test",
    "check:links": "bun scripts/check-links.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:staged": "biome format --staged --write --files-ignore-unknown=true --no-errors-on-unmatched",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-collapsible-sections": "^0.42.0",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.2.9",
    "cobe": "^2.0.1",
    "github-slugger": "^2.0.0",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "hastscript": "^9.0.1",
    "mermaid": "^11.17.2",
    "photoswipe": "^5.4.4",
    "satori": "^0.28.2",
    "satteri-expressive-code": "^0.1.24",
    "temml": "^0.13.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "sharp": "^0.35.4",
    "subset-font": "^2.6.0",
    "typescript": "^6.0.3"
  }
}
