---
import CodeTabs from "@/components/CodeTabs.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { PROFILE_TABS } from "@/consts"
import { Image } from "astro:assets"
import monoWoff2 from "@/assets/fonts/GeistMono-Variable.woff2?url"
// Downloaded at build time by scripts/prebuild.ts (random cat per build).
import catImage from "@/assets/cat.jpg"
---

<Layout>
  <MetaPage slot="head" />
  {/* The profile code block is above the fold here, and on a phone its
      long lines wrap, so a late swap to Geist Mono moves the breaks. */}
  <link
    rel="preload"
    href={monoWoff2}
    as="font"
    type="font/woff2"
    crossorigin
    slot="head"
  >
  <dictionary-entry>
    <h1>lkw123</h1>
    <etymology-span>
      <ipa-span>/Yet another salted fish/</ipa-span>
      (•‾⌣‾•)
    </etymology-span>
    <cat-figure>
      <Image src={catImage} alt="A random cat" width={1280} priority />
      <button
        id="cat-refresh"
        data-icon-button
        aria-label="Fetch a new cat"
        title="Fetch a new cat"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
          <polyline points="21 3 21 9 15 9"></polyline>
        </svg>
      </button>
    </cat-figure>
    <CodeTabs tabs={PROFILE_TABS} />
  </dictionary-entry>
</Layout>

<script>
  const figure = document.querySelector("cat-figure")
  const img = figure?.querySelector("img")
  const button = document.getElementById(
    "cat-refresh",
  ) as HTMLButtonElement | null

  if (figure && img && button) {
    button.addEventListener("click", () => {
      button.disabled = true
      figure.setAttribute("data-loading", "")
      figure.setAttribute("aria-busy", "true")

      const url = `https://cataas.com/cat?width=1280&t=${Date.now()}`
      const next = new Image()
      const done = () => {
        button.disabled = false
        figure.removeAttribute("data-loading")
        figure.removeAttribute("aria-busy")
      }
      next.onload = () => {
        // Drop the build-time srcset so the freshly fetched cat wins.
        img.removeAttribute("srcset")
        img.src = url
        done()
      }
      next.onerror = done
      next.src = url
    })
  }
</script>

<style>
  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    cat-figure {
      position: relative;
      display: block;
      margin-block-start: var(--space-s);
      inline-size: 80%;

      img {
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        transition: opacity 0.3s ease;
      }

      button {
        position: absolute;
        inset-block-end: var(--space-2xs);
        inset-inline-end: var(--space-2xs);
        color: var(--gray-1);
        background-color: color-mix(in oklab, var(--gray-12) 55%, transparent);
        backdrop-filter: blur(var(--blur-sm));

        &:hover {
          background-color: color-mix(
            in oklab,
            var(--gray-12) 75%,
            transparent
          );
        }
      }

      &[data-loading] {
        img {
          opacity: 0.6;
        }

        button svg {
          @media (prefers-reduced-motion: no-preference) {
            animation: cat-spin 1s linear infinite;
          }
        }
      }
    }

    :global(code-tabs) {
      display: block;
      margin-block-start: var(--space-m);
    }
  }

  @keyframes cat-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
