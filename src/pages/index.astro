---
import MetaPage from "@/components/MetaPage.astro"
import Now from "@/components/Now.astro"
import PostList from "@/components/PostList.astro"
import PostStrip from "@/components/PostStrip.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { API, NOW } from "@/consts"
import { getSeries, timeline } from "@/lib/content"
import { catSerial } from "@/lib/utils"
import { Image } from "astro:assets"
// Written by scripts/prebuild.ts: cat-default.jpg, or the CAT_IMAGE override.
import catImage from "@/assets/cat.jpg"

const series = await getSeries()
const posts = series.slice(0, 3).map(([post]) => post)
// Beside Writing: every post as a cell, the three listed here lit.
const cells = timeline(
  series,
  posts.map((post) => post.id),
  { related: false },
)

const toc = [
  {
    label: "Home",
    headings: [
      { depth: 2, slug: "profile", text: "Profile" },
      { depth: 2, slug: "writing", text: "Writing" },
      { depth: 2, slug: "now", text: "Now" },
    ],
  },
]
---

<Layout>
  <MetaPage slot="head" />
  <link rel="preconnect" href={API} crossorigin slot="head">
  <link rel="preload" as="fetch" href={NOW.endpoint} crossorigin slot="head">
  <TableOfContents slot="toc" title="Home" sections={toc} />
  <section aria-labelledby="profile">
    <dictionary-entry>
      <h1 id="profile">lkw123</h1>
      <etymology-span>
        <ipa-span>/Yet another salted fish/</ipa-span>
        (•‾⌣‾•)
      </etymology-span>
      <cat-figure>
        <figure>
          <Image
            src={catImage}
            alt="A cat"
            widths={[480, 800, 1280]}
            sizes="(width >= 64rem) 35rem, 80vw"
            priority
          />
          <figcaption>
            <span
              >Cat as a service #<span id="cat-serial"
                >{catSerial()}</span
              ></span
            >
            <button
              id="cat-refresh"
              data-icon-button
              aria-label="Fetch a new cat"
              title="Fetch a new cat"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
                <polyline points="21 3 21 9 15 9"></polyline>
              </svg>
            </button>
          </figcaption>
        </figure>
      </cat-figure>
    </dictionary-entry>
  </section>
  <section aria-labelledby="writing">
    <div class="home-head">
      <h2 id="writing">Writing</h2>
      <a
        class="section-link"
        href="/blog"
        aria-label={`All ${series.length} posts`}
      >
        <PostStrip cells={cells} mini />
        {series.length}
        posts
      </a>
    </div>
    <PostList posts={posts} />
  </section>
  <section aria-labelledby="now">
    <div class="home-head"><h2 id="now">Now</h2></div>
    <Now />
  </section>
</Layout>

<script>
  import { catSerial } from "@/lib/utils"

  const stack = document.querySelector("cat-figure")
  const print = stack?.querySelector("figure")
  const img = print?.querySelector("img")
  const serial = document.getElementById("cat-serial")
  const button = document.getElementById(
    "cat-refresh",
  ) as HTMLButtonElement | null

  if (stack && print && img && serial && button) {
    const still = matchMedia("(prefers-reduced-motion: reduce)")
    // Each new print lands at its own slight angle, never square.
    const tilt = () => {
      const angle = (0.6 + Math.random() * 1.8).toFixed(1)
      print.style.setProperty(
        "--tilt",
        `${Math.random() < 0.5 ? "-" : ""}${angle}deg`,
      )
    }

    button.addEventListener("click", () => {
      button.disabled = true
      stack.setAttribute("data-loading", "")
      stack.setAttribute("aria-busy", "true")

      const url = `https://cataas.com/cat?width=1280&t=${Date.now()}`
      const next = new Image()
      const done = () => {
        button.disabled = false
        stack.removeAttribute("data-loading")
        stack.removeAttribute("aria-busy")
      }
      const swap = async () => {
        // Drop the build-time srcset so the freshly fetched cat wins.
        img.removeAttribute("srcset")
        img.src = url
        await img.decode().catch(() => {})
        serial.textContent = catSerial()
        tilt()
      }
      next.onload = async () => {
        if (still.matches) {
          await swap()
          return done()
        }
        // The top print is pulled off the stack; the new one settles
        // where it lay.
        const out = print.animate(
          [{}, { translate: "45% -6%", rotate: "10deg", opacity: 0 }],
          {
            duration: 320,
            easing: "cubic-bezier(0.4, 0, 1, 1)",
            fill: "forwards",
          },
        )
        await out.finished
        await swap()
        out.cancel()
        print.animate(
          [{ translate: "0 0.5rem", scale: 0.96, opacity: 0 }, {}],
          { duration: 360, easing: "cubic-bezier(0.2, 0, 0, 1)" },
        )
        done()
      }
      next.onerror = done
      next.src = url
    })
  }
</script>

<style>
  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    /* The cat as a print on a small stack of them: a photo on paper,
       never quite square to the page, its number written underneath.
       The photo keeps the 3:2 frame it always had. */
    cat-figure {
      /* White paper on a light page; on a dark one a grey print, so it
         sits in the dark instead of glowing. */
      --paper: light-dark(#ffffff, var(--gray-4));
      /* Shadows vanish on a dark page; a hairline keeps each edge. */
      --paper-edge: light-dark(transparent, var(--gray-6));

      position: relative;
      isolation: isolate;
      display: block;
      inline-size: calc(80% + 1.5rem);
      margin-block: var(--space-m) var(--space-xs);
      margin-inline-start: 0.25rem;

      /* The prints underneath, each at its own angle. */
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 2px;
        background-color: var(--paper);
        box-shadow:
          0 0 0 1px var(--paper-edge),
          0 1px 3px rgb(0 0 0 / 0.12);
      }

      &::before {
        rotate: 3.5deg;
        translate: 0.35rem 0.15rem;
      }

      &::after {
        rotate: -3deg;
        translate: -0.25rem 0.3rem;
      }

      figure {
        position: relative;
        z-index: 1;
        margin: 0;
        padding: 0.75rem 0.75rem 0;
        border-radius: 2px;
        background-color: var(--paper);
        box-shadow:
          0 0 0 1px var(--paper-edge),
          0 1px 2px rgb(0 0 0 / 0.08),
          0 12px 32px -14px rgb(0 0 0 / 0.3);
        rotate: var(--tilt, -1.5deg);
        transition: rotate 0.5s cubic-bezier(0.2, 0, 0, 1);
      }

      img {
        display: block;
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        border-radius: 1px;
        transition: opacity 0.3s ease;
      }

      figcaption {
        display: flex;
        align-items: center;
        justify-content: space-between;
        block-size: 2.5rem;
        font-family: var(--font-mono);
        font-feature-settings: normal;
        font-size: 0.75rem;
        letter-spacing: 0;
        color: var(--muted-foreground);
      }

      button {
        margin-inline-end: -0.5rem;
        color: var(--muted-foreground);

        &:hover {
          background-color: color-mix(
            in oklab,
            var(--foreground) 8%,
            transparent
          );
        }
      }

      @media (hover: hover) {
        figure:hover {
          rotate: calc(var(--tilt, -1.5deg) * -0.4);
        }
      }

      &[data-loading] {
        img {
          opacity: 0.6;
        }

        button svg {
          @media (prefers-reduced-motion: no-preference) {
            animation: cat-spin 1s linear infinite;
          }
        }
      }
    }
  }

  /* All posts: the strip of every post, then how many there are. */
  .home-head .section-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  section + section {
    margin-block-start: var(--space-l);
  }

  /* A section's name as a quiet label, and on the far end of its row the
     one link it has (.section-link, feed.css). */
  .home-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-xs);

    h2 {
      margin: 0;
      font-size: var(--step--1);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }
  }

  @keyframes cat-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
