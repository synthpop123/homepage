---
import MetaPage from "@/components/MetaPage.astro"
import Now from "@/components/Now.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { API, NOW } from "@/consts"
import { getPosts, titleLang } from "@/lib/content"
import { Image } from "astro:assets"
// Downloaded at build time by scripts/prebuild.ts (random cat per build).
import catImage from "@/assets/cat.jpg"

const posts = (await getPosts()).slice(0, 3)
const thisYear = new Date().getUTCFullYear()
// A post from this year needs no year beside it; an older one does.
const postDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    ...(date.getUTCFullYear() === thisYear ? {} : { year: "numeric" }),
    timeZone: "UTC",
  }).format(date)

const toc = [
  {
    label: "Home",
    headings: [
      { depth: 2, slug: "profile", text: "Profile" },
      { depth: 2, slug: "writing", text: "Writing" },
      { depth: 2, slug: "now", text: "Now" },
    ],
  },
]
---

<Layout>
  <MetaPage slot="head" />
  <link rel="preconnect" href={API} crossorigin slot="head">
  <link rel="preload" as="fetch" href={NOW.endpoint} crossorigin slot="head">
  <TableOfContents slot="toc" title="Home" sections={toc} />
  <section aria-labelledby="profile">
    <dictionary-entry>
      <h1 id="profile">lkw123</h1>
      <etymology-span>
        <ipa-span>/Yet another salted fish/</ipa-span>
        (•‾⌣‾•)
      </etymology-span>
      <cat-figure>
        <Image
          src={catImage}
          alt="A random cat"
          widths={[480, 800, 1280]}
          sizes="(width >= 64rem) 35rem, 80vw"
          priority
        />
        <button
          id="cat-refresh"
          data-icon-button
          aria-label="Fetch a new cat"
          title="Fetch a new cat"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
            <polyline points="21 3 21 9 15 9"></polyline>
          </svg>
        </button>
      </cat-figure>
    </dictionary-entry>
  </section>
  <section aria-labelledby="writing">
    <div class="home-head">
      <h2 id="writing">Writing</h2>
      <a class="section-link" href="/blog">All posts</a>
    </div>
    <ol class="home-posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>
            {postDate(post.data.date)}
          </time>
          <a href={`/blog/${post.id}`} lang={titleLang(post)}>{post.data.title}</a>
        </li>
      ))}
    </ol>
  </section>
  <section aria-labelledby="now">
    <div class="home-head"><h2 id="now">Now</h2></div>
    <Now />
  </section>
</Layout>

<script>
  const figure = document.querySelector("cat-figure")
  const img = figure?.querySelector("img")
  const button = document.getElementById(
    "cat-refresh",
  ) as HTMLButtonElement | null

  if (figure && img && button) {
    button.addEventListener("click", () => {
      button.disabled = true
      figure.setAttribute("data-loading", "")
      figure.setAttribute("aria-busy", "true")

      const url = `https://cataas.com/cat?width=1280&t=${Date.now()}`
      const next = new Image()
      const done = () => {
        button.disabled = false
        figure.removeAttribute("data-loading")
        figure.removeAttribute("aria-busy")
      }
      next.onload = () => {
        // Drop the build-time srcset so the freshly fetched cat wins.
        img.removeAttribute("srcset")
        img.src = url
        done()
      }
      next.onerror = done
      next.src = url
    })
  }
</script>

<style>
  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    cat-figure {
      position: relative;
      display: block;
      margin-block-start: var(--space-s);
      inline-size: 80%;

      img {
        inline-size: 100%;
        block-size: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        transition: opacity 0.3s ease;
      }

      button {
        position: absolute;
        inset-block-end: var(--space-2xs);
        inset-inline-end: var(--space-2xs);
        color: var(--gray-1);
        background-color: color-mix(in oklab, var(--gray-12) 55%, transparent);
        backdrop-filter: blur(var(--blur-sm));

        &:hover {
          background-color: color-mix(
            in oklab,
            var(--gray-12) 75%,
            transparent
          );
        }
      }

      &[data-loading] {
        img {
          opacity: 0.6;
        }

        button svg {
          @media (prefers-reduced-motion: no-preference) {
            animation: cat-spin 1s linear infinite;
          }
        }
      }
    }
  }

  section + section {
    margin-block-start: var(--space-l);
  }

  /* A section's name as a quiet label, and on the far end of its row the
     one link it has (.section-link, feed.css). */
  .home-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-xs);

    h2 {
      margin: 0;
      font-size: var(--step--1);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }
  }

  /* Date and title, the dates in a column of their own so the titles
     start on one line however long each date is. */
  .home-posts {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: baseline;
      margin: 0;
      padding: 0;
    }

    time {
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);
    }

    a {
      color: var(--foreground);
      text-decoration: none;
      text-wrap: pretty;

      &:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }

  @keyframes cat-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
