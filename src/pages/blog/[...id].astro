---
import Byline from "@/components/Byline.astro"
import CopyMarkdown from "@/components/CopyMarkdown.astro"
import Lightbox from "@/components/Lightbox.astro"
import LinkPreview from "@/components/LinkPreview.astro"
import PostDates from "@/components/PostDates.astro"
import PostTags from "@/components/PostTags.astro"
import Mermaid from "@/components/Mermaid.astro"
import MetaPost from "@/components/MetaPost.astro"
import PostActions from "@/components/PostActions.astro"
import PostColophon from "@/components/PostColophon.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import SeriesReader from "@/components/SeriesReader.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE } from "@/consts"
import { getSeries, pageTitle, postLang } from "@/lib/content"
import { isSubpost, subpostSlug } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, render, type CollectionEntry } from "astro:content"
// MathML styles: only posts render maths.
import "@/styles/site-icons.css"
import "@/styles/typography-math.css"
// Expressive Code's shared styles, one cached file for every post.
import "virtual:expressive-code.css"

export async function getStaticPaths() {
  const series = await getSeries()
  return series.flatMap((chain, i) =>
    chain.map((post) => ({
      params: { id: post.id },
      props: {
        post,
        chain,
        prev: series[i + 1]?.[0],
        next: series[i - 1]?.[0],
      },
    })),
  )
}

type Props = {
  post: CollectionEntry<"blog">
  chain: CollectionEntry<"blog">[]
  prev?: CollectionEntry<"blog">
  next?: CollectionEntry<"blog">
}

const { post, chain, prev, next } = Astro.props
const [parent] = chain
const rendered = await Promise.all(
  chain.map(async (entry) => ({
    entry,
    ...(await render(entry)),
    authors: await getEntries(entry.data.authors),
  })),
)

const sections = rendered.map(({ entry, headings }, i) => ({
  id: i === 0 ? undefined : subpostSlug(entry.id),
  label: entry.data.title,
  open: entry.id === post.id,
  headings: headings.filter(
    ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
  ),
}))
const hasToc =
  sections.length > 1 || sections.some(({ headings }) => headings.length > 0)
const hasMermaid = chain.some((entry) => entry.data.mermaid)
// The page takes the parent's language; a subpost in another one says so
// on its own article. The byline row and tags are chrome, so English.
const lang = postLang(parent)
const chromeLang = lang === SITE.locale ? undefined : SITE.locale
---

<Layout lang={lang} strip={false}>
  <MetaPost
    slot="head"
    post={post}
    canonical={isSubpost(post.id) ? `/blog/${parent.id}` : undefined}
  />
  {hasToc && (
      <TableOfContents
        slot="toc"
        title={parent.data.title}
        sections={sections}
      />
    )}
  <PostActions slot="actions" prev={prev} next={next} />
  {!hasToc && <ScrollToTop floating />}
  {rendered.map(({ entry, Content, authors }, i) => (
      <article
        id={i === 0 ? undefined : subpostSlug(entry.id)}
        data-url={`/blog/${entry.id}`}
        data-title={pageTitle(entry.data.title)}
        data-embedded={i > 0 || undefined}
        lang={postLang(entry) === lang ? undefined : postLang(entry)}
      >
        <header>
          <h1>{entry.data.title}</h1>
          <post-meta lang={chromeLang}>
            <Byline authors={authors} ai={entry.data.ai} interactive />
            <PostDates
              date={entry.data.date}
              updated={entry.data.updatedDate}
            />
            <CopyMarkdown href={`/blog/${entry.id}.md`} />
          </post-meta>
          <PostTags tags={entry.data.tags} lang={chromeLang} />
        </header>
        {entry.data.image && (
          <post-banner>
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              width={1200}
              height={630}
              priority={entry.id === post.id || undefined}
            />
          </post-banner>
        )}
        <prose-content>
          <Content />
        </prose-content>
      </article>
    ))}
  <PostColophon chain={chain} lang={chromeLang} />
  {chain.length > 1 && <SeriesReader />}
  {hasMermaid && <Mermaid />}
  <Lightbox />
  <LinkPreview bodies={chain.map((entry) => entry.body ?? "")} />
</Layout>

<style>
  article[data-embedded] {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: var(--hairline) solid var(--border);
    scroll-margin-block-start: calc(-0.5px - 0.2 * var(--step-1));

    header h1 {
      font-size: var(--step-1);
    }
  }

  /* Tags close the header, set apart from the meta row and nearer the
     body they index. Astro leaves `:has()` arguments unscoped, so the
     child component's element is named bare (a :global() here would
     ship verbatim, and the browser would drop the rule). */
  header {
    margin-block-end: var(--space-m);

    &:has(post-tags) {
      margin-block-end: var(--space-xs);
    }

    h1 {
      font-size: var(--step-1);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-display);
      letter-spacing: var(--tracking-display);
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs) var(--space-xs);
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      /* Where the dates would push the Copy Markdown chip onto a line of
         its own, it ends the author's line and the dates take the next. */
      @media (width < 40rem) {
        :global(copy-markdown) {
          order: 1;
        }

        :global(post-dates) {
          order: 2;
          flex-basis: 100%;
        }
      }
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
      border-radius: var(--radius-lg);
    }
  }
</style>

<script>
  // Expressive Code's copy buttons and scroll-region focus, likewise.
  import "virtual:expressive-code.js"
</script>
