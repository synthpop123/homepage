---
import MetaPage from "@/components/MetaPage.astro"
import PageTitle from "@/components/PageTitle.astro"
import Layout from "@/layouts/Layout.astro"
import { getTags } from "@/lib/content"

// Laid out as the index at the back of a book: alphabetical, under
// letter heads, each entry dotted across to its count.
const tags = [...(await getTags())].sort(([a], [b]) => a.localeCompare(b))
const letters = Map.groupBy(tags, ([tag]) => tag[0].toUpperCase())
---

<Layout crumbs={[{ label: "Tags", href: "/tags" }]}>
  <MetaPage slot="head" title="Tags" noindex />
  <PageTitle>Tags</PageTitle>
  <tag-index>
    {[...letters].map(([letter, entries]) => (
      <section aria-labelledby={`l-${letter}`}>
        <h2 id={`l-${letter}`}>{letter}</h2>
        <ul>
          {entries.map(([tag, posts]) => (
            <li>
              <a href={`/tags/${tag}`}>
                <span>{tag}</span>
                <tag-count>
                  {posts.length}
                  <span class="sr">{posts.length === 1 ? " post" : " posts"}</span>
                </tag-count>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </tag-index>
</Layout>

<style>
  tag-index {
    display: block;
    columns: 3 11rem;
    column-gap: var(--space-l);
  }

  section {
    break-inside: avoid;
    margin-block-end: var(--space-s);
  }

  h2 {
    margin-block-end: var(--space-3xs);
    font-family: var(--font-mono);
    font-feature-settings: normal;
    font-size: var(--step--1);
    font-weight: var(--font-weight-strong);
    letter-spacing: 0;
    color: var(--muted-foreground);
  }

  /* Name, a dotted leader, and the count. */
  a {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    padding-block: 0.1em;
    color: var(--foreground);
    text-decoration-line: none;

    &::after {
      content: "";
      flex: 1;
      order: 1;
      min-inline-size: 1rem;
      border-block-end: var(--hairline) dotted var(--border-strong);
    }

    &:hover > span {
      text-decoration-line: underline;
      text-decoration-color: currentColor;
    }
  }

  tag-count {
    order: 2;
    font-family: var(--font-mono);
    font-feature-settings: normal;
    font-size: var(--step--2);
    letter-spacing: 0;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }
</style>
