---
import AuthorCard from "@/components/AuthorCard.astro"
import Flights from "@/components/Flights.astro"
import MetaPage from "@/components/MetaPage.astro"
import PageTitle from "@/components/PageTitle.astro"
import Movies from "@/components/Movies.astro"
import Music from "@/components/Music.astro"
import SectionHead from "@/components/SectionHead.astro"
import Stocks from "@/components/Stocks.astro"
import Switch from "@/components/Switch.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Uses from "@/components/Uses.astro"
import { API, KOITO, LETTERBOXD, MISC } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const friends = (await getCollection("friends")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
)

// The five live sections share one request (lib/client/misc.ts), which
// would otherwise leave only once the first module script ran. The preload
// below starts it with the CSS and JS, and the scripts pick up the
// in-flight response (default fetch mode/credentials, which is what a bare
// `crossorigin` matches).
//
// Each section names where its data comes from as one small link at the
// far end of its heading, rather than a sentence under it.
const sections: {
  id: string
  label: string
  source?: { href: string; label: string }
}[] = [
  { id: "friends", label: "Friends" },
  {
    id: "flights",
    label: "Flights",
    source: {
      href: "https://github.com/johanohly/AirTrail",
      label: "AirTrail",
    },
  },
  {
    id: "movies",
    label: "Movies",
    source: {
      href: `https://letterboxd.com/${LETTERBOXD.username}/`,
      label: "Letterboxd",
    },
  },
  {
    id: "music",
    label: "Music",
    source: { href: KOITO.instance, label: "Koito" },
  },
  {
    id: "switch",
    label: "Switch",
    source: { href: API, label: "Parental Controls" },
  },
  {
    id: "stocks",
    label: "Stocks",
    source: {
      href: "https://github.com/ghostfolio/ghostfolio",
      label: "Ghostfolio",
    },
  },
  {
    id: "uses",
    label: "Uses",
    source: { href: "https://uses.tech/", label: "uses.tech" },
  },
]
const head = Object.fromEntries(
  sections.map((section) => [section.id, section]),
)
const toc = [
  {
    label: "Misc",
    headings: sections.map(({ id, label }) => ({
      depth: 2,
      slug: id,
      text: label,
    })),
  },
]
---

<Layout>
  <MetaPage slot="head" title="Misc" />
  <link rel="preconnect" href={API} crossorigin slot="head">
  <link rel="preload" as="fetch" href={MISC.endpoint} crossorigin slot="head">
  <TableOfContents slot="toc" title="Misc" sections={toc} />
  <PageTitle>Misc</PageTitle>
  <section>
    <SectionHead {...head.friends} />
    <ul>
      {friends.map((friend) => (
        <AuthorCard author={friend} standalone />
      ))}
    </ul>
  </section>
  <section>
    <SectionHead {...head.flights} />
    <Flights />
  </section>
  <section>
    <SectionHead {...head.movies} />
    <Movies limit={8} />
  </section>
  <section>
    <SectionHead {...head.music} />
    <Music limit={11} />
  </section>
  <section>
    <SectionHead {...head.switch} />
    <Switch limit={10} />
  </section>
  <section>
    <SectionHead {...head.stocks} />
    <Stocks />
  </section>
  <section>
    <SectionHead {...head.uses} />
    <Uses />
  </section>
</Layout>

<style>
  section + section {
    margin-block-start: var(--space-l);
  }

  a {
    color: var(--foreground);
    text-decoration: underline;
  }

  section > p {
    margin-block-end: var(--space-s);
    color: var(--muted-foreground);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
