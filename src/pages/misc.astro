---
import AuthorCard from "@/components/AuthorCard.astro"
import Flights from "@/components/Flights.astro"
import MetaPage from "@/components/MetaPage.astro"
import Movies from "@/components/Movies.astro"
import Music from "@/components/Music.astro"
import Switch from "@/components/Switch.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Uses from "@/components/Uses.astro"
import { API, MISC } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const friends = (await getCollection("friends")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
)

// The four live sections share one request (lib/client/misc.ts), which
// would otherwise leave only once the first module script ran. The preload
// below starts it with the CSS and JS, and the scripts pick up the
// in-flight response (default fetch mode/credentials, which is what a bare
// `crossorigin` matches).
const sections = [
  { id: "friends", label: "Friends" },
  { id: "flights", label: "Flights" },
  { id: "movies", label: "Movies" },
  { id: "music", label: "Music" },
  { id: "switch", label: "Switch" },
  { id: "uses", label: "Uses" },
]
const toc = [
  {
    label: "Misc",
    headings: sections.map(({ id, label }) => ({
      depth: 2,
      slug: id,
      text: label,
    })),
  },
]
---

<Layout>
  <MetaPage slot="head" title="Misc" />
  <link rel="preconnect" href={API} crossorigin slot="head">
  <link rel="preload" as="fetch" href={MISC.endpoint} crossorigin slot="head">
  <TableOfContents slot="toc" title="Misc" sections={toc} />
  <header>
    <h1>Misc</h1>
  </header>
  <section>
    <h2 id="friends">Friends</h2>
    <ul>
      {friends.map((friend) => (
        <AuthorCard author={friend} standalone />
      ))}
    </ul>
  </section>
  <section>
    <h2 id="flights">Flights</h2>
    <Flights />
  </section>
  <section>
    <h2 id="movies">Movies</h2>
    <Movies limit={8} />
  </section>
  <section>
    <h2 id="music">Music</h2>
    <Music limit={11} />
  </section>
  <section>
    <h2 id="switch">Switch</h2>
    <Switch limit={10} />
  </section>
  <section>
    <h2 id="uses">Uses</h2>
    <Uses />
  </section>
</Layout>

<style>
  header {
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }
  }

  section + section {
    margin-block-start: var(--space-l);
  }

  h2 {
    margin-block-end: var(--space-s);
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);

    @media (width >= 64rem) {
      scroll-margin-block-start: calc(var(--page-offset-top) - 0.2em);
    }
  }

  a {
    color: var(--foreground);
    text-decoration: underline;
  }

  section > p {
    margin-block-end: var(--space-s);
    color: var(--muted-foreground);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
