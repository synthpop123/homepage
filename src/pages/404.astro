---
import MetaPage from "@/components/MetaPage.astro"
import PageTitle from "@/components/PageTitle.astro"
import PostList from "@/components/PostList.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"

const posts = (await getPosts()).slice(0, 5)
---

<Layout crumbs={[{ label: "404", href: "/404" }]}>
  <MetaPage slot="head" title="404" noindex />
  <PageTitle>Page not found</PageTitle>
  <p>
    This page has moved or never existed. Try one of the latest posts, or browse
    <a href="/blog">the blog</a>.
  </p>
  <PostList posts={posts} />
</Layout>

<style>
  p {
    max-inline-size: var(--measure, 40rem);
    margin-block: 0 var(--space-m);
    color: var(--muted-foreground);

    a {
      --underline: var(--muted-foreground);
      color: var(--foreground);
    }
  }
</style>
