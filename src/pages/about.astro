---
import AuthorCard from "@/components/AuthorCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import { API } from "@/consts"
import Layout from "@/layouts/Layout.astro"
import { countEntryWords, getSeries, getTags } from "@/lib/content"
import { formatCompact } from "@/lib/utils"
import { calendarDay, dayInstant } from "@/lib/client/feed"
import { getEntry } from "astro:content"

const ext = { target: "_blank", rel: "noopener noreferrer" }

const author = await getEntry("authors", "lkw123")
if (!author) throw new Error("Missing author: lkw123")

// Build-time blog stats: every deploy re-counts the content collection.
const series = await getSeries()
const entries = series.flat()
const posts = series.map(([post]) => post)
const tags = await getTags()

const words = countEntryWords(entries)
const sinceYear = new Date(
  Math.min(...posts.map((post) => post.data.date.getTime())),
).getUTCFullYear()

// The build day, Asia/Shanghai, inked as a date stamp: "04 Oct 2026",
// set in capitals by CSS.
const builtDay = calendarDay()
const builtStamp = `${builtDay.slice(8)} ${dayInstant(builtDay).toLocaleString(
  "en-US",
  { month: "short", timeZone: "UTC" },
)} ${builtDay.slice(0, 4)}`

const stats = [
  { label: "Posts", value: String(posts.length) },
  { label: "Words", value: formatCompact(words) },
  { label: "Tags", value: String(tags.size) },
  { label: "Since", value: String(sinceYear) },
]

const sections = [
  { id: "who-am-i", label: "Who am I" },
  { id: "blog", label: "Blog in numbers" },
  { id: "site", label: "About this site" },
]
const toc = [
  {
    label: "About",
    headings: sections.map(({ id, label }) => ({
      depth: 2,
      slug: id,
      text: label,
    })),
  },
]
---

<Layout>
  <MetaPage
    slot="head"
    title="About"
    description="Who I am, what I've been building, and how this site is put together."
  />
  <TableOfContents slot="toc" title="About" sections={toc} />
  <header>
    <h1>About</h1>
    <ul>
      <AuthorCard author={author} standalone />
    </ul>
  </header>
  <section>
    <h2 id="who-am-i">Who am I</h2>
    <prose-content>
      <ul>
        <li>INTP-T (I Need To sleeP)</li>
        <li>Male | Movie | Music | Minimalist</li>
        <li>Keep Learning &amp; Be Creative</li>
      </ul>
    </prose-content>
  </section>
  <section>
    <h2 id="blog">Blog in numbers</h2>
    <dl class="blog-stats">
      {stats.map(({ label, value }) => (
        <div class="stat">
          <dt class="label">{label}</dt>
          <dd class="value">{value}</dd>
        </div>
      ))}
    </dl>
  </section>
  <section>
    <h2 id="site">About this site</h2>
    <dl class="colophon">
      <div>
        <dt>Built with</dt>
        <dd>
          <a href="https://astro.build" {...ext}>Astro</a>
          and hand-written CSS, coloured with
          <a href="https://www.radix-ui.com/colors" {...ext}>Radix Colors</a>
          and spaced on <a href="https://utopia.fyi" {...ext}>Utopia</a>
          fluid scales.
        </dd>
      </div>
      <div>
        <dt>Set in</dt>
        <dd class="specimens">
          <type-specimen>
            <span>Aa Gg 369 “a”</span>
            <small
              ><a href="https://rsms.me/inter/" {...ext}>Inter</a>, open digits,
              single-storey a</small
            >
          </type-specimen>
          <type-specimen data-mono>
            <span>{"{ => }"} 0O 1lI</span>
            <small
              ><a href="https://vercel.com/font" {...ext}>Geist Mono</a>, for
              code and figures</small
            >
          </type-specimen>
        </dd>
      </div>
      <div>
        <dt>Written in</dt>
        <dd>
          Markdown, compiled by
          <a href="https://github.com/bruits/satteri" {...ext}>Sätteri</a>;
          maths by <a href="https://temml.org" {...ext}>Temml</a>, code by
          <a href="https://expressive-code.com" {...ext}>Expressive Code</a>.
        </dd>
      </div>
      <div>
        <dt>Served from</dt>
        <dd>
          <a href="https://workers.cloudflare.com" {...ext}
            >Cloudflare Workers</a
          >, as static files. The live sections read
          <code>{new URL(API).host}</code>.
        </dd>
      </div>
      <div>
        <dt>Counted by</dt>
        <dd>
          <a href="https://umami.is" {...ext}>Umami</a>, self-hosted, no
          cookies.
        </dd>
      </div>
      <div>
        <dt>Started from</dt>
        <dd>
          <a href="https://github.com/jktrn/astro-erudite" {...ext}
            >astro-erudite v2</a
          >. Thanks! &hearts;
        </dd>
      </div>
    </dl>
    <p class="built">
      <span
        ><small>Built</small>
        <time datetime={builtDay}>{builtStamp}</time></span
      >
    </p>
  </section>
</Layout>

<style>
  header {
    margin-block-end: var(--space-l);

    /* The author card is the visible heading; this one names the page for
       assistive technology, as every other page's h1 does. */
    h1 {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  section + section {
    margin-block-start: var(--space-l);
  }

  h2 {
    margin-block-end: var(--space-s);
    font-size: var(--step-0);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-strong);

    @media (width >= 64rem) {
      scroll-margin-block-start: calc(var(--page-offset-top) - 0.2em);
    }
  }

  .blog-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xs) var(--space-s);
    margin: 0;

    @media (width < 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* The readout's figure on a hairline (feed.css), drawn here without
     the runtime: dt first for validity, the value on top. */
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3xs);
    padding-block-start: var(--space-2xs);
    border-block-start: var(--hairline) solid var(--border);
  }

  .stat .value {
    margin: 0;
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .stat .label {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  /* About this site as a book's colophon: a small label, then the line
     it introduces, row under ruled row. The type row sets its own
     specimens. */
  .colophon {
    --underline: var(--muted-foreground);

    display: grid;
    margin: 0;

    > div {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--space-s);
      align-items: baseline;
      padding-block: var(--space-2xs);
      border-block-start: var(--hairline) solid var(--border);

      &:last-child {
        border-block-end: var(--hairline) solid var(--border);
      }

      @media (width < 40rem) {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-3xs);
      }
    }

    dt {
      font-family: var(--font-mono);
      font-feature-settings: normal;
      font-size: var(--step--2);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    dd {
      margin: 0;
      color: var(--prose-foreground);
      line-height: calc(var(--leading-offset) + 1em);

      a {
        color: var(--foreground);
      }

      code {
        font-family: var(--font-mono);
        font-feature-settings: normal;
        font-size: 0.875em;
        letter-spacing: 0;
      }
    }
  }

  /* The two faces as a pair, side by side at one size, split by the
     colophon's own hairline; stacked on a phone. */
  .colophon .specimens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    @media (width < 30rem) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  type-specimen {
    display: grid;
    align-content: start;
    padding-inline-end: var(--space-s);

    & + & {
      padding-inline: var(--space-s) 0;
      border-inline-start: var(--hairline) solid var(--border);

      @media (width < 30rem) {
        margin-block-start: var(--space-2xs);
        padding: var(--space-2xs) 0 0;
        border-inline-start: 0;
        border-block-start: var(--hairline) solid var(--border);
      }
    }

    > span {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      line-height: 1.35;
      letter-spacing: -0.012em;
      color: var(--foreground);
    }

    &[data-mono] > span {
      font-family: var(--font-mono);
      font-feature-settings: "ss01", "ss02", "ss03", "ss04";
      font-weight: var(--font-weight-normal);
      letter-spacing: 0;
    }

    small {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  /* The build day, set apart in the accent: a hairline box, small
     caps over the date. */
  .built {
    display: flex;
    justify-content: flex-end;
    margin-block-start: var(--space-s);

    > span {
      display: inline-grid;
      justify-items: center;
      gap: 0.1rem;
      padding: var(--space-3xs) var(--space-xs);
      border: var(--hairline) solid var(--accent);
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-feature-settings: normal;
      letter-spacing: 0;
      line-height: 1.1;
      text-transform: uppercase;
      color: var(--accent);
    }

    small {
      font-size: var(--step--2);
      letter-spacing: var(--tracking-label);
    }

    time {
      font-size: var(--step-0);
      font-weight: var(--font-weight-strong);
      letter-spacing: var(--tracking-label);
    }
  }
</style>
