---
import Lightbox from "@/components/Lightbox.astro"
import Memos from "@/components/Memos.astro"
import MetaPage from "@/components/MetaPage.astro"
import PageTitle from "@/components/PageTitle.astro"
import { API, MEMOS } from "@/consts"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage
    slot="head"
    title="Memos"
    description="Short notes, pulled live from my Mastodon."
  />
  <link rel="preconnect" href={API} crossorigin slot="head">
  <link rel="preload" as="fetch" href={MEMOS.endpoint} crossorigin slot="head">
  <PageTitle>Memos</PageTitle>
  <Memos />
  <Lightbox />
</Layout>
