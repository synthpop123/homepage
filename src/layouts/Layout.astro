---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/site-icons.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/callout.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"
import "@/styles/print.css"

import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import { SITE } from "@/consts"

type Props = {
  crumbs?: { label: string; href: string }[]
  /** The page's language, when it is not the site's (a Chinese post). */
  lang?: string
  /** The footer's strip of every post; off where the page draws its own
   *  (a post's end, the home page's Writing). */
  strip?: boolean
}

const { crumbs, lang = SITE.locale, strip = true } = Astro.props
// The chrome is English on every page, so a page in another language says
// so around it.
const chromeLang = lang === SITE.locale ? undefined : SITE.locale
---

<html lang={lang} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <a href="#main" data-skip-link lang={chromeLang}>Skip to content</a>
    <page-grid>
      <page-header>
        <page-nav lang={chromeLang}>
          <Sidebar crumbs={crumbs}
            ><slot name="actions" slot="actions" /></Sidebar
          >
        </page-nav>
        {Astro.slots.has("toc") && (
            <page-toc><slot name="toc" /></page-toc>
          )}
      </page-header>
      <page-content>
        <main id="main" tabindex="-1"><slot /></main>
        <page-footer lang={chromeLang}><Footer strip={strip} /></page-footer>
      </page-content>
    </page-grid>
  </body>
</html>

<style>
  [data-skip-link] {
    position: fixed;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    z-index: 20;
    padding-block: var(--space-2xs);
    padding-inline: var(--space-xs);
    color: var(--foreground);
    text-decoration-line: none;
    background-color: var(--background);
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--radius-md);

    &:not(:focus) {
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  main:focus {
    outline: none;
  }

  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns:
      [nav] minmax(var(--rail-min), 1fr)
      [content] minmax(0, var(--content-width))
      [toc] minmax(var(--rail-min), 1fr);
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-block-start: 0;
    }
  }

  page-header {
    display: contents;

    @media (width < 64rem) {
      display: block;
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      min-width: 0;
      margin-inline: calc(-1 * var(--grid-gutter));
    }
  }

  /* The rails stretch down the page, so the sidebar and the TOC inside
     them stick to the top of the window as it scrolls. */
  page-nav {
    display: block;
    min-width: 0;
    grid-column: nav;
    grid-row: 1 / -1;
  }

  page-toc {
    display: block;
    min-width: 0;
    grid-column: toc;
    grid-row: 1;

    /* Between 64rem and 76rem a rail is too narrow for the TOC, so it
       folds into the bar it is on a phone and sits at the head of the
       column, sticking to the top of the window. Its rail stays empty,
       so the column doesn't move. */
    @media screen and (64rem <= width < 76rem) {
      position: sticky;
      inset-block-start: 0;
      z-index: 10;
      grid-column: content;
      align-self: start;
      margin-block-start: calc(-1 * var(--page-offset-top));
      margin-block-end: calc(var(--page-offset-top) - var(--space-s));
    }
  }

  page-grid:has(page-toc) {
    @media screen and (64rem <= width < 76rem) {
      grid-template-rows: auto 1fr;

      page-content {
        grid-row: 2;
      }
    }
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: content;
    grid-row: 1;
    min-width: 0;
    margin-block-start: -0.1em;

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: auto;
      inline-size: 100%;
      max-inline-size: var(--content-width);
      margin-inline: auto;
    }
  }
</style>
