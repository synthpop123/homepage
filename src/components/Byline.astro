---
/**
 * Who wrote a post: the avatar stack and the names beside it, shared by
 * the list card and the post header. An AI-assisted post (`ai: true`)
 * says so here, in a credit beside the names rather than in a badge
 * further along the row — the disclosure is about authorship, so it
 * sits with the authors, and it is spelled out rather than hidden
 * behind a hover, so it reads the same on a phone.
 */

import ClaudeIcon from "@/assets/icons/ai/claude.svg"
import type { CollectionEntry } from "astro:content"

type Props = {
  authors: CollectionEntry<"authors">[]
  ai?: boolean
  /** Link names to /about (post header). */
  interactive?: boolean
}

const { authors, ai = false, interactive = false } = Astro.props
---

{(authors.length > 0 || ai) && (
    <post-byline>
      {authors.length > 0 && (
        <author-avatars>
          {authors.map((author) => (
            <img
              src={author.data.avatar}
              alt={author.data.name}
              width="18"
              height="18"
            />
          ))}
        </author-avatars>
      )}
      <author-names>
        {authors.map((author, i) => (
          <>
            {i > 0 && ", "}
            {interactive ? (
              <a href="/about">{author.data.name}</a>
            ) : (
              author.data.name
            )}
          </>
        ))}
      </author-names>
      {ai && (
        <ai-credit title="Drafted with an AI assistant">
          <ClaudeIcon aria-hidden="true" />
          AI-assisted
        </ai-credit>
      )}
    </post-byline>
  )}

<style>
  post-byline {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  author-avatars {
    display: flex;
    margin-block-end: -0.1em;

    > * {
      border-radius: var(--radius-full);
      box-shadow: 0 0 0 1.5px var(--background);

      &:not(:first-child) {
        margin-inline-start: -0.375rem;
      }
    }
  }

  author-names a {
    color: var(--foreground);
  }

  /* A second hand in the byline, in the assistant's own colour: its
     mark, and a hairline capsule tinted with it, the height of an
     avatar so the row keeps one centre line. */
  ai-credit {
    --claude: #d97757;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    block-size: 18px;
    margin-inline-start: 0.15em;
    padding-inline: 0.45em 0.55em;
    border: 1px solid color-mix(in oklab, var(--claude) 30%, var(--border));
    border-radius: var(--radius-full);
    background-color: color-mix(in oklab, var(--claude) 7%, var(--background));
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1;
    white-space: nowrap;
    cursor: default;

    svg {
      inline-size: 0.8rem;
      block-size: 0.8rem;
      color: var(--claude);
    }
  }
</style>
