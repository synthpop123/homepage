---
/**
 * Who wrote a post: the avatar stack and the names beside it, shared by
 * the list card and the post header. An AI-assisted post (`ai: true`)
 * says so here, in a credit beside the names rather than in a badge
 * further along the row — the disclosure is about authorship, so it
 * sits with the authors, and it is spelled out rather than hidden
 * behind a hover, so it reads the same on a phone.
 */

import ClaudeIcon from "@/assets/icons/ai/claude.svg"
import type { CollectionEntry } from "astro:content"

type Props = {
  authors: CollectionEntry<"authors">[]
  ai?: boolean
  /** Link names to /about (post header). */
  interactive?: boolean
}

const { authors, ai = false, interactive = false } = Astro.props
---

{(authors.length > 0 || ai) && (
    <post-byline>
      {authors.length > 0 && (
        <author-avatars>
          {authors.map((author) => (
            <img
              src={author.data.avatar}
              alt={author.data.name}
              width="18"
              height="18"
            />
          ))}
        </author-avatars>
      )}
      <author-names>
        {authors.map((author, i) => (
          <>
            {i > 0 && ", "}
            {interactive ? (
              <a href="/about">{author.data.name}</a>
            ) : (
              author.data.name
            )}
          </>
        ))}
      </author-names>
      {ai && (
        <ai-credit title="Drafted with an AI assistant">
          <ClaudeIcon aria-hidden="true" />
          AI-assisted
        </ai-credit>
      )}
    </post-byline>
  )}

<style>
  post-byline {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  author-avatars {
    display: flex;
    margin-block-end: -0.1em;

    > * {
      border-radius: var(--radius-full);
      outline: 1.5px solid var(--background);

      &:not(:first-child) {
        margin-inline-start: -0.375rem;
      }
    }
  }

  author-names a {
    color: var(--foreground);
  }

  /* A second hand in the byline: the assistant's mark in its own colour
     and the credit in the row's own text. */
  ai-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-inline-start: var(--space-3xs);
    color: var(--muted-foreground);
    white-space: nowrap;
    cursor: default;

    svg {
      inline-size: 0.875em;
      block-size: 0.875em;
      color: var(--brand-claude);
    }
  }
</style>
