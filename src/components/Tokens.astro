---
import "@/styles/feed.css"
import type { SvgComponent } from "astro/types"
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import CpuIcon from "@/assets/icons/devices/cpu.svg"
import ServerIcon from "@/assets/icons/devices/server.svg"
import HourglassIcon from "@/assets/icons/hourglass.svg"
import LaptopIcon from "@/assets/icons/uses/laptop.svg"
import MonitorIcon from "@/assets/icons/uses/monitor.svg"
import Heatmap from "@/components/Heatmap.astro"
import Alibaba from "@/assets/icons/ai/alibaba.svg"
import Anthropic from "@/assets/icons/ai/anthropic.svg"
import Claude from "@/assets/icons/ai/claude.svg"
import ClaudeCode from "@/assets/icons/ai/claudecode.svg"
import Codex from "@/assets/icons/ai/codex.svg"
import CraftAgents from "@/assets/icons/ai/craftagents.svg"
import Cursor from "@/assets/icons/ai/cursor.svg"
import DeepSeek from "@/assets/icons/ai/deepseek.svg"
import Gemini from "@/assets/icons/ai/gemini.svg"
import Google from "@/assets/icons/ai/google.svg"
import Grok from "@/assets/icons/ai/grok.svg"
import HermesAgent from "@/assets/icons/ai/hermesagent.svg"
import Kimi from "@/assets/icons/ai/kimi.svg"
import Meta from "@/assets/icons/ai/meta.svg"
import Moonshot from "@/assets/icons/ai/moonshot.svg"
import OpenAI from "@/assets/icons/ai/openai.svg"
import OpenCode from "@/assets/icons/ai/opencode.svg"
import OpenRouter from "@/assets/icons/ai/openrouter.svg"
import Pi from "@/assets/icons/ai/pi.svg"
import Qwen from "@/assets/icons/ai/qwen.svg"
import XAI from "@/assets/icons/ai/xai.svg"
import Zai from "@/assets/icons/ai/zai.svg"
import Zed from "@/assets/icons/ai/zed.svg"
import { type DeviceKind, TOKENS } from "@/consts"
import { COMPOSITION, RANGES, TOP_ROWS } from "@/lib/client/tokens"
import { SKELETON_ROWS } from "@/lib/utils"
// One stylesheet per renderer in tokens-dashboard/, in the order the
// rules were written. The layers (feeds.sections, feeds.states) settle
// which rule wins, not this order.
import "@/styles/tokens/activity.css"
import "@/styles/tokens/day.css"
import "@/styles/tokens/overview.css"
import "@/styles/tokens/quota.css"
import "@/styles/tokens/trend.css"
import "@/styles/tokens/breakdown.css"
import "@/styles/tokens/devices.css"
import "@/styles/tokens/shared.css"

type Props = {
  endpoint?: string
}

const { endpoint = TOKENS.endpoint } = Astro.props

/** Mono brand SVGs, vendored from Lobe Icons (https://lobehub.com/icons)
 *  except zed.svg and craftagents.svg (the apps' own marks, normalized
 *  to currentColor). The hidden defs block below is what the runtime
 *  script clones from. */
const AI_ICONS: Record<string, SvgComponent> = {
  alibaba: Alibaba,
  anthropic: Anthropic,
  claude: Claude,
  claudecode: ClaudeCode,
  codex: Codex,
  craftagents: CraftAgents,
  cursor: Cursor,
  deepseek: DeepSeek,
  gemini: Gemini,
  google: Google,
  grok: Grok,
  hermesagent: HermesAgent,
  kimi: Kimi,
  meta: Meta,
  moonshot: Moonshot,
  openai: OpenAI,
  opencode: OpenCode,
  openrouter: OpenRouter,
  pi: Pi,
  qwen: Qwen,
  xai: XAI,
  zai: Zai,
  zed: Zed,
}

const dayCards = [
  { key: "tokens", label: "Tokens" },
  { key: "cost", label: "Cost" },
  { key: "messages", label: "Messages" },
  { key: "activeTime", label: "Active time" },
]

const overviewCards = [
  { key: "tokens", label: "Tokens" },
  { key: "cost", label: "Cost" },
  { key: "messages", label: "Messages" },
  { key: "activeDays", label: "Active days" },
]

/** Dimensions the trend chart stacks by. */
const stackOptions = [
  { key: "provider", label: "By provider" },
  { key: "client", label: "By client" },
  { key: "model", label: "By model" },
]

const factCards = [
  { key: "biggest", label: "Biggest day" },
  { key: "busiest", label: "Busiest week" },
  { key: "median", label: "Median day" },
  { key: "weekday", label: "Top weekday" },
  { key: "longest", label: "Longest streak" },
  { key: "current", label: "Current streak" },
  { key: "models", label: "Models used" },
  { key: "activeTime", label: "Active time" },
]

const skeletonRows = (count: number) =>
  Array.from({ length: count }, (_, i) => i)

/**
 * Skeleton geometry is a bet on the payload, and the bet is placed
 * where the first paint would otherwise jump: every subscription so
 * far reports a session and a weekly window, each with a reset line
 * under it, and the models list opens at TOP_ROWS. The quota card is
 * the one above the fold, so guessing it a window short pushed the
 * whole page down by a card's height once the data arrived. The split
 * lists get fewer rows than TOP_ROWS: side by side they cost one
 * column of height, stacked on a phone they cost two. The first plan
 * also reserves a manual-resets block — the Codex card has carried one
 * for as long as the section has existed, and the grid's height is the
 * taller card's, so leaving it out is what left the row short. It
 * holds three tiles, the count the account banks: two left the card a
 * row short wherever the third wraps. The second plan (Claude) reserves
 * what its card carries instead: the weekly window's split line and the
 * cloud session credits row. The third (OpenCode Go) takes a whole row
 * with its session, weekly and monthly windows side by side.
 */
const DEVICE_ICONS: Record<DeviceKind, SvgComponent> = {
  laptop: LaptopIcon,
  desktop: MonitorIcon,
  server: ServerIcon,
}

/** Rows per plan, in payload order: Codex, Claude (its credits row
 *  counted as one), OpenCode. The plan count is this list's length. */
const QUOTA_WINDOWS = [2, 3, 3]
const QUOTA_CREDITS = 3
const SPLIT_ROWS = 6
const LEGEND_CHIPS = 4
---

<tokens-dashboard data-endpoint={endpoint} aria-busy="true">
  <div class="tk-icon-defs" hidden aria-hidden="true">
    {Object.entries(AI_ICONS).map(([name, Icon]) => (
      <span data-icon={name}><Icon /></span>
    ))}
    <span data-icon="chevron"><ChevronIcon /></span>
    <span data-icon="hourglass"><HourglassIcon /></span>
    <span data-icon="device"><CpuIcon /></span>
    {Object.entries(TOKENS.devices).map(([name, kind]) => {
      const Icon = DEVICE_ICONS[kind]
      return <span data-icon={`device:${name}`}><Icon /></span>
    })}
  </div>
  <div class="tk-body">
    <section class="tk-quota-section">
      <h2 id="quota">Quota</h2>
      <ol class="tk-plans">
        {QUOTA_WINDOWS.map((windows, plan) => (
          <li class="tk-plan" data-skeleton aria-hidden="true">
            <div class="plan-head">
              <span class="ico sk-ico" />
              <span class="sk-line" style="inline-size: 4em" />
              <span class="plan-age"><span class="sk-line sk-sub" style="inline-size: 3em" /></span>
            </div>
            <ol class="tk-windows">
              {skeletonRows(windows).map((row) => (
                <li class="tk-window">
                  <div class="win-head">
                    <span class="win-label"><span class="sk-line" style="inline-size: 4em" /></span>
                    <span class="win-used"><span class="sk-line sk-num" /></span>
                  </div>
                  <div class="tk-meter" data-skeleton></div>
                  <p class="win-foot"><span class="sk-line sk-sub" style="inline-size: 7em" /></p>
                  {plan === 1 && row === 1 && (
                    <ul class="win-split">
                      <li><span class="sk-line sk-sub" style="inline-size: 6em" /></li>
                    </ul>
                  )}
                </li>
              ))}
            </ol>
            {plan === 0 && (
              <div class="plan-credits">
                <div class="win-head">
                  <span class="win-label"><span class="sk-line" style="inline-size: 6em" /></span>
                  <span class="win-used"><span class="sk-line sk-num" /></span>
                </div>
                <ol class="credits-list">
                  {skeletonRows(QUOTA_CREDITS).map(() => (
                    <li class="credit"><span class="sk-line sk-sub" style="inline-size: 5em" /></li>
                  ))}
                </ol>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>
    <section>
      <div class="tk-head">
        <h2 id="activity">Activity</h2>
        <p class="tk-sync">
          <span class="sk-line sk-sub" aria-hidden="true" />
        </p>
      </div>
      <Heatmap selectable />
      <div class="tk-day">
        <div class="tk-day-head">
          <h3 class="feed-label tk-day-label">Today</h3>
          <button type="button" class="tk-day-back section-link" data-latest>
            Back to today
          </button>
        </div>
        <div class="tk-day-body">
          <dl class="tk-cards readout" data-cards="day">
            {dayCards.map(({ key, label }) => (
              <div class="tk-card" data-key={key}>
                <dt>{label}</dt>
                <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
              </div>
            ))}
          </dl>
          <div class="tk-day-breakdown">
            <div class="tk-donut" data-skeleton aria-hidden="true">
              <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="42" /></svg>
              <p class="tk-donut-focus">
                <span class="value" />
                <span class="caption" />
              </p>
            </div>
            <ul class="tk-rows tk-day-legend">
              {skeletonRows(3).map(() => (
                <li class="tk-row" data-skeleton aria-hidden="true">
                  <span class="ico sk-ico" />
                  <span class="sk-line" style="inline-size: min(11em, 70%)" />
                  <span class="sk-line sk-num" />
                  <span class="sk-line sk-num" />
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p class="tk-day-empty" hidden>Zero byte kind of day.</p>
      </div>
    </section>
    <section>
      <h2 id="overview">Overview</h2>
      <form id="tk-controls" class="tk-controls">
        <fieldset class="tk-seg" aria-label="Time range">
          {RANGES.map((range) => (
            <label>
              <input
                type="radio"
                name="range"
                value={range.key}
                checked={range.default}
              />
              <span>{range.label}</span>
            </label>
          ))}
        </fieldset>
        <fieldset class="tk-seg" aria-label="Metric">
          <label>
            <input type="radio" name="metric" value="tokens" checked>
            <span>Tokens</span>
          </label>
          <label>
            <input type="radio" name="metric" value="cost">
            <span>Cost</span>
          </label>
        </fieldset>
      </form>
      <dl class="tk-cards readout" data-cards="overview">
        {overviewCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="delta"><span class="sk-line sk-sub" style="inline-size: 5em" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
      <h3 class="feed-label">Token composition</h3>
      <div class="tk-mix">
        <div class="tk-mix-bar tk-mix-composition" data-skeleton></div>
        <ul class="tk-mix-legend">
          {COMPOSITION.map(({ key, label }, i) => (
            <li data-key={key}>
              <span class="name">
                <span class="chip" data-k={i} aria-hidden="true" />
                {label}
              </span>
              <span class="value"><span class="sk-line sk-stat" aria-hidden="true" /></span>
              <span class="share"><span class="sk-line sk-sub" style="inline-size: 3em" aria-hidden="true" /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section>
      <h2 id="trend">Trend</h2>
      <div class="tk-chart-head">
        <p class="tk-chart-scope">Daily tokens</p>
        <p class="tk-chart-peak"></p>
      </div>
      <div class="tk-chart">
        <div
          class="tk-chart-bars"
          data-skeleton
          tabindex="0"
          role="group"
          aria-label="Token usage over time"
        ></div>
        <div class="tk-chart-axis" aria-hidden="true"></div>
        <div class="tk-tip" hidden aria-hidden="true"></div>
        <p class="tk-chart-status sr" role="status"></p>
      </div>
      <div class="tk-chart-foot">
        <fieldset class="tk-seg tk-seg-sm" aria-label="Stack trend bars by">
          {stackOptions.map(({ key, label }) => (
            <label data-stack={key}>
              <input
                type="radio"
                name="stack"
                form="tk-controls"
                value={key}
                checked={key === "provider"}
              />
              <span>{label}</span>
            </label>
          ))}
        </fieldset>
        <ul class="tk-chart-legend" aria-hidden="true">
          {skeletonRows(LEGEND_CHIPS).map(() => (
            <li data-skeleton>
              <span class="chip" />
              <span class="sk-line" style="inline-size: 3.5em" />
            </li>
          ))}
        </ul>
      </div>
      <h3 class="feed-label">Weekly rhythm</h3>
      <div class="tk-chart-head">
        <p class="tk-rhythm-scope">Weekday tokens</p>
        <p class="tk-rhythm-peak"></p>
      </div>
      <div
        class="tk-rhythm"
        role="img"
        aria-label="Average token usage by weekday"
      >
        <div class="tk-rhythm-plot" data-skeleton></div>
        <div class="tk-rhythm-axis" aria-hidden="true">
          {["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((day) => (
            <span>{day}</span>
          ))}
        </div>
        <div class="tk-tip" hidden></div>
      </div>
    </section>
    <section>
      <h2 id="breakdown">Breakdown</h2>
      <h3 class="feed-label">Models</h3>
      <ol class="tk-rows" data-list="model">
        {skeletonRows(TOP_ROWS).map(() => (
          <li class="tk-row" data-skeleton aria-hidden="true">
            <span class="ico sk-ico" />
            <span class="sk-line" style="inline-size: min(11em, 70%)" />
            <span class="sk-line sk-num" />
            <span class="sk-line sk-num" />
          </li>
        ))}
      </ol>
      <div class="tk-split">
        <div>
          <h3 class="feed-label">Clients</h3>
          <ol class="tk-rows" data-list="client">
            {skeletonRows(SPLIT_ROWS).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h3 class="feed-label">Providers</h3>
          <ol class="tk-rows" data-list="provider">
            {skeletonRows(SPLIT_ROWS).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
    <section>
      <h2 id="patterns">Patterns</h2>
      <dl class="tk-cards readout" data-cards="facts">
        {factCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="sub"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
    </section>
    <section>
      <h2 id="devices">Devices</h2>
      <ol class="tk-devices">
        {skeletonRows(SKELETON_ROWS).map(() => (
          <li class="tk-device" data-skeleton aria-hidden="true">
            <div class="dev-head">
              <span class="dev-status"><span class="dot" /><span class="sk-line" style="inline-size: 5em" /></span>
            </div>
            <div class="dev-id">
              <h3 class="dev-name"><span class="sk-line" style="inline-size: 6em" /></h3>
            </div>
            <div class="dev-share">
              <span class="dev-tokens"><span class="sk-line" style="inline-size: 2.5em" /></span>
              <span class="dev-meter"></span>
              <span class="dev-cap"><span class="sk-line sk-sub" style="inline-size: 6em" /></span>
            </div>
            <dl class="dev-stats">
              {["Cost", "Active days", "Sessions", "Active time"].map((label) => (
                <div>
                  <dt>{label}</dt>
                  <dd><span class="sk-line" style="inline-size: 3em" /></dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ol>
    </section>
  </div>
  <!--
    Shown only when there is nothing to paint at all: no cached payload
    and the collector did not answer. It replaces the body rather than
    sitting over it, so the skeletons are the "loading" state of the
    retry and this is the "failed" one — the same two states, never
    both.
  -->
  <div class="tk-fallback" role="status" hidden>
    <p class="fallback-title">Couldn’t load usage data.</p>
    <button type="button" class="tk-retry">Try again</button>
  </div>
</tokens-dashboard>

<script>
  import { mountTokensDashboard } from "@/lib/client/tokens-dashboard"

  document
    .querySelectorAll<HTMLElement>("tokens-dashboard")
    .forEach((root) => mountTokensDashboard(root))
</script>
