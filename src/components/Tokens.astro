---
import type { SvgComponent } from "astro/types"
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import Heatmap from "@/components/Heatmap.astro"
import Anthropic from "@/assets/icons/ai/anthropic.svg"
import Claude from "@/assets/icons/ai/claude.svg"
import ClaudeCode from "@/assets/icons/ai/claudecode.svg"
import Codex from "@/assets/icons/ai/codex.svg"
import Cursor from "@/assets/icons/ai/cursor.svg"
import Gemini from "@/assets/icons/ai/gemini.svg"
import Google from "@/assets/icons/ai/google.svg"
import Grok from "@/assets/icons/ai/grok.svg"
import Kimi from "@/assets/icons/ai/kimi.svg"
import OpenAI from "@/assets/icons/ai/openai.svg"
import OpenCode from "@/assets/icons/ai/opencode.svg"
import XAI from "@/assets/icons/ai/xai.svg"
import Zed from "@/assets/icons/ai/zed.svg"
import Zhipu from "@/assets/icons/ai/zhipu.svg"
import { TOKENS } from "@/consts"
import { COMPOSITION, RANGES } from "@/lib/client/tokens"

type Props = {
  endpoint?: string
}

const { endpoint = TOKENS.endpoint } = Astro.props

/** Mono brand SVGs, vendored from Lobe Icons (https://lobehub.com/icons)
 *  except zed.svg (official Zed mark, normalized to currentColor). The
 *  hidden defs block below is what the runtime script clones from. */
const AI_ICONS: Record<string, SvgComponent> = {
  anthropic: Anthropic,
  claude: Claude,
  claudecode: ClaudeCode,
  codex: Codex,
  cursor: Cursor,
  gemini: Gemini,
  google: Google,
  grok: Grok,
  kimi: Kimi,
  openai: OpenAI,
  opencode: OpenCode,
  xai: XAI,
  zed: Zed,
  zhipu: Zhipu,
}

const overviewCards = [
  { key: "tokens", label: "Tokens" },
  { key: "cost", label: "Cost" },
  { key: "messages", label: "Messages" },
  { key: "activeDays", label: "Active days" },
]

const factCards = [
  { key: "biggest", label: "Biggest day" },
  { key: "busiest", label: "Busiest week" },
  { key: "median", label: "Typical day" },
  { key: "weekday", label: "Top weekday" },
  { key: "longest", label: "Longest streak" },
  { key: "current", label: "Current streak" },
  { key: "models", label: "Models tried" },
  { key: "activeTime", label: "Active time" },
]

const skeletonRows = (count: number) =>
  Array.from({ length: count }, (_, i) => i)
---

<tokens-dashboard data-endpoint={endpoint} aria-busy="true">
  <div class="tk-icon-defs" hidden aria-hidden="true">
    {Object.entries(AI_ICONS).map(([name, Icon]) => (
      <span data-icon={name}><Icon /></span>
    ))}
    <span data-icon="chevron"><ChevronIcon /></span>
  </div>
  <p class="tk-intro">
    Token usage across my AI coding agents, live from my
    <a href={endpoint} target="_blank" rel="noopener noreferrer"
      >self-hosted collector</a
    >.
  </p>
  <div class="tk-body">
    <section>
      <h2 id="overview">Overview</h2>
      <form class="tk-controls">
        <fieldset class="tk-seg" aria-label="Time range">
          {RANGES.map((range) => (
            <label>
              <input
                type="radio"
                name="range"
                value={range.key}
                checked={range.key === "month"}
              />
              <span>{range.label}</span>
            </label>
          ))}
        </fieldset>
        <fieldset class="tk-seg" aria-label="Metric">
          <label>
            <input type="radio" name="metric" value="tokens" checked>
            <span>Tokens</span>
          </label>
          <label>
            <input type="radio" name="metric" value="cost">
            <span>Cost</span>
          </label>
        </fieldset>
      </form>
      <dl class="tk-cards" data-cards="overview">
        {overviewCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="sub"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
            <dd class="delta"><span class="sk-line sk-sub" style="inline-size: 5em" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
      <h3 class="tk-label">Token composition</h3>
      <div class="tk-mix">
        <div class="tk-mix-bar" data-skeleton></div>
        <ul class="tk-mix-legend">
          {COMPOSITION.map(({ key, label }, i) => (
            <li data-key={key}>
              <span class="name">
                <span class="chip" data-k={i} aria-hidden="true" />
                {label}
              </span>
              <span class="value"><span class="sk-line sk-stat" aria-hidden="true" /></span>
              <span class="share"><span class="sk-line sk-sub" style="inline-size: 3em" aria-hidden="true" /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section>
      <h2 id="trend">Trend</h2>
      <div class="tk-chart-head">
        <p class="tk-chart-scope">Daily tokens</p>
        <p class="tk-chart-peak"></p>
      </div>
      <div class="tk-chart" role="img" aria-label="Token usage over time">
        <div class="tk-chart-bars" data-skeleton></div>
        <div class="tk-chart-axis" aria-hidden="true"></div>
        <div class="tk-tip" hidden></div>
      </div>
      <div class="tk-chart-foot">
        <fieldset class="tk-seg tk-seg-sm" aria-label="Stack trend bars by">
          <label>
            <input type="radio" name="stack" value="provider" checked>
            <span>By provider</span>
          </label>
          <label>
            <input type="radio" name="stack" value="client">
            <span>By client</span>
          </label>
        </fieldset>
        <ul class="tk-chart-legend" aria-hidden="true"></ul>
      </div>
      <h3 class="tk-label">Weekly rhythm</h3>
      <div class="tk-chart-head">
        <p class="tk-rhythm-scope">Weekday tokens</p>
        <p class="tk-rhythm-peak"></p>
      </div>
      <div
        class="tk-rhythm"
        role="img"
        aria-label="Average token usage by weekday"
      >
        <div class="tk-rhythm-plot" data-skeleton></div>
        <div class="tk-rhythm-axis" aria-hidden="true">
          {["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((day) => (
            <span>{day}</span>
          ))}
        </div>
        <div class="tk-tip" hidden></div>
      </div>
    </section>
    <section>
      <h2 id="activity">Activity</h2>
      <Heatmap />
      <h3 class="tk-label">All-time patterns</h3>
      <dl class="tk-cards tk-facts" data-cards="facts">
        {factCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="sub"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
    </section>
    <section>
      <h2 id="breakdown">Breakdown</h2>
      <h3 class="tk-label">Models</h3>
      <ol class="tk-rows" data-list="model">
        {skeletonRows(6).map(() => (
          <li class="tk-row" data-skeleton aria-hidden="true">
            <span class="ico sk-ico" />
            <span class="sk-line" style="inline-size: min(11em, 70%)" />
            <span class="sk-line sk-num" />
            <span class="sk-line sk-num" />
          </li>
        ))}
      </ol>
      <div class="tk-split">
        <div>
          <h3 class="tk-label">Clients</h3>
          <ol class="tk-rows" data-list="client">
            {skeletonRows(4).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h3 class="tk-label">Providers</h3>
          <ol class="tk-rows" data-list="provider">
            {skeletonRows(4).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
    <section>
      <h2 id="devices">Devices</h2>
      <ol class="tk-devices">
        {skeletonRows(2).map(() => (
          <li class="tk-device" data-skeleton aria-hidden="true">
            <span class="dot" />
            <span class="dev-id">
              <span class="sk-line" style="inline-size: 7em" />
              <span class="sk-line sk-sub" />
            </span>
            <span class="dev-usage">
              <span class="sk-line sk-num" />
              <span class="sk-line sk-sub" style="justify-self: end" />
            </span>
          </li>
        ))}
      </ol>
    </section>
  </div>
  <p class="tk-fallback" hidden>
    Couldn’t load usage right now — the collector at
    <a href={endpoint} target="_blank" rel="noopener noreferrer"
      >tokens.lkwplus.com</a
    >
    may be napping. Try again in a minute.
  </p>
</tokens-dashboard>

<script>
  import {
    activeTotals,
    aiIcon,
    type Bucket,
    clientLabel,
    COMPOSITION,
    computeFacts,
    dailyBuckets,
    fillDaily,
    formatAgo,
    formatCost,
    formatCostExact,
    formatCount,
    formatDate,
    formatDay,
    formatDelta,
    formatDuration,
    formatExact,
    formatMetric,
    formatShare,
    formatTokens,
    HIDDEN_MODELS,
    isMessagesOnly,
    isOnline,
    levelScale,
    loadSite,
    type MetricKey,
    monthlyBuckets,
    providerLabel,
    type RangeKey,
    RANGES,
    type Site,
    shiftDays,
    type Stack,
    type StackDim,
    stackFor,
    stackLabel,
    type Usage,
    type UsageSpan,
    WEEKDAYS,
    type WeekdayStat,
    weekdayProfile,
    windowTotals,
  } from "@/lib/client/tokens"
  import { mountHeatmap } from "@/lib/client/heatmap"

  const TOP_ROWS = 8

  const el = (tag: string, className: string, text?: string) => {
    const node = document.createElement(tag)
    node.className = className
    if (text !== undefined) node.textContent = text
    return node
  }

  document.querySelectorAll<HTMLElement>("tokens-dashboard").forEach((root) => {
    const endpoint = root.dataset.endpoint
    const body = root.querySelector<HTMLElement>(".tk-body")
    const form = root.querySelector<HTMLFormElement>(".tk-controls")
    const fallback = root.querySelector<HTMLElement>(".tk-fallback")
    if (!endpoint || !body || !form) return

    const q = <T extends HTMLElement = HTMLElement>(selector: string) =>
      root.querySelector<T>(selector)

    let site: Site | null = null
    let stack: Stack = { dim: "provider", ids: [] }
    /** Breakdown lists the visitor has expanded past the top rows. */
    const expanded = new Set<string>()

    const iconDefs = q(".tk-icon-defs")
    const icon = (name: string | null) => {
      const svg = name
        ? iconDefs?.querySelector(`[data-icon="${name}"] svg`)
        : null
      return svg ? (svg.cloneNode(true) as SVGElement) : null
    }
    /** Icon slot; empty ones still reserve the column so names align. */
    const iconSlot = (name: string | null) => {
      const slot = el("span", "ico")
      slot.setAttribute("aria-hidden", "true")
      const svg = icon(name)
      if (svg) slot.append(svg)
      return slot
    }

    const readState = () => {
      const values = new FormData(form)
      const stackInput = root.querySelector<HTMLInputElement>(
        'input[name="stack"]:checked',
      )
      return {
        range: (values.get("range") ?? "month") as RangeKey,
        metric: (values.get("metric") ?? "tokens") as MetricKey,
        stackDim: (stackInput?.value ?? "provider") as StackDim,
      }
    }

    const setCard = (
      cards: HTMLElement | null,
      key: string,
      value: string,
      sub: string,
      exact?: string,
    ) => {
      const card = cards?.querySelector(`.tk-card[data-key="${key}"]`)
      const valueEl = card?.querySelector<HTMLElement>(".value")
      const subEl = card?.querySelector<HTMLElement>(".sub")
      if (!valueEl || !subEl) return
      valueEl.textContent = value
      if (exact) valueEl.title = exact
      subEl.textContent = sub
    }

    const setDelta = (key: string, text: string, title = "") => {
      const delta = q(
        `[data-cards="overview"] .tk-card[data-key="${key}"] .delta`,
      )
      if (!delta) return
      if (!text) {
        delta.replaceChildren()
        delta.removeAttribute("title")
        return
      }
      const [arrow, ...rest] = text.split(" ")
      delta.replaceChildren(
        el("span", "delta-val", `${arrow} ${rest.shift() ?? ""}`),
        document.createTextNode(` ${rest.join(" ")}`),
      )
      if (title) delta.title = title
      else delta.removeAttribute("title")
    }

    /* Overview: stat cards + composition bar */

    const renderOverview = (range: RangeKey) => {
      if (!site) return
      const stats = site.ranges[range]
      const totals = stats.totals
      const meta = RANGES.find((entry) => entry.key === range) ?? RANGES[1]
      const cards = q('[data-cards="overview"]')

      setCard(
        cards,
        "tokens",
        formatTokens(totals.tokens),
        totals.activeDays > 0
          ? `≈ ${formatTokens(totals.tokens / totals.activeDays)} per active day`
          : "—",
        `${formatExact(totals.tokens)} tokens`,
      )
      setCard(
        cards,
        "cost",
        formatCost(totals.cost),
        totals.tokens > 0
          ? `≈ ${formatCostExact(totals.cost / (totals.tokens / 1e6))} per 1M tokens`
          : "—",
        formatCostExact(totals.cost),
      )
      setCard(
        cards,
        "messages",
        formatCount(totals.messages),
        totals.messages > 0
          ? `≈ ${formatTokens(totals.tokens / totals.messages)} tokens each`
          : "—",
        formatExact(totals.messages),
      )
      setCard(
        cards,
        "activeDays",
        String(totals.activeDays),
        range === "all"
          ? totals.firstDate
            ? `since ${formatDate(totals.firstDate)}`
            : "—"
          : `of the last ${meta.days} days`,
      )

      // Period-over-period: same-length window immediately before this one.
      if (meta.days && stats.from) {
        const prev = windowTotals(
          site.daily,
          shiftDays(stats.from, -meta.days),
          shiftDays(stats.from, -1),
        )
        const vs = `vs prior ${meta.days} days`
        const ratio = (cur: number, base: number) => (cur - base) / base
        const numeric = (
          key: "tokens" | "cost" | "messages",
          format: (n: number) => string,
        ) => {
          if (prev[key] > 0)
            setDelta(
              key,
              `${formatDelta(ratio(totals[key], prev[key]))} ${vs}`,
              `previous: ${format(prev[key])}`,
            )
          else setDelta(key, totals[key] > 0 ? `↑ new ${vs}` : "")
        }
        numeric("tokens", (n) => `${formatExact(n)} tokens`)
        numeric("cost", formatCostExact)
        numeric("messages", formatExact)
        const dayDiff = totals.activeDays - prev.activeDays
        setDelta(
          "activeDays",
          dayDiff === 0
            ? `→ same as prior ${meta.days} days`
            : `${dayDiff > 0 ? "↑" : "↓"} ${Math.abs(dayDiff)} ${vs}`,
          `previous: ${prev.activeDays} active days`,
        )
      } else {
        for (const key of ["tokens", "cost", "messages", "activeDays"]) {
          setDelta(key, "")
        }
      }

      const bar = q(".tk-mix-bar")
      const legend = q(".tk-mix-legend")
      const sum = COMPOSITION.reduce((acc, part) => acc + totals[part.key], 0)
      if (bar) {
        bar.replaceChildren(
          ...COMPOSITION.flatMap((part, i) => {
            const value = totals[part.key]
            if (value <= 0) return []
            const segment = el("span", "")
            segment.dataset.k = String(i)
            segment.style.flexGrow = String(value / sum)
            segment.title = `${part.label} — ${formatTokens(value)} (${formatShare(value / sum)})`
            return [segment]
          }),
        )
        bar.removeAttribute("data-skeleton")
      }
      for (const part of COMPOSITION) {
        const item = legend?.querySelector<HTMLElement>(
          `[data-key="${part.key}"]`,
        )
        const value = item?.querySelector<HTMLElement>(".value")
        const share = item?.querySelector<HTMLElement>(".share")
        if (!value || !share) continue
        const amount = totals[part.key]
        value.textContent = sum > 0 ? formatTokens(amount) : "—"
        value.title = `${formatExact(amount)} tokens`
        share.textContent = sum > 0 ? formatShare(amount / sum) : ""
      }
    }

    /* Trend: bars stacked by provider; monthly buckets for all time */

    const tip = q(".tk-tip")
    let tipBuckets: Bucket[] = []
    let tipMetric: MetricKey = "tokens"

    const buildTip = (bucket: Bucket) => {
      if (!tip) return
      const rows = stack.ids
        .map((id, i) => ({ id, value: bucket.segments[i] }))
        .filter((row) => row.value > 0)
      const list = el("ul", "")
      for (const row of rows) {
        const item = el("li", "")
        const chip = el("span", "chip")
        chip.dataset.p = row.id
        item.append(
          chip,
          el("span", "", stackLabel(stack.dim, row.id)),
          el(
            "span",
            "tip-share",
            `${formatMetric(row.value, tipMetric)} · ${formatShare(row.value / bucket[tipMetric])}`,
          ),
        )
        list.append(item)
      }
      tip.replaceChildren(
        el("strong", "tip-title", bucket.title),
        el(
          "span",
          "tip-total",
          bucket.tokens > 0 || bucket.cost > 0
            ? `${formatTokens(bucket.tokens)} tokens · ${formatCost(bucket.cost)} · ${formatCount(bucket.messages)} ${bucket.messages === 1 ? "message" : "messages"}`
            : bucket.messages > 0
              ? `${formatCount(bucket.messages)} ${bucket.messages === 1 ? "message" : "messages"} · token counts unavailable`
              : "No usage",
        ),
        ...(rows.length > 0 ? [list] : []),
      )
    }

    const hideTip = () => {
      if (tip) tip.hidden = true
    }

    const showTip = (bar: HTMLElement) => {
      const chart = q(".tk-chart")
      const bucket = tipBuckets[Number(bar.dataset.i)]
      if (!tip || !chart || !bucket) return
      buildTip(bucket)
      tip.hidden = false
      const barRect = bar.getBoundingClientRect()
      const chartRect = chart.getBoundingClientRect()
      const center = barRect.left + barRect.width / 2 - chartRect.left
      const left = Math.min(
        Math.max(center - tip.offsetWidth / 2, 0),
        chartRect.width - tip.offsetWidth,
      )
      tip.style.left = `${left}px`
    }

    const renderTrend = (range: RangeKey, metric: MetricKey, dim: StackDim) => {
      if (!site) return
      stack = stackFor(site, dim)
      const meta = RANGES.find((entry) => entry.key === range) ?? RANGES[1]
      const from = site.ranges[range].from
      const buckets =
        range === "all" || !from
          ? monthlyBuckets(site.daily, site.today, stack, metric)
          : dailyBuckets(fillDaily(site.daily, from, site.today), stack, metric)
      const values = buckets.map((bucket) => bucket[metric])
      const max = Math.max(...values, 0)
      const total = values.reduce((acc, value) => acc + value, 0)
      const peakBucket = buckets[values.indexOf(max)]
      const noun = metric === "cost" ? "cost" : "tokens"
      const scopeText =
        range === "all"
          ? `Monthly ${noun} · all time`
          : `Daily ${noun} · last ${meta.days} days`

      const scope = q(".tk-chart-scope")
      if (scope) scope.textContent = scopeText
      const peak = q(".tk-chart-peak")
      if (peak) {
        peak.textContent = total > 0 ? `peak ${formatMetric(max, metric)}` : ""
        peak.title = total > 0 && peakBucket ? peakBucket.title : ""
      }

      tipBuckets = buckets
      tipMetric = metric
      hideTip()

      const bars = q(".tk-chart-bars")
      if (bars) {
        bars.replaceChildren(
          ...buckets.map((bucket, index) => {
            const bar = el("span", "")
            const value = bucket[metric]
            bar.dataset.i = String(index)
            bar.style.setProperty("--v", String(max > 0 ? value / max : 0))
            if (value <= 0) bar.dataset.zero = ""
            else
              bar.append(
                ...stack.ids.flatMap((id, i) => {
                  const share = bucket.segments[i]
                  if (share <= 0) return []
                  const segment = document.createElement("i")
                  segment.dataset.p = id
                  segment.style.flexGrow = String(share)
                  return [segment]
                }),
              )
            return bar
          }),
        )
        bars.removeAttribute("data-skeleton")
      }

      const axis = q(".tk-chart-axis")
      if (axis && buckets.length > 0) {
        const marks = [
          ...new Set([
            0,
            Math.floor((buckets.length - 1) / 2),
            buckets.length - 1,
          ]),
        ]
        axis.replaceChildren(
          ...marks.map((i) => el("span", "", buckets[i].label)),
        )
      }

      const legend = q(".tk-chart-legend")
      if (legend) {
        const active = stack.ids.filter((_, i) =>
          buckets.some((bucket) => bucket.segments[i] > 0),
        )
        legend.replaceChildren(
          ...active.map((id) => {
            const item = el("li", "")
            const chip = el("span", "chip")
            chip.dataset.p = id
            item.append(chip, stackLabel(stack.dim, id))
            return item
          }),
        )
      }

      q(".tk-chart")?.setAttribute(
        "aria-label",
        total > 0 && peakBucket
          ? `${scopeText}: ${formatMetric(total, metric)} in total, peaking at ${formatMetric(max, metric)} (${peakBucket.title})`
          : `${scopeText}: no usage recorded`,
      )
    }

    /* Weekly rhythm: average consumption per weekday as a line chart */

    const rhythm = q(".tk-rhythm")
    const rhythmPlot = q(".tk-rhythm-plot")
    const rhythmTip = q<HTMLElement>(".tk-rhythm .tk-tip")
    let rhythmStats: WeekdayStat[] = []
    let rhythmMetric: MetricKey = "tokens"
    let rhythmSingle = false

    const drawRhythm = () => {
      if (!rhythmPlot || rhythmStats.length === 0) return
      const width = rhythmPlot.clientWidth
      const height = rhythmPlot.clientHeight
      if (width === 0 || height === 0) return

      const max = Math.max(...rhythmStats.map((stat) => stat.average))
      const padTop = 8
      const padBottom = 4
      const inner = height - padTop - padBottom
      const x = (i: number) => ((i + 0.5) / rhythmStats.length) * width
      const y = (value: number) =>
        padTop + (1 - (max > 0 ? value / max : 0)) * inner

      const ns = "http://www.w3.org/2000/svg"
      const shape = (tag: string, attrs: Record<string, string>) => {
        const node = document.createElementNS(ns, tag)
        for (const [name, value] of Object.entries(attrs)) {
          node.setAttribute(name, value)
        }
        return node
      }

      const svg = shape("svg", {
        viewBox: `0 0 ${width} ${height}`,
        preserveAspectRatio: "none",
      }) as SVGSVGElement

      // Quarter gridlines of the value scale, echoing the trend chart.
      if (max > 0) {
        for (const ratio of [0.25, 0.5, 0.75, 1]) {
          svg.append(
            shape("line", {
              class: "grid",
              x1: "0",
              x2: String(width),
              y1: String(y(max * ratio)),
              y2: String(y(max * ratio)),
            }),
          )
        }
      }

      const points = rhythmStats.map((stat, i) => [x(i), y(stat.average)])
      const line = points
        .map(([px, py], i) => `${i === 0 ? "M" : "L"}${px} ${py}`)
        .join(" ")
      svg.append(
        shape("path", {
          class: "area",
          d: `${line} L${points[points.length - 1][0]} ${height} L${points[0][0]} ${height} Z`,
        }),
        shape("path", { class: "line", d: line }),
      )

      const peakIndex = rhythmStats.findIndex((stat) => stat.average === max)
      points.forEach(([px, py], i) => {
        const dot = shape("circle", {
          class: "dot",
          cx: String(px),
          cy: String(py),
          r: i === peakIndex && max > 0 ? "4" : "3",
        })
        if (i === peakIndex && max > 0) dot.dataset.peak = ""
        svg.append(dot)
      })

      // Invisible hover columns, one per weekday.
      rhythmStats.forEach((_, i) => {
        svg.append(
          shape("rect", {
            class: "hit",
            "data-i": String(i),
            x: String((i / rhythmStats.length) * width),
            y: "0",
            width: String(width / rhythmStats.length),
            height: String(height),
          }),
        )
      })

      rhythmPlot.replaceChildren(svg)
      rhythmPlot.removeAttribute("data-skeleton")
    }

    const hideRhythmTip = () => {
      if (rhythmTip) rhythmTip.hidden = true
    }

    const showRhythmTip = (hit: SVGElement) => {
      const stat = rhythmStats[Number(hit.dataset.i)]
      if (!rhythmTip || !rhythm || !stat) return
      const name = WEEKDAYS[stat.weekday]
      const lines: string[] = []
      if (stat.occurrences === 0) {
        lines.push("No data")
      } else if (rhythmSingle) {
        // The 7-day window holds exactly one of each weekday.
        lines.push(
          stat.total > 0 ? formatMetric(stat.total, rhythmMetric) : "No usage",
        )
      } else {
        lines.push(
          `≈ ${formatMetric(stat.average, rhythmMetric)} on average · ${formatMetric(stat.total, rhythmMetric)} total`,
          `active on ${stat.activeDays} of ${stat.occurrences} ${name}s`,
        )
      }
      rhythmTip.replaceChildren(
        el("strong", "tip-title", name),
        ...lines.map((line) => el("span", "tip-total", line)),
      )
      rhythmTip.hidden = false
      const hitRect = hit.getBoundingClientRect()
      const areaRect = rhythm.getBoundingClientRect()
      const center = hitRect.left + hitRect.width / 2 - areaRect.left
      rhythmTip.style.left = `${Math.min(
        Math.max(center - rhythmTip.offsetWidth / 2, 0),
        areaRect.width - rhythmTip.offsetWidth,
      )}px`
    }

    const renderRhythm = (range: RangeKey, metric: MetricKey) => {
      if (!site) return
      const meta = RANGES.find((entry) => entry.key === range) ?? RANGES[1]
      const from =
        site.ranges[range].from ??
        site.ranges.all.totals.firstDate ??
        site.today
      rhythmStats = weekdayProfile(
        fillDaily(site.daily, from, site.today),
        metric,
      )
      rhythmMetric = metric
      rhythmSingle = range === "week"
      hideRhythmTip()

      const noun = metric === "cost" ? "cost" : "tokens"
      const scope = q(".tk-rhythm-scope")
      if (scope) {
        scope.textContent = `Weekday ${noun} · ${meta.days ? `last ${meta.days} days` : "all time"}`
      }

      const max = Math.max(...rhythmStats.map((stat) => stat.average))
      const peakStat = rhythmStats.find((stat) => stat.average === max)
      const peak = q(".tk-rhythm-peak")
      if (peak) {
        peak.textContent =
          max > 0 && peakStat
            ? `peak ${WEEKDAYS[peakStat.weekday].slice(0, 3)} ${rhythmSingle ? "" : "≈ "}${formatMetric(max, metric)}`
            : ""
      }
      rhythm?.setAttribute(
        "aria-label",
        max > 0 && peakStat
          ? `Average daily ${noun} by weekday: peaks on ${WEEKDAYS[peakStat.weekday]} at ${formatMetric(max, metric)}`
          : `Average daily ${noun} by weekday: no usage recorded`,
      )

      drawRhythm()
    }

    /* Activity: 12-month heatmap + all-time patterns (rendered once) */

    const renderHeatmap = () => {
      const grid = q(".heat-grid")
      if (!grid || !site) return
      const days = fillDaily(
        site.daily,
        shiftDays(site.today, -364),
        site.today,
      )
      // Quartile levels over the full year, so the fit-to-width slice
      // reads the same at any viewport. Days with messages but no token
      // metadata (early-2025 Cursor logs) render as hollow cells, level -1
      // in Heatmap.astro — real activity, unknown size.
      const level = levelScale(days)
      mountHeatmap(grid, days, (shown) =>
        shown.map((day) => ({
          level: isMessagesOnly(day) ? -1 : level(day.tokens),
          title:
            day.tokens > 0
              ? `${formatTokens(day.tokens)} tokens on ${formatDate(day.date)} · ${formatCostExact(day.cost)} · ${formatCount(day.messages)} ${day.messages === 1 ? "message" : "messages"}${day.active ? ` · ${formatDuration(day.active)} active` : ""}`
              : isMessagesOnly(day)
                ? `${formatCount(day.messages)} ${day.messages === 1 ? "message" : "messages"} on ${formatDate(day.date)} · token counts unavailable`
                : `No usage on ${formatDate(day.date)}`,
        })),
      )
    }

    const renderFacts = () => {
      if (!site) return
      const cards = q('[data-cards="facts"]')
      const start = site.ranges.all.totals.firstDate ?? site.today
      const facts = computeFacts(fillDaily(site.daily, start, site.today))
      const days = (n: number) => `${n} ${n === 1 ? "day" : "days"}`

      setCard(
        cards,
        "biggest",
        facts.biggest ? formatTokens(facts.biggest.tokens) : "—",
        facts.biggest
          ? `${formatDate(facts.biggest.date)} · ${formatCost(facts.biggest.cost)}`
          : "no usage yet",
        facts.biggest
          ? `${formatExact(facts.biggest.tokens)} tokens`
          : undefined,
      )
      setCard(
        cards,
        "busiest",
        facts.busiestWeek ? formatTokens(facts.busiestWeek.tokens) : "—",
        facts.busiestWeek
          ? `${formatDay(facts.busiestWeek.from)} – ${formatDay(facts.busiestWeek.to)}`
          : "—",
        facts.busiestWeek
          ? `${formatExact(facts.busiestWeek.tokens)} tokens`
          : undefined,
      )
      setCard(
        cards,
        "median",
        facts.median !== null ? formatTokens(facts.median) : "—",
        "median across active days",
        facts.median !== null
          ? `${formatExact(Math.round(facts.median))} tokens`
          : undefined,
      )
      setCard(
        cards,
        "weekday",
        facts.weekday?.name ?? "—",
        facts.weekday
          ? `${formatShare(facts.weekday.share)} of all tokens`
          : "—",
      )
      setCard(
        cards,
        "longest",
        facts.longest ? days(facts.longest.length) : "—",
        facts.longest
          ? `${formatDay(facts.longest.from)} – ${formatDay(facts.longest.to)}`
          : "—",
      )
      setCard(
        cards,
        "current",
        facts.current ? days(facts.current.length) : "0 days",
        facts.current ? `since ${formatDay(facts.current.since)}` : "—",
      )

      const models = site.ranges.all.byModel.filter(
        (entry) => !HIDDEN_MODELS.has(entry.model),
      )
      setCard(
        cards,
        "models",
        String(models.length),
        models.length > 0
          ? `across ${site.ranges.all.byClient.length} ${site.ranges.all.byClient.length === 1 ? "client" : "clients"}`
          : "—",
        models.length > 0 ? `most used: ${models[0].model}` : undefined,
      )

      const tracked = activeTotals(site.daily)
      setCard(
        cards,
        "activeTime",
        tracked.ms > 0 ? formatDuration(tracked.ms) : "—",
        tracked.ms > 0
          ? `across ${tracked.days} tracked ${tracked.days === 1 ? "day" : "days"}`
          : "not reported yet",
        tracked.ms > 0
          ? `wall-clock agent time, reported by the CLI since it began tracking`
          : undefined,
      )
    }

    /* Breakdown: top models / clients / providers for the range */

    type BreakdownKind = "model" | "client" | "provider"

    const renderBreakdown = (range: RangeKey, metric: MetricKey) => {
      if (!site) return
      const stats = site.ranges[range]

      const groups: {
        key: BreakdownKind
        rows: { id: string; name: string; usage: Usage & UsageSpan }[]
      }[] = [
        {
          key: "model",
          rows: stats.byModel
            .filter((entry) => !HIDDEN_MODELS.has(entry.model))
            .map((entry) => ({
              id: entry.model,
              name: entry.model,
              usage: entry,
            })),
        },
        {
          key: "client",
          rows: stats.byClient.map((entry) => ({
            id: entry.client,
            name: clientLabel(entry.client),
            usage: entry,
          })),
        },
        {
          key: "provider",
          rows: stats.byProvider.map((entry) => ({
            id: entry.provider,
            name: providerLabel(entry.provider),
            usage: entry,
          })),
        },
      ]

      for (const group of groups) {
        const list = q(`.tk-rows[data-list="${group.key}"]`)
        if (!list) continue
        const total = stats.totals[metric]
        const live = group.rows
          .filter((row) => row.usage[metric] > 0)
          .sort((a, b) => b.usage[metric] - a.usage[metric])
        const isOpen = expanded.has(group.key)
        const shown = isOpen ? live : live.slice(0, TOP_ROWS)
        const rest = live.slice(TOP_ROWS)

        const items = shown.map((row) => {
          const item = el("li", "tk-row")
          // Row depth that has no column: exact numbers, unit cost, span.
          const parts = [
            `${formatExact(row.usage.tokens)} tokens`,
            formatCostExact(row.usage.cost),
            `${formatExact(row.usage.messages)} messages`,
          ]
          if (row.usage.tokens > 0 && row.usage.cost > 0) {
            parts.push(
              `${formatCostExact(row.usage.cost / (row.usage.tokens / 1e6))} per 1M`,
            )
          }
          if (row.usage.days > 0) {
            parts.push(
              `used ${row.usage.days} ${row.usage.days === 1 ? "day" : "days"}`,
            )
          }
          if (row.usage.firstDate) {
            parts.push(`first ${formatDate(row.usage.firstDate)}`)
          }
          item.title = `${row.name} — ${parts.join(" · ")}`
          // Proportional fill behind the row: its share of the range
          // total, so the bar width matches the printed percentage.
          item.style.setProperty(
            "--w",
            String(total > 0 ? row.usage[metric] / total : 0),
          )
          item.append(
            iconSlot(aiIcon(group.key, row.id)),
            el("span", "name", row.name),
            el("span", "val", formatMetric(row.usage[metric], metric)),
            el(
              "span",
              "share",
              formatShare(total > 0 ? row.usage[metric] / total : NaN),
            ),
          )
          return item
        })

        if (rest.length > 0) {
          const row = el("li", "tk-more")
          const button = document.createElement("button")
          button.type = "button"
          button.className = "tk-more-btn"
          button.setAttribute("aria-expanded", String(isOpen))
          const chevron = icon("chevron")
          if (chevron) button.append(chevron)
          const noun = group.key + (rest.length === 1 ? "" : "s")
          button.append(
            el(
              "span",
              "more-label",
              isOpen ? "Show less" : `Show ${rest.length} more ${noun}`,
            ),
          )
          if (!isOpen) {
            const sum = rest.reduce((acc, r) => acc + r.usage[metric], 0)
            button.append(el("span", "more-amount", formatMetric(sum, metric)))
          }
          button.addEventListener("click", () => {
            if (isOpen) expanded.delete(group.key)
            else expanded.add(group.key)
            const state = readState()
            renderBreakdown(state.range, state.metric)
          })
          row.append(button)
          items.push(row)
        }

        if (items.length === 0) {
          items.push(el("li", "tk-empty", "No usage in this range."))
        }
        list.replaceChildren(...items)
      }
    }

    /* Devices: inventory with liveness, rendered once */

    const renderDevices = () => {
      const list = q(".tk-devices")
      if (!list || !site) return
      if (site.devices.length === 0) {
        list.replaceChildren(el("li", "tk-empty", "No devices reporting yet."))
        return
      }
      list.replaceChildren(
        ...site.devices.map((device) => {
          const item = el("li", "tk-device")
          const online = isOnline(device.lastSeen)

          // Depth that doesn't fit the row lives in the tooltip.
          const details = [
            device.activeMs
              ? `${formatDuration(device.activeMs)} active in total`
              : "",
            device.longestMs
              ? `longest stretch ${formatDuration(device.longestMs)}`
              : "",
            device.maxConcurrent && device.maxConcurrent > 1
              ? `up to ${device.maxConcurrent} concurrent sessions`
              : "",
            device.mcpServers?.length
              ? `MCP: ${device.mcpServers.join(", ")}`
              : "",
            device.firstSeen
              ? `first seen ${formatDate(new Date(device.firstSeen).toISOString())}`
              : "",
          ].filter((part) => part !== "")
          if (details.length > 0) item.title = details.join(" · ")

          const dot = el("span", "dot")
          if (online) dot.dataset.online = ""
          dot.setAttribute("role", "img")
          dot.setAttribute("aria-label", online ? "Online" : "Offline")

          const id = el("span", "dev-id")
          const seen =
            device.lastSeen === null
              ? "never reported"
              : `${online ? "synced" : "last seen"} ${formatAgo(device.lastSeen)}`
          const facts = [
            seen,
            device.cliVersion ? `v${device.cliVersion}` : "",
            device.sessions ? `${formatExact(device.sessions)} sessions` : "",
          ].filter((part) => part !== "")
          id.append(
            el("span", "dev-name", device.name),
            el("span", "dev-seen", facts.join(" · ")),
          )

          const usage = el("span", "dev-usage")
          const tokens = el("span", "dev-tokens", formatTokens(device.tokens))
          tokens.title = `${formatExact(device.tokens)} tokens`
          const meta = [
            formatCost(device.cost),
            `${device.activeDays} active ${device.activeDays === 1 ? "day" : "days"}`,
          ].filter((part) => part !== "")
          usage.append(tokens, el("span", "dev-meta", meta.join(" · ")))

          item.append(dot, id, usage)
          return item
        }),
      )
    }

    const renderDynamic = () => {
      const { range, metric, stackDim } = readState()
      renderOverview(range)
      renderTrend(range, metric, stackDim)
      renderRhythm(range, metric)
      renderBreakdown(range, metric)
    }

    form.addEventListener("submit", (event) => event.preventDefault())
    form.addEventListener("change", () => {
      if (site) renderDynamic()
    })
    // The stack toggle lives in the chart footer, outside the form.
    q(".tk-chart-foot .tk-seg")?.addEventListener("change", () => {
      if (site) renderDynamic()
    })

    const barsArea = q(".tk-chart-bars")
    barsArea?.addEventListener("pointerover", (event) => {
      const bar = (event.target as Element).closest<HTMLElement>("span[data-i]")
      if (bar) showTip(bar)
    })
    barsArea?.addEventListener("pointerleave", hideTip)

    rhythmPlot?.addEventListener("pointerover", (event) => {
      const hit = (event.target as Element).closest<SVGElement>("rect[data-i]")
      if (hit) showRhythmTip(hit)
    })
    rhythmPlot?.addEventListener("pointerleave", hideRhythmTip)

    loadSite(endpoint)
      .then((loaded) => {
        site = loaded
        renderHeatmap()
        renderFacts()
        renderDevices()
        renderDynamic()
        if (rhythmPlot) new ResizeObserver(drawRhythm).observe(rhythmPlot)
        root.setAttribute("aria-busy", "false")
      })
      .catch(() => {
        body.hidden = true
        if (fallback) fallback.hidden = false
        root.setAttribute("aria-busy", "false")
      })
  })
</script>

