---
import type { SvgComponent } from "astro/types"
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import Heatmap from "@/components/Heatmap.astro"
import Alibaba from "@/assets/icons/ai/alibaba.svg"
import Anthropic from "@/assets/icons/ai/anthropic.svg"
import Claude from "@/assets/icons/ai/claude.svg"
import ClaudeCode from "@/assets/icons/ai/claudecode.svg"
import Codex from "@/assets/icons/ai/codex.svg"
import Cursor from "@/assets/icons/ai/cursor.svg"
import DeepSeek from "@/assets/icons/ai/deepseek.svg"
import Gemini from "@/assets/icons/ai/gemini.svg"
import Google from "@/assets/icons/ai/google.svg"
import Grok from "@/assets/icons/ai/grok.svg"
import HermesAgent from "@/assets/icons/ai/hermesagent.svg"
import Kimi from "@/assets/icons/ai/kimi.svg"
import Meta from "@/assets/icons/ai/meta.svg"
import Moonshot from "@/assets/icons/ai/moonshot.svg"
import OpenAI from "@/assets/icons/ai/openai.svg"
import OpenCode from "@/assets/icons/ai/opencode.svg"
import OpenRouter from "@/assets/icons/ai/openrouter.svg"
import Pi from "@/assets/icons/ai/pi.svg"
import Qwen from "@/assets/icons/ai/qwen.svg"
import XAI from "@/assets/icons/ai/xai.svg"
import Zai from "@/assets/icons/ai/zai.svg"
import Zed from "@/assets/icons/ai/zed.svg"
import { TOKENS } from "@/consts"
import { COMPOSITION, RANGES } from "@/lib/client/tokens"

type Props = {
  endpoint?: string
}

const { endpoint = TOKENS.endpoint } = Astro.props

/** Mono brand SVGs, vendored from Lobe Icons (https://lobehub.com/icons)
 *  except zed.svg (official Zed mark, normalized to currentColor). The
 *  hidden defs block below is what the runtime script clones from. */
const AI_ICONS: Record<string, SvgComponent> = {
  alibaba: Alibaba,
  anthropic: Anthropic,
  claude: Claude,
  claudecode: ClaudeCode,
  codex: Codex,
  cursor: Cursor,
  deepseek: DeepSeek,
  gemini: Gemini,
  google: Google,
  grok: Grok,
  hermesagent: HermesAgent,
  kimi: Kimi,
  meta: Meta,
  moonshot: Moonshot,
  openai: OpenAI,
  opencode: OpenCode,
  openrouter: OpenRouter,
  pi: Pi,
  qwen: Qwen,
  xai: XAI,
  zai: Zai,
  zed: Zed,
}

const dayCards = [
  { key: "tokens", label: "Tokens" },
  { key: "cost", label: "Cost" },
  { key: "messages", label: "Messages" },
  { key: "activeTime", label: "Active time" },
]

const overviewCards = [
  { key: "tokens", label: "Tokens" },
  { key: "cost", label: "Cost" },
  { key: "messages", label: "Messages" },
  { key: "activeDays", label: "Active days" },
]

/** Dimensions the trend chart stacks by. */
const stackOptions = [
  { key: "provider", label: "By provider" },
  { key: "client", label: "By client" },
  { key: "model", label: "By model" },
]

const factCards = [
  { key: "biggest", label: "Biggest day" },
  { key: "busiest", label: "Busiest week" },
  { key: "median", label: "Typical day" },
  { key: "weekday", label: "Top weekday" },
  { key: "longest", label: "Longest streak" },
  { key: "current", label: "Current streak" },
  { key: "models", label: "Models tried" },
  { key: "activeTime", label: "Active time" },
]

const skeletonRows = (count: number) =>
  Array.from({ length: count }, (_, i) => i)
---

<tokens-dashboard data-endpoint={endpoint} aria-busy="true">
  <div class="tk-icon-defs" hidden aria-hidden="true">
    {Object.entries(AI_ICONS).map(([name, Icon]) => (
      <span data-icon={name}><Icon /></span>
    ))}
    <span data-icon="chevron"><ChevronIcon /></span>
  </div>
  <p class="tk-intro">
    Token usage across my AI coding agents, live from my
    <a href={endpoint} target="_blank" rel="noopener noreferrer"
      >self-hosted collector</a
    >.
  </p>
  <div class="tk-body">
    <section class="tk-quota-section">
      <h2 id="quota">Quota</h2>
      <ol class="tk-plans">
        {skeletonRows(2).map(() => (
          <li class="tk-plan" data-skeleton aria-hidden="true">
            <div class="plan-head">
              <span class="ico sk-ico" />
              <span class="sk-line" style="inline-size: 4em" />
            </div>
            <ol class="tk-windows">
              <li class="tk-window">
                <div class="win-head">
                  <span class="sk-line" style="inline-size: 4em" />
                  <span class="sk-line sk-num" />
                </div>
                <div class="tk-meter" data-skeleton></div>
                <p class="win-foot"><span class="sk-line sk-sub" /></p>
              </li>
            </ol>
          </li>
        ))}
      </ol>
    </section>
    <section>
      <div class="tk-head">
        <h2 id="activity">Activity</h2>
        <p class="tk-sync">
          <span class="sk-line sk-sub" aria-hidden="true" />
        </p>
      </div>
      <Heatmap selectable />
      <div class="tk-day">
        <div class="tk-day-head">
          <h3 class="tk-label tk-day-label">Today</h3>
          <button type="button" class="tk-day-back" hidden>
            Back to today
          </button>
        </div>
        <div class="tk-day-body">
          <dl class="tk-cards" data-cards="day">
            {dayCards.map(({ key, label }) => (
              <div class="tk-card" data-key={key}>
                <dt>{label}</dt>
                <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
                <dd class="delta"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
              </div>
            ))}
          </dl>
          <div class="tk-day-breakdown tk-mix">
            <div class="tk-day-bar" data-skeleton></div>
            <ul class="tk-rows tk-day-legend">
              {skeletonRows(3).map(() => (
                <li class="tk-row" data-skeleton aria-hidden="true">
                  <span class="ico sk-ico" />
                  <span class="sk-line" style="inline-size: min(11em, 70%)" />
                  <span class="sk-line sk-num" />
                  <span class="sk-line sk-num" />
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p class="tk-day-empty" hidden>Zero-byte kind of day.</p>
      </div>
      <h3 class="tk-label">All-time patterns</h3>
      <dl class="tk-cards tk-facts" data-cards="facts">
        {factCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="sub"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
    </section>
    <section>
      <h2 id="overview">Overview</h2>
      <form id="tk-controls" class="tk-controls">
        <fieldset class="tk-seg" aria-label="Time range">
          {RANGES.map((range) => (
            <label>
              <input
                type="radio"
                name="range"
                value={range.key}
                checked={range.default}
              />
              <span>{range.label}</span>
            </label>
          ))}
        </fieldset>
        <fieldset class="tk-seg" aria-label="Metric">
          <label>
            <input type="radio" name="metric" value="tokens" checked>
            <span>Tokens</span>
          </label>
          <label>
            <input type="radio" name="metric" value="cost">
            <span>Cost</span>
          </label>
        </fieldset>
      </form>
      <dl class="tk-cards" data-cards="overview">
        {overviewCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="sub"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
            <dd class="delta"><span class="sk-line sk-sub" style="inline-size: 5em" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
      <h3 class="tk-label">Token composition</h3>
      <div class="tk-mix">
        <div class="tk-mix-bar tk-mix-composition" data-skeleton></div>
        <ul class="tk-mix-legend">
          {COMPOSITION.map(({ key, label }, i) => (
            <li data-key={key}>
              <span class="name">
                <span class="chip" data-k={i} aria-hidden="true" />
                {label}
              </span>
              <span class="value"><span class="sk-line sk-stat" aria-hidden="true" /></span>
              <span class="share"><span class="sk-line sk-sub" style="inline-size: 3em" aria-hidden="true" /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section>
      <h2 id="trend">Trend</h2>
      <div class="tk-chart-head">
        <p class="tk-chart-scope">Daily tokens</p>
        <p class="tk-chart-peak"></p>
      </div>
      <div class="tk-chart" role="img" aria-label="Token usage over time">
        <div class="tk-chart-bars" data-skeleton></div>
        <div class="tk-chart-axis" aria-hidden="true"></div>
        <div class="tk-tip" hidden></div>
      </div>
      <div class="tk-chart-foot">
        <fieldset class="tk-seg tk-seg-sm" aria-label="Stack trend bars by">
          {stackOptions.map(({ key, label }) => (
            <label data-stack={key}>
              <input
                type="radio"
                name="stack"
                form="tk-controls"
                value={key}
                checked={key === "provider"}
              />
              <span>{label}</span>
            </label>
          ))}
        </fieldset>
        <ul class="tk-chart-legend" aria-hidden="true"></ul>
      </div>
      <h3 class="tk-label">Weekly rhythm</h3>
      <div class="tk-chart-head">
        <p class="tk-rhythm-scope">Weekday tokens</p>
        <p class="tk-rhythm-peak"></p>
      </div>
      <div
        class="tk-rhythm"
        role="img"
        aria-label="Average token usage by weekday"
      >
        <div class="tk-rhythm-plot" data-skeleton></div>
        <div class="tk-rhythm-axis" aria-hidden="true">
          {["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((day) => (
            <span>{day}</span>
          ))}
        </div>
        <div class="tk-tip" hidden></div>
      </div>
    </section>
    <section>
      <h2 id="breakdown">Breakdown</h2>
      <h3 class="tk-label">Models</h3>
      <ol class="tk-rows" data-list="model">
        {skeletonRows(6).map(() => (
          <li class="tk-row" data-skeleton aria-hidden="true">
            <span class="ico sk-ico" />
            <span class="sk-line" style="inline-size: min(11em, 70%)" />
            <span class="sk-line sk-num" />
            <span class="sk-line sk-num" />
          </li>
        ))}
      </ol>
      <div class="tk-split">
        <div>
          <h3 class="tk-label">Clients</h3>
          <ol class="tk-rows" data-list="client">
            {skeletonRows(4).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h3 class="tk-label">Providers</h3>
          <ol class="tk-rows" data-list="provider">
            {skeletonRows(4).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
    <section>
      <h2 id="devices">Devices</h2>
      <ol class="tk-devices">
        {skeletonRows(2).map(() => (
          <li class="tk-device" data-skeleton aria-hidden="true">
            <div class="dev-row">
              <span class="dot" />
              <span class="dev-id">
                <span class="sk-line" style="inline-size: 7em" />
                <span class="sk-line sk-sub" />
              </span>
              <span class="dev-usage">
                <span class="sk-line sk-num" />
                <span class="sk-line sk-sub" style="justify-self: end" />
              </span>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
  <p class="tk-fallback" hidden>
    Couldn’t load usage right now — the collector at
    <a href={endpoint} target="_blank" rel="noopener noreferrer"
      >tokens.lkwplus.com</a
    >
    may be napping. Try again in a minute.
  </p>
</tokens-dashboard>

<script>
  import { mountTokensDashboard } from "@/lib/client/tokens-dashboard"

  document
    .querySelectorAll<HTMLElement>("tokens-dashboard")
    .forEach((root) => mountTokensDashboard(root))
</script>

<style is:global>
  tokens-dashboard {
    /* Level-3 green of the shared heatmap palette (see Heatmap.astro). */
    --tk-accent: light-dark(#30a14e, #26a641);

    /* One height for the two instrument bars — the Today client pills
       and the quota meters. Thin enough that a bar reads as a reading
       rather than as a block of colour, and thick enough that the
       smallest segment still has a shape. It doubles as the minimum
       segment width, so a sliver lands as a dot rather than a hair. */
    --tk-meter: 0.375rem;

    /* Brand palette for stacked segments and chips. Client ids map onto
       their vendor's hue (see the [data-p] rules below). */
    --tk-p-anthropic: light-dark(#d97757, #cc785c);
    --tk-p-openai: light-dark(#10a37f, #2dc79f);
    --tk-p-google: light-dark(#4285f4, #7cacf8);
    --tk-p-alibaba: light-dark(#ff6a00, #ff8a3d);
    --tk-p-xai: light-dark(#52525b, #a1a1aa);
    --tk-p-cursor: light-dark(#8b5cf6, #a78bfa);
    --tk-p-deepseek: light-dark(#4d6bfe, #8ba0ff);
    --tk-p-meta: light-dark(#0866ff, #4d9fff);
    --tk-p-openrouter: light-dark(#6366f1, #818cf8);
    --tk-p-zed: light-dark(#084ccf, #7a9bff);
    --tk-p-opencode: light-dark(#78716c, #a8a29e);
    /* Nous ships a cream-on-black brand; a parchment tan keeps it apart
       from the zinc (xAI) and stone (OpenCode) neutrals. */
    --tk-p-hermes: light-dark(#8a7248, #cdb37e);
    /* Moonshot's brand near-black (#16191e), lifted for dark mode. */
    --tk-p-moonshot: light-dark(#16191e, #e4e4e7);
    /* Z.ai brands near-black like Moonshot; keep its Zhipu-heritage
       blue (deeper than Zed's azure) so the two stay apart in stacks. */
    --tk-p-zai: light-dark(#3859ff, #8da2ff);
    --tk-p-other: var(--gray-8);

    display: block;

    /* Everything below is nested here so the rules only ever apply
       inside the dashboard: the renderers build this DOM at runtime,
       which Astro's scoped styles cannot see. */
    section + section {
      margin-block-start: var(--space-l);
    }

    h2 {
      margin-block-end: var(--space-s);
      font-size: var(--step-1);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);

      @media (width >= 64rem) {
        scroll-margin-block-start: calc(var(--page-offset-top) - 0.2em);
      }
    }

    /* Activity: the heatmap is the picker, the day panel is what it
       picks, and the all-time cards sit under both. */

    /* Section heading with its freshness note on the same baseline. */
    .tk-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3xs) var(--space-s);
      margin-block-end: var(--space-s);
    }

    .tk-head h2 {
      margin-block-end: 0;
    }

    .tk-sync,
    .tk-day-empty {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    .tk-day {
      display: grid;
      gap: var(--space-2xs);
      margin-block-start: var(--space-m);
    }

    /* The picked day's name, with the way back to today at the far end —
       the one control the panel has, and only while it is needed. */
    .tk-day-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-s);
    }

    .tk-day-head .tk-label {
      margin-block: 0;
    }

    .tk-day-back {
      font-size: var(--step--1);
      color: var(--muted-foreground);
      cursor: pointer;
    }

    .tk-day-back:hover {
      color: var(--foreground);
    }

    .tk-day-back[hidden] {
      display: none;
    }

    .tk-day-body {
      display: grid;
      gap: var(--space-s);
    }

    /* A `display` of its own outranks the UA's [hidden] rule. */
    .tk-day-body[hidden] {
      display: none;
    }

    /* The bar and its legend are one unit: day.ts hides both on a day
       with activity but no tokens (active time or messages only), where
       there is nothing to apportion and an empty bar would read as a
       broken one. */
    .tk-day-breakdown[hidden] {
      display: none;
    }

    /* The legend under the client-mix bar is the day's client
       breakdown: the same brand-marked rows as the Breakdown section,
       each opened onto the models that client drove. The Breakdown
       section has no single-day window, so this is the only place the
       day's client → model join is readable — which is why the rows
       start open. */
    .tk-day-legend {
      margin-block-start: calc(-1 * var(--space-3xs));
    }

    /* Controls */

    .tk-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-2xs);
      margin-block-end: var(--space-s);
    }

    .tk-seg {
      display: inline-flex;
      gap: 2px;
      padding: 2px;
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
    }

    .tk-seg label {
      position: relative;
      display: inline-flex;
    }

    /* An option the loaded payload can't support (model stacking on a
       collector that predates the per-day model slices). */
    .tk-seg label[hidden] {
      display: none;
    }

    .tk-seg input {
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
    }

    .tk-seg span {
      padding: 0.125rem 0.625rem;
      border-radius: var(--radius-full);
      font-size: var(--step--1);
      color: var(--muted-foreground);
      cursor: pointer;
      user-select: none;
    }

    .tk-seg input:checked + span {
      background-color: var(--foreground);
      color: var(--background);
    }

    .tk-seg label:hover input:not(:checked) + span {
      color: var(--foreground);
    }

    .tk-seg input:focus-visible + span {
      outline: 2px solid var(--ring);
      outline-offset: 1px;
    }

    /* Compact variant for in-chart controls (the trend stack toggle). */
    .tk-seg-sm span {
      padding: 0.0625rem 0.5rem;
      font-size: 0.6875rem;
    }

    /* Stat cards */

    .tk-cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-s);
      margin: 0;

      @media (width < 40rem) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .tk-card {
      display: grid;
      gap: var(--space-3xs);
      align-content: start;
    }

    .tk-card dt {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    .tk-card .value {
      margin: 0;
      font-size: var(--step-2);
      font-weight: var(--font-weight-medium);
      font-variant-numeric: tabular-nums;
      line-height: 1.2;
    }

    .tk-facts .value {
      font-size: var(--step-1);
    }

    .tk-card .sub,
    .tk-card .delta {
      margin: 0;
      font-size: var(--step--1);
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    .tk-card .delta:empty {
      display: none;
    }

    .tk-card .delta .delta-val {
      color: var(--foreground);
    }

    /* Three proportions on this page, three forms. A composition
       (.tk-mix-composition) is one quantity cut into its parts, so it
       stays one solid block; a client mix (.tk-day-bar) is separate
       actors sharing a day, so its segments are separate pills; a quota
       window (.tk-meter) is a gauge against a ceiling, so it is a thin
       track with a rounded head. Sizing all three alike was what made a
       10%-spent week read as a stalled composition, and a day carried by
       one client read as a colour slab with hairlines at its end. */

    .tk-mix {
      display: grid;
      gap: var(--space-xs);
    }

    /* Composition: contiguous parts, shaded by the --c ramp below. */
    .tk-mix-bar {
      display: flex;
      block-size: 0.875rem;
      overflow: hidden;
      border-radius: var(--radius-full);
      background-color: var(--gray-4);
    }

    .tk-mix-bar span {
      min-inline-size: 3px;
      background-color: var(--c, var(--gray-6));
    }

    .tk-mix-bar span + span {
      border-inline-start: 2px solid var(--background);
    }

    /* Client mix: brand-keyed pills with real air between them. A day is
       usually carried by one client, and separate capsules let the tail
       read as its own small marks rather than as hairline cracks in a
       slab — which is also the honest shape, since these are different
       agents rather than parts of one number. */
    .tk-day-bar {
      display: flex;
      gap: 3px;
      block-size: var(--tk-meter);
      border-radius: var(--radius-full);
    }

    .tk-day-bar span {
      min-inline-size: var(--tk-meter);
      border-radius: var(--radius-full);
      background-color: var(--p);
      transition: opacity 0.15s ease;
    }

    /* Its legend leads with brand icons rather than color chips, so the
       bar is keyed on demand instead: hovering or focusing a client row
       mutes every segment but that client's (day.ts sets [data-mute]). */
    .tk-day-bar span[data-mute] {
      opacity: 0.25;
    }

    .tk-mix [data-k="0"] {
      --c: var(--foreground);
    }

    .tk-mix [data-k="1"] {
      --c: color-mix(in oklab, var(--foreground) 60%, var(--background));
    }

    .tk-mix [data-k="2"] {
      --c: var(--tk-accent);
    }

    .tk-mix [data-k="3"] {
      --c: color-mix(in oklab, var(--tk-accent) 50%, var(--background));
    }

    .tk-mix [data-k="4"] {
      --c: var(--gray-8);
    }

    /* One column per category, echoing the stat cards above:
       muted label, medium value, muted share. */
    .tk-mix-legend {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-xs) var(--space-s);
      font-size: var(--step--1);

      @media (width < 40rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .tk-mix-legend li {
      display: grid;
      gap: var(--space-3xs);
      align-content: start;
    }

    .tk-mix-legend .name {
      display: flex;
      align-items: center;
      gap: 0.4em;
      color: var(--muted-foreground);
    }

    .tk-mix-legend .chip {
      flex-shrink: 0;
      inline-size: 0.625rem;
      block-size: 0.625rem;
      border-radius: var(--radius-xs);
      background-color: var(--c, var(--gray-6));
    }

    .tk-mix-legend .value {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      font-variant-numeric: tabular-nums;
      line-height: 1.2;
    }

    .tk-mix-legend .share {
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    .tk-mix-legend .sk-line {
      max-inline-size: 100%;
    }

    /* Quota — the one reported section, so everything here is built to
       admit its own age (see tokens-dashboard/quota.ts). */

    .tk-quota-section[hidden] {
      display: none;
    }

    /* Everything below .tk-plans is built by the renderer, so it is
       addressed through :global — only the list itself is in this
       template. The skeleton in the markup carries the same class names
       so it lands in the same geometry.

       Side by side once there is room, like the Breakdown split: the
       subscriptions are peers being compared, not a sequence to read. */
    .tk-plans {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-m);

      @media (width >= 40rem) {
        grid-template-columns: 1fr 1fr;
      }
    }

    /* Name, windows and credits are three levels of the same statement,
       so they sit further apart than the lines inside a window do. */
    .tk-plans .tk-plan {
      display: grid;
      gap: var(--space-s);
      align-content: start;
    }

    /* Mark, name and tier read as one phrase on one line — "Codex · Team"
       — so the row never wraps and the mark sits on the text's centre
       rather than its baseline. The age is pushed to the far end. */
    .tk-plans .plan-head {
      display: flex;
      align-items: center;
      gap: 0.4em;
    }

    .tk-plans .plan-age {
      margin-inline-start: auto;
      padding-inline-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    /* Past the staleness threshold the age is the headline, not a
       footnote: this card's numbers may describe a window that ended. */
    .tk-plans .plan-age[data-stale] {
      color: var(--destructive);
    }

    .tk-plans .plan-name {
      font-weight: var(--font-weight-medium);
    }

    .tk-plans .plan-head .ico {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      inline-size: 1.1em;
      block-size: 1.1em;
    }

    .tk-plans .plan-head .ico svg {
      inline-size: 100%;
      block-size: 100%;
    }

    .tk-plans .plan-tier {
      color: var(--muted-foreground);
      white-space: nowrap;
    }

    /* Three nested gaps that have to stay in that order, or the grouping
       inverts: the lines of a window sit closer than two windows do, and
       two windows closer than a plan's head, windows and credits. */
    .tk-plans .tk-windows {
      display: grid;
      gap: var(--space-xs);
    }

    .tk-plans .tk-window {
      display: grid;
      gap: var(--space-2xs);
    }

    /* Label and figure share a baseline, like a stat card turned on its
       side, with the meter reading underneath them. */
    .tk-plans .win-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-s);
    }

    .tk-plans .win-label {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    .tk-plans .win-used {
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      font-variant-numeric: tabular-nums;
      line-height: 1.2;
    }

    /* A window past its reset has no figure to give: the dash stands in
       for it at the same size, so the row keeps its baseline, but at the
       label's weight and colour — it is the absence of a reading, not a
       reading. Its track stays empty (quota.ts draws no head). */
    .tk-plans .tk-window[data-reset] .win-used {
      font-weight: inherit;
      color: var(--muted-foreground);
    }

    /* A quota window is a gauge against a ceiling, not a share of a whole,
       so it gets a gauge: a thin track carrying one rounded head, with a
       floor under the head's width so a barely-touched week still shows
       that it was touched. The track is a wash of the same hue as the
       head — the vendor's own — so an empty window still says whose
       ceiling it measures, and the ceiling itself stays visible at a
       glance instead of being implied by an unfilled remainder. */
    .tk-plans .tk-meter {
      block-size: var(--tk-meter);
      border-radius: var(--radius-full);
      background-color: var(--gray-4);
    }

    .tk-plans .tk-meter[data-p] {
      background-color: color-mix(in oklab, var(--p) 22%, var(--gray-3));
    }

    .tk-plans .tk-meter span {
      display: block;
      block-size: 100%;
      min-inline-size: var(--tk-meter);
      border-radius: inherit;
      background-color: var(--p, var(--gray-8));
    }

    .tk-plans .win-foot,
    .tk-plans .plan-credits {
      font-size: var(--step--1);
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    /* Each credit expires on its own date, so they are a list under a
       count rather than one summarised line. */
    .tk-plans .plan-credits {
      display: grid;
      gap: var(--space-3xs);
    }

    .tk-plans .credits-list {
      display: grid;
      gap: var(--space-3xs);
    }

    .tk-plans .credits-list li {
      /* Aligned under the count, marked by the same rail the breakdown
         rows use rather than by a bullet glyph. */
      padding-inline-start: var(--space-xs);
      border-inline-start: 1px solid var(--gray-4);
    }

    /* The brand hue says which subscription is being measured; red is
       reserved for the one case where the reading is a warning rather
       than a measurement. It is swapped in as --p, so the track's wash
       turns with the head — a red head on a coral wash would read as two
       subjects in one gauge. */
    .tk-plans .tk-meter[data-high] {
      --p: var(--red-9);
    }

    /* Trend chart */

    .tk-chart-head {
      display: flex;
      justify-content: space-between;
      gap: var(--space-s);
      margin-block-end: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    .tk-chart-peak,
    .tk-rhythm-peak {
      font-variant-numeric: tabular-nums;
    }

    .tk-chart-bars {
      display: flex;
      align-items: flex-end;
      gap: 2px;
      block-size: clamp(8rem, 24vw, 11rem);
      border-block-end: 1px solid var(--border);
      background-image: repeating-linear-gradient(
        to top,
        color-mix(in oklab, var(--border) 55%, transparent) 0 1px,
        transparent 1px 25%
      );
    }

    .tk-chart-bars span {
      display: flex;
      /* First stack segment (largest provider) sits at the bottom. */
      flex-direction: column-reverse;
      flex: 1 1 0;
      min-inline-size: 0;
      block-size: max(2px, calc(var(--v) * 100%));
      overflow: hidden;
      border-radius: var(--radius-xs) var(--radius-xs) 0 0;
    }

    .tk-chart-bars span:hover {
      filter: brightness(1.12);
    }

    .tk-chart-bars span[data-zero] {
      background-color: var(--gray-6);
    }

    .tk-chart-bars i {
      flex-basis: 0;
    }

    .tk-chart {
      position: relative;
    }

    .tk-tip {
      position: absolute;
      inset-block-start: var(--space-3xs);
      z-index: 5;
      display: grid;
      gap: var(--space-3xs);
      max-inline-size: min(18rem, 100%);
      padding: var(--space-2xs) var(--space-xs);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background-color: color-mix(in oklab, var(--background) 92%, transparent);
      backdrop-filter: blur(var(--blur-sm));
      font-size: var(--step--1);
      pointer-events: none;
    }

    .tk-tip .tip-title {
      font-weight: var(--font-weight-medium);
    }

    .tk-tip .tip-total {
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    .tk-chart > .tk-tip {
      inline-size: min(22rem, 100%);
      max-inline-size: 100%;
      box-sizing: border-box;
      line-height: 1.5;
      background-color: var(--background);
    }

    .tk-tip .tip-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.125rem 0.75rem;
      font-variant-numeric: tabular-nums;
    }

    .tk-tip .tip-summary > span {
      white-space: nowrap;
    }

    .tk-tip .tip-intensity {
      color: var(--muted-foreground);
    }

    .tk-tip ul {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) max-content max-content;
      align-items: baseline;
      gap: 0.375rem 0.5rem;
      margin-block-start: var(--space-3xs);
      padding-block-start: var(--space-2xs);
      border-block-start: 1px solid var(--border);
    }

    .tk-tip li {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      align-items: baseline;
      font-variant-numeric: tabular-nums;
    }

    .tk-tip .tip-label {
      overflow-wrap: anywhere;
      text-wrap: pretty;
    }

    .tk-tip .tip-value,
    .tk-tip .tip-share {
      text-align: end;
      white-space: nowrap;
    }

    .tk-tip .tip-share {
      color: var(--muted-foreground);
    }

    .tk-tip .chip {
      flex-shrink: 0;
      inline-size: 0.625rem;
      block-size: 0.625rem;
      border-radius: var(--radius-xs);
    }

    .tk-chart-axis {
      display: flex;
      justify-content: space-between;
      margin-block-start: var(--space-3xs);
      font-size: 0.6875rem;
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    .tk-chart-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3xs) var(--space-s);
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    .tk-chart-legend {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3xs) var(--space-s);
    }

    .tk-chart-legend li {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
    }

    .tk-chart-legend .chip {
      inline-size: 0.625rem;
      block-size: 0.625rem;
      border-radius: var(--radius-xs);
    }

    /* Weekly rhythm line chart */

    .tk-rhythm {
      position: relative;
    }

    .tk-rhythm-plot {
      block-size: clamp(6.5rem, 18vw, 8.5rem);
      border-block-end: 1px solid var(--border);
    }

    .tk-rhythm-plot svg {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      overflow: visible;
    }

    .tk-rhythm-plot .grid {
      stroke: color-mix(in oklab, var(--border) 55%, transparent);
      stroke-width: 1;
      shape-rendering: crispedges;
    }

    .tk-rhythm-plot .area {
      fill: color-mix(in oklab, var(--tk-accent) 12%, transparent);
    }

    .tk-rhythm-plot .line {
      fill: none;
      stroke: var(--tk-accent);
      stroke-width: 1.5;
      stroke-linejoin: round;
      stroke-linecap: round;
    }

    .tk-rhythm-plot .dot {
      fill: var(--tk-accent);
      stroke: var(--background);
      stroke-width: 1.5;
    }

    .tk-rhythm-plot .dot[data-peak] {
      stroke: color-mix(in oklab, var(--tk-accent) 35%, var(--background));
      stroke-width: 2.5;
    }

    .tk-rhythm-plot .hit {
      fill: transparent;
    }

    .tk-rhythm-axis {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      margin-block-start: var(--space-3xs);
      font-size: 0.6875rem;
      color: var(--muted-foreground);
      text-align: center;
    }

    .tk-rhythm-plot[data-skeleton] {
      border-radius: var(--radius-sm);
      background-color: var(--gray-5);
      animation: var(--sk-pulse);
    }

    /* Brand palette, applied through --p to bar segments and chips.
       Clients take their vendor's hue — Claude Code renders Anthropic
       coral, Codex the OpenAI green — so both stackings of the same data
       read in one color language. Keep the bare [data-p] fallback first:
       the named rules below must win. */
    [data-p] {
      --p: var(--tk-p-other);

      background-color: var(--p);
    }

    [data-p="anthropic"],
    [data-p="claude"] {
      --p: var(--tk-p-anthropic);
    }

    [data-p="openai"],
    [data-p="codex"] {
      --p: var(--tk-p-openai);
    }

    [data-p="google"],
    [data-p="gemini"] {
      --p: var(--tk-p-google);
    }

    [data-p="alibaba"],
    [data-p="qwen"] {
      --p: var(--tk-p-alibaba);
    }

    [data-p="xai"],
    [data-p="grok"] {
      --p: var(--tk-p-xai);
    }

    [data-p="cursor"] {
      --p: var(--tk-p-cursor);
    }

    [data-p="zed"],
    [data-p="zed.dev"] {
      --p: var(--tk-p-zed);
    }

    [data-p="opencode"] {
      --p: var(--tk-p-opencode);
    }

    [data-p="hermes"] {
      --p: var(--tk-p-hermes);
    }

    [data-p="moonshotai"] {
      --p: var(--tk-p-moonshot);
    }

    [data-p="zai"] {
      --p: var(--tk-p-zai);
    }

    [data-p="deepseek"] {
      --p: var(--tk-p-deepseek);
    }

    [data-p="meta"] {
      --p: var(--tk-p-meta);
    }

    [data-p="openrouter"] {
      --p: var(--tk-p-openrouter);
    }

    /* Kimi is Moonshot's model line: same vendor, same hue. */
    [data-p="kimi"] {
      --p: var(--tk-p-moonshot);
    }

    /* Shades of a brand hue, for stacking the trend chart by model: the
       vendor decides the color and the shade separates its models within
       it, assigned in stack order, so "everything Anthropic" still reads
       as one family. Model ids are 40-odd and growing — a rule per model
       would be a maintenance queue, and an unmapped one would fall back to
       grey. Must follow the [data-p] rules above: same specificity, and
       these override the flat background-color they set. */
    [data-shade="1"] {
      background-color: color-mix(in oklab, var(--p) 78%, var(--background));
    }

    [data-shade="2"] {
      background-color: color-mix(in oklab, var(--p) 58%, var(--background));
    }

    [data-shade="3"] {
      background-color: color-mix(in oklab, var(--p) 40%, var(--background));
    }

    /* Breakdown lists */

    .tk-rows {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }

    .tk-rows .tk-row {
      position: relative;
      /* Isolate the row so the fill can slot between its background and
         its content via z-index: -1. */
      z-index: 0;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) max-content 3.2rem;
      align-items: center;
      gap: var(--space-2xs);
      padding-block: var(--space-3xs);
      font-size: var(--step--1);
    }

    /* Proportional fill behind each row — its share of the range total,
       sized by the --w custom property the script sets. Soft-cornered
       rectangle, the site's shape for data marks (heatmap cells, trend
       bars, chips); tiny shares taper to a hairline rather than getting
       a forced minimum width. */
    .tk-rows .tk-row:not([data-skeleton])::before {
      content: "";
      position: absolute;
      inset-block: 2px;
      inset-inline-start: 0;
      z-index: -1;
      inline-size: calc(var(--w, 0) * 100%);
      border-radius: var(--radius-xs);
      background-color: color-mix(in oklab, var(--gray-5) 55%, transparent);
    }

    .tk-rows .ico {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: 1.1em;
      block-size: 1.1em;
    }

    .tk-rows .ico svg {
      inline-size: 100%;
      block-size: 100%;
    }

    .tk-rows .name {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .tk-rows .val {
      justify-self: end;
      font-variant-numeric: tabular-nums;
    }

    .tk-rows .share {
      justify-self: end;
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    .tk-empty {
      padding-block: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    /* A row that opens onto the models behind it. The row itself is
       the button — the whole width is the hit target, and it keeps the
       four-column grid, so an expandable row and a plain one still line
       up. The chevron rides inside the name cell. */
    .tk-rows .tk-row-toggle {
      inline-size: 100%;
      text-align: start;
      cursor: pointer;
    }

    .tk-rows .tk-row-toggle .name {
      display: flex;
      align-items: center;
      gap: 0.3em;
      min-inline-size: 0;
    }

    /* The label keeps its own box so a long model name still ellipsises
       against the value column instead of shoving the chevron out. */
    .tk-rows .tk-row-toggle .name > span {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .tk-rows .tk-row-toggle .name svg {
      flex-shrink: 0;
      inline-size: 0.85em;
      block-size: 0.85em;
      color: var(--muted-foreground);
      transition: rotate 0.15s;
    }

    .tk-rows .tk-row-toggle[aria-expanded="true"] .name svg {
      rotate: 180deg;
    }

    .tk-rows .tk-row-toggle:hover .name svg {
      color: var(--foreground);
    }

    /* The models under a client or vendor: same row grid, indented and quieter, so
       the parent still reads as the total they add up to. */
    .tk-rows .tk-sub {
      margin-inline-start: calc(1.1em + var(--space-2xs));
    }

    .tk-rows .tk-sub .tk-row {
      color: var(--muted-foreground);
    }

    .tk-rows .tk-sub .name {
      color: var(--foreground);
    }

    .tk-rows .tk-more {
      margin-block-start: var(--space-3xs);
    }

    .tk-rows .tk-more-btn {
      display: flex;
      align-items: center;
      gap: 0.4em;
      inline-size: 100%;
      padding-block: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
      cursor: pointer;
    }

    .tk-rows .tk-more-btn:hover {
      color: var(--foreground);
    }

    .tk-rows .tk-more-btn svg {
      inline-size: 1em;
      block-size: 1em;
      transition: rotate 0.15s;
    }

    .tk-rows .tk-more-btn[aria-expanded="true"] svg {
      rotate: 180deg;
    }

    .tk-rows .more-amount {
      margin-inline-start: auto;
      font-variant-numeric: tabular-nums;
    }

    .tk-split {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-s);
      /* The models list (and its expand button) sits right above; keep the
         same rhythm a .tk-label would bring. */
      margin-block-start: var(--space-m);

      @media (width >= 40rem) {
        grid-template-columns: 1fr 1fr;
        gap: var(--space-m);
      }
    }

    .tk-split .tk-label:first-child {
      margin-block-start: 0;
    }

    /* Devices */

    .tk-devices {
      display: flex;
      flex-direction: column;
    }

    .tk-devices .tk-device + .tk-device {
      border-block-start: 1px solid var(--border);
    }

    /* The row is a button wherever there is CLI metadata to expand into;
       the fourth column holds the chevron and collapses to nothing on the
       plain <div> variant. */
    .tk-devices .dev-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      align-items: center;
      gap: var(--space-2xs);
      inline-size: 100%;
      padding-block: var(--space-2xs);
      text-align: start;
    }

    .tk-devices button.dev-row {
      cursor: pointer;
    }

    /* Hover brightens the chevron rather than underlining the name — the
       same affordance the expandable client rows use, and a device name
       is not a link. */
    .tk-devices button.dev-row:hover svg {
      color: var(--foreground);
    }

    .tk-devices button.dev-row:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
      border-radius: var(--radius-sm);
    }

    .tk-devices .dev-row svg {
      inline-size: 1em;
      block-size: 1em;
      color: var(--muted-foreground);
      transition: rotate 0.15s;
    }

    .tk-devices .dev-row[aria-expanded="true"] svg {
      rotate: 180deg;
    }

    /* Two columns of label/value pairs, indented past the liveness dot so
       they read as belonging to the row above. */
    .tk-devices .dev-details {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3xs) var(--space-s);
      margin-inline-start: calc(0.5rem + var(--space-2xs));
      padding-block-end: var(--space-2xs);
      font-size: var(--step--1);

      @media (width < 30rem) {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .tk-devices .dev-details > div {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4em;
    }

    .tk-devices .dev-details dt {
      color: var(--muted-foreground);
    }

    .tk-devices .dev-details dd {
      margin: 0;
      font-variant-numeric: tabular-nums;
      overflow-wrap: anywhere;
    }

    .tk-devices .dot {
      inline-size: 0.5rem;
      block-size: 0.5rem;
      border-radius: var(--radius-full);
      background-color: var(--gray-7);
    }

    .tk-devices .dot[data-online] {
      background-color: var(--tk-accent);
      box-shadow: 0 0 0 3px
        color-mix(in oklab, var(--tk-accent) 25%, transparent);
    }

    .tk-devices .dev-id {
      display: grid;
      gap: var(--space-3xs);
    }

    .tk-devices .dev-name {
      overflow: hidden;
      font-weight: var(--font-weight-medium);
      line-height: 1.25;
      white-space: nowrap;
      text-overflow: ellipsis;
