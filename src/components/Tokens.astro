---
import type { SvgComponent } from "astro/types"
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import Heatmap from "@/components/Heatmap.astro"
import Alibaba from "@/assets/icons/ai/alibaba.svg"
import Anthropic from "@/assets/icons/ai/anthropic.svg"
import Claude from "@/assets/icons/ai/claude.svg"
import ClaudeCode from "@/assets/icons/ai/claudecode.svg"
import Codex from "@/assets/icons/ai/codex.svg"
import Cursor from "@/assets/icons/ai/cursor.svg"
import DeepSeek from "@/assets/icons/ai/deepseek.svg"
import Gemini from "@/assets/icons/ai/gemini.svg"
import Google from "@/assets/icons/ai/google.svg"
import Grok from "@/assets/icons/ai/grok.svg"
import HermesAgent from "@/assets/icons/ai/hermesagent.svg"
import Kimi from "@/assets/icons/ai/kimi.svg"
import Moonshot from "@/assets/icons/ai/moonshot.svg"
import OpenAI from "@/assets/icons/ai/openai.svg"
import OpenCode from "@/assets/icons/ai/opencode.svg"
import Pi from "@/assets/icons/ai/pi.svg"
import Qwen from "@/assets/icons/ai/qwen.svg"
import XAI from "@/assets/icons/ai/xai.svg"
import Zai from "@/assets/icons/ai/zai.svg"
import Zed from "@/assets/icons/ai/zed.svg"
import { TOKENS } from "@/consts"
import { COMPOSITION, RANGES } from "@/lib/client/tokens"

type Props = {
  endpoint?: string
}

const { endpoint = TOKENS.endpoint } = Astro.props

/** Mono brand SVGs, vendored from Lobe Icons (https://lobehub.com/icons)
 *  except zed.svg (official Zed mark, normalized to currentColor). The
 *  hidden defs block below is what the runtime script clones from. */
const AI_ICONS: Record<string, SvgComponent> = {
  alibaba: Alibaba,
  anthropic: Anthropic,
  claude: Claude,
  claudecode: ClaudeCode,
  codex: Codex,
  cursor: Cursor,
  deepseek: DeepSeek,
  gemini: Gemini,
  google: Google,
  grok: Grok,
  hermesagent: HermesAgent,
  kimi: Kimi,
  moonshot: Moonshot,
  openai: OpenAI,
  opencode: OpenCode,
  pi: Pi,
  qwen: Qwen,
  xai: XAI,
  zai: Zai,
  zed: Zed,
}

const todayCards = [
  { key: "tokens", label: "Tokens" },
  { key: "cost", label: "Cost" },
  { key: "messages", label: "Messages" },
  { key: "activeTime", label: "Active time" },
]

const overviewCards = [
  { key: "tokens", label: "Tokens" },
  { key: "cost", label: "Cost" },
  { key: "messages", label: "Messages" },
  { key: "activeDays", label: "Active days" },
]

/** Dimensions the trend chart stacks by. */
const stackOptions = [
  { key: "provider", label: "By provider" },
  { key: "client", label: "By client" },
  { key: "model", label: "By model" },
]

const factCards = [
  { key: "biggest", label: "Biggest day" },
  { key: "busiest", label: "Busiest week" },
  { key: "median", label: "Typical day" },
  { key: "weekday", label: "Top weekday" },
  { key: "longest", label: "Longest streak" },
  { key: "current", label: "Current streak" },
  { key: "models", label: "Models tried" },
  { key: "activeTime", label: "Active time" },
]

const skeletonRows = (count: number) =>
  Array.from({ length: count }, (_, i) => i)
---

<tokens-dashboard data-endpoint={endpoint} aria-busy="true">
  <div class="tk-icon-defs" hidden aria-hidden="true">
    {Object.entries(AI_ICONS).map(([name, Icon]) => (
      <span data-icon={name}><Icon /></span>
    ))}
    <span data-icon="chevron"><ChevronIcon /></span>
  </div>
  <p class="tk-intro">
    Token usage across my AI coding agents, live from my
    <a href={endpoint} target="_blank" rel="noopener noreferrer"
      >self-hosted collector</a
    >.
  </p>
  <div class="tk-body">
    <section>
      <div class="tk-head">
        <h2 id="today">Today</h2>
        <p class="tk-today-meta">
          <span class="sk-line sk-sub" aria-hidden="true" />
        </p>
      </div>
      <div class="tk-today-body">
        <dl class="tk-cards" data-cards="today">
          {todayCards.map(({ key, label }) => (
            <div class="tk-card" data-key={key}>
              <dt>{label}</dt>
              <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
              <dd class="delta"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
            </div>
          ))}
        </dl>
        <div class="tk-today-breakdown">
          <h3 class="tk-label">Clients</h3>
          <div class="tk-mix">
            <div class="tk-mix-bar tk-today-bar" data-skeleton></div>
            <ul class="tk-rows tk-today-legend"></ul>
          </div>
          <h3 class="tk-label">Models</h3>
          <ol class="tk-rows" data-list="today-model">
            {skeletonRows(3).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(11em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
      </div>
      <p class="tk-today-empty" hidden>Zero-byte kind of day.</p>
    </section>
    <section>
      <h2 id="overview">Overview</h2>
      <form class="tk-controls">
        <fieldset class="tk-seg" aria-label="Time range">
          {RANGES.map((range) => (
            <label>
              <input
                type="radio"
                name="range"
                value={range.key}
                checked={range.key === "month"}
              />
              <span>{range.label}</span>
            </label>
          ))}
        </fieldset>
        <fieldset class="tk-seg" aria-label="Metric">
          <label>
            <input type="radio" name="metric" value="tokens" checked>
            <span>Tokens</span>
          </label>
          <label>
            <input type="radio" name="metric" value="cost">
            <span>Cost</span>
          </label>
        </fieldset>
      </form>
      <dl class="tk-cards" data-cards="overview">
        {overviewCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="sub"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
            <dd class="delta"><span class="sk-line sk-sub" style="inline-size: 5em" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
      <h3 class="tk-label">Token composition</h3>
      <div class="tk-mix">
        <div class="tk-mix-bar tk-mix-composition" data-skeleton></div>
        <ul class="tk-mix-legend">
          {COMPOSITION.map(({ key, label }, i) => (
            <li data-key={key}>
              <span class="name">
                <span class="chip" data-k={i} aria-hidden="true" />
                {label}
              </span>
              <span class="value"><span class="sk-line sk-stat" aria-hidden="true" /></span>
              <span class="share"><span class="sk-line sk-sub" style="inline-size: 3em" aria-hidden="true" /></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section>
      <h2 id="trend">Trend</h2>
      <div class="tk-chart-head">
        <p class="tk-chart-scope">Daily tokens</p>
        <p class="tk-chart-peak"></p>
      </div>
      <div class="tk-chart" role="img" aria-label="Token usage over time">
        <div class="tk-chart-bars" data-skeleton></div>
        <div class="tk-chart-axis" aria-hidden="true"></div>
        <div class="tk-tip" hidden></div>
      </div>
      <div class="tk-chart-foot">
        <fieldset class="tk-seg tk-seg-sm" aria-label="Stack trend bars by">
          {stackOptions.map(({ key, label }) => (
            <label data-stack={key}>
              <input
                type="radio"
                name="stack"
                value={key}
                checked={key === "provider"}
              />
              <span>{label}</span>
            </label>
          ))}
        </fieldset>
        <ul class="tk-chart-legend" aria-hidden="true"></ul>
      </div>
      <h3 class="tk-label">Weekly rhythm</h3>
      <div class="tk-chart-head">
        <p class="tk-rhythm-scope">Weekday tokens</p>
        <p class="tk-rhythm-peak"></p>
      </div>
      <div
        class="tk-rhythm"
        role="img"
        aria-label="Average token usage by weekday"
      >
        <div class="tk-rhythm-plot" data-skeleton></div>
        <div class="tk-rhythm-axis" aria-hidden="true">
          {["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map((day) => (
            <span>{day}</span>
          ))}
        </div>
        <div class="tk-tip" hidden></div>
      </div>
    </section>
    <section>
      <h2 id="activity">Activity</h2>
      <Heatmap />
      <h3 class="tk-label">All-time patterns</h3>
      <dl class="tk-cards tk-facts" data-cards="facts">
        {factCards.map(({ key, label }) => (
          <div class="tk-card" data-key={key}>
            <dt>{label}</dt>
            <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
            <dd class="sub"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
          </div>
        ))}
      </dl>
    </section>
    <section>
      <h2 id="breakdown">Breakdown</h2>
      <h3 class="tk-label">Models</h3>
      <ol class="tk-rows" data-list="model">
        {skeletonRows(6).map(() => (
          <li class="tk-row" data-skeleton aria-hidden="true">
            <span class="ico sk-ico" />
            <span class="sk-line" style="inline-size: min(11em, 70%)" />
            <span class="sk-line sk-num" />
            <span class="sk-line sk-num" />
          </li>
        ))}
      </ol>
      <div class="tk-split">
        <div>
          <h3 class="tk-label">Clients</h3>
          <ol class="tk-rows" data-list="client">
            {skeletonRows(4).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h3 class="tk-label">Providers</h3>
          <ol class="tk-rows" data-list="provider">
            {skeletonRows(4).map(() => (
              <li class="tk-row" data-skeleton aria-hidden="true">
                <span class="ico sk-ico" />
                <span class="sk-line" style="inline-size: min(6em, 70%)" />
                <span class="sk-line sk-num" />
                <span class="sk-line sk-num" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
    <section>
      <h2 id="devices">Devices</h2>
      <ol class="tk-devices">
        {skeletonRows(2).map(() => (
          <li class="tk-device" data-skeleton aria-hidden="true">
            <div class="dev-row">
              <span class="dot" />
              <span class="dev-id">
                <span class="sk-line" style="inline-size: 7em" />
                <span class="sk-line sk-sub" />
              </span>
              <span class="dev-usage">
                <span class="sk-line sk-num" />
                <span class="sk-line sk-sub" style="justify-self: end" />
              </span>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
  <p class="tk-fallback" hidden>
    Couldn’t load usage right now — the collector at
    <a href={endpoint} target="_blank" rel="noopener noreferrer"
      >tokens.lkwplus.com</a
    >
    may be napping. Try again in a minute.
  </p>
</tokens-dashboard>

<script>
  import { mountTokensDashboard } from "@/lib/client/tokens-dashboard"

  document
    .querySelectorAll<HTMLElement>("tokens-dashboard")
    .forEach((root) => mountTokensDashboard(root))
</script>

<style>
  tokens-dashboard {
    /* Level-3 green of the shared heatmap palette (see Heatmap.astro). */
    --tk-accent: light-dark(#30a14e, #26a641);

    /* Brand palette for stacked segments and chips. Client ids map onto
       their vendor's hue (see the [data-p] rules below). */
    --tk-p-anthropic: light-dark(#d97757, #cc785c);
    --tk-p-openai: light-dark(#10a37f, #2dc79f);
    --tk-p-google: light-dark(#4285f4, #7cacf8);
    --tk-p-alibaba: light-dark(#ff6a00, #ff8a3d);
    --tk-p-xai: light-dark(#52525b, #a1a1aa);
    --tk-p-cursor: light-dark(#8b5cf6, #a78bfa);
    --tk-p-deepseek: light-dark(#4d6bfe, #8ba0ff);
    --tk-p-zed: light-dark(#084ccf, #7a9bff);
    --tk-p-opencode: light-dark(#78716c, #a8a29e);
    /* Nous ships a cream-on-black brand; a parchment tan keeps it apart
       from the zinc (xAI) and stone (OpenCode) neutrals. */
    --tk-p-hermes: light-dark(#8a7248, #cdb37e);
    /* Moonshot's brand near-black (#16191e), lifted for dark mode. */
    --tk-p-moonshot: light-dark(#16191e, #e4e4e7);
    /* Z.ai brands near-black like Moonshot; keep its Zhipu-heritage
       blue (deeper than Zed's azure) so the two stay apart in stacks. */
    --tk-p-zai: light-dark(#3859ff, #8da2ff);
    --tk-p-other: var(--gray-8);

    display: block;
  }

  section + section {
    margin-block-start: var(--space-l);
  }

  h2 {
    margin-block-end: var(--space-s);
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);

    @media (width >= 64rem) {
      scroll-margin-block-start: calc(var(--page-offset-top) - 0.2em);
    }
  }

  .tk-intro {
    margin-block-end: var(--space-m);
    color: var(--muted-foreground);
  }

  .tk-fallback {
    color: var(--muted-foreground);
  }

  .tk-intro a,
  .tk-fallback a {
    color: var(--foreground);
    text-decoration: underline;
  }

  .tk-label {
    margin-block: var(--space-m) var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  /* Today */

  /* Section heading with its freshness note on the same baseline. */
  .tk-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
    margin-block-end: var(--space-s);
  }

  .tk-head h2 {
    margin-block-end: 0;
  }

  .tk-today-meta,
  .tk-today-empty {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  /* The clients bar and the model list are one unit: today.ts hides
     both on a day that has activity but no tokens yet (active time or
     messages only), where there is nothing to apportion and an empty
     bar would read as a broken one. */
  .tk-today-breakdown[hidden] {
    display: none;
  }

  /* The legend under the client-mix bar is the client breakdown: the
     same brand-marked rows as the Breakdown section, each opening onto
     the models that client drove. The Breakdown section has no today
     window of its own, so this is where the day's client → model join
     is readable. */
  .tk-today-legend {
    margin-block-start: calc(-1 * var(--space-3xs));
  }

  /* Controls */

  .tk-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin-block-end: var(--space-s);
  }

  .tk-seg {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  .tk-seg label {
    position: relative;
    display: inline-flex;
  }

  /* An option the loaded payload can't support (model stacking on a
     collector that predates the per-day model slices). */
  .tk-seg label[hidden] {
    display: none;
  }

  .tk-seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .tk-seg span {
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    color: var(--muted-foreground);
    cursor: pointer;
    user-select: none;
  }

  .tk-seg input:checked + span {
    background-color: var(--foreground);
    color: var(--background);
  }

  .tk-seg label:hover input:not(:checked) + span {
    color: var(--foreground);
  }

  .tk-seg input:focus-visible + span {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }

  /* Compact variant for in-chart controls (the trend stack toggle). */
  .tk-seg-sm span {
    padding: 0.0625rem 0.5rem;
    font-size: 0.6875rem;
  }

  /* Stat cards */

  .tk-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-s);
    margin: 0;

    @media (width < 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tk-cards.tk-facts {
    grid-template-columns: repeat(4, 1fr);

    @media (width < 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .tk-card {
    display: grid;
    gap: var(--space-3xs);
    align-content: start;
  }

  .tk-card dt {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .tk-card .value {
    margin: 0;
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .tk-facts .value {
    font-size: var(--step-1);
  }

  .tk-card .sub,
  .tk-card .delta {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .tk-card .delta:empty {
    display: none;
  }

  .tk-card .delta :global(.delta-val) {
    color: var(--foreground);
  }

  /* Share bars — geometry only, shared by the Overview token
     composition (.tk-mix-composition, shaded by --c) and the Today
     client mix (.tk-today-bar, brand-keyed by [data-p]); those hook
     classes are also what the renderers query, so neither section can
     pick up the other's bar. */

  .tk-mix {
    display: grid;
    gap: var(--space-xs);
  }

  .tk-mix-bar {
    display: flex;
    block-size: 0.875rem;
    overflow: hidden;
    border-radius: var(--radius-full);
    background-color: var(--gray-4);
  }

  .tk-mix-bar :global(span) {
    min-inline-size: 3px;
    background-color: var(--c, var(--gray-6));
  }

  .tk-mix-bar :global(span + span) {
    border-inline-start: 2px solid var(--background);
  }

  /* Brand-keyed variant (the Today client mix): the [data-p] palette
     colors the segment instead of the --c shade ramp below. */
  .tk-mix-bar :global(span[data-p]) {
    background-color: var(--p);
  }

  /* Its legend leads with brand icons rather than color chips, so the
     bar is keyed on demand instead: hovering or focusing a client row
     mutes every segment but that client's (today.ts sets [data-mute]). */
  .tk-today-bar :global(span) {
    transition: opacity 0.15s ease;
  }

  .tk-today-bar :global(span[data-mute]) {
    opacity: 0.25;
  }

  .tk-mix :global([data-k="0"]) {
    --c: var(--foreground);
  }

  .tk-mix :global([data-k="1"]) {
    --c: color-mix(in oklab, var(--foreground) 60%, var(--background));
  }

  .tk-mix :global([data-k="2"]) {
    --c: var(--tk-accent);
  }

  .tk-mix :global([data-k="3"]) {
    --c: color-mix(in oklab, var(--tk-accent) 50%, var(--background));
  }

  .tk-mix :global([data-k="4"]) {
    --c: var(--gray-8);
  }

  /* One column per category, echoing the stat cards above:
     muted label, medium value, muted share. */
  .tk-mix-legend {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-xs) var(--space-s);
    font-size: var(--step--1);

    @media (width < 40rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .tk-mix-legend li {
    display: grid;
    gap: var(--space-3xs);
    align-content: start;
  }

  .tk-mix-legend .name {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--muted-foreground);
  }

  .tk-mix-legend .chip {
    flex-shrink: 0;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    border-radius: var(--radius-xs);
    background-color: var(--c, var(--gray-6));
  }

  .tk-mix-legend .value {
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .tk-mix-legend .share {
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .tk-mix-legend .sk-line {
    max-inline-size: 100%;
  }

  /* Trend chart */

  .tk-chart-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .tk-chart-peak,
  .tk-rhythm-peak {
    font-variant-numeric: tabular-nums;
  }

  .tk-chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    block-size: clamp(8rem, 24vw, 11rem);
    border-block-end: 1px solid var(--border);
    background-image: repeating-linear-gradient(
      to top,
      color-mix(in oklab, var(--border) 55%, transparent) 0 1px,
      transparent 1px 25%
    );
  }

  .tk-chart-bars :global(span) {
    display: flex;
    /* First stack segment (largest provider) sits at the bottom. */
    flex-direction: column-reverse;
    flex: 1 1 0;
    min-inline-size: 0;
    block-size: max(2px, calc(var(--v) * 100%));
    overflow: hidden;
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
  }

  .tk-chart-bars :global(span:hover) {
    filter: brightness(1.12);
  }

  .tk-chart-bars :global(span[data-zero]) {
    background-color: var(--gray-6);
  }

  .tk-chart-bars :global(i) {
    flex-basis: 0;
  }

  .tk-chart {
    position: relative;
  }

