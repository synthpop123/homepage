---
/**
 * GitHub-style activity heatmap shell: weekday labels, the cell grid
 * (skeleton until the parent feed's script fills it via mountHeatmap
 * from @/lib/client/heatmap), and the Less–More legend. Owns the shared
 * cell geometry for every heatmap on the site; the green scale is
 * color.css's --heat-*, which the accent comes from.
 *
 * `selectable` makes the grid a day picker: cells take a pointer cursor
 * and the grid takes focus, so the owning feed can read clicks and
 * arrow keys off it (Tokens). The selection itself is the feed's — it
 * marks the picked cell through mountHeatmap and says the pick in the
 * grid's status line, which only a screen reader hears.
 */

import "@/styles/feed.css"

type Props = { selectable?: boolean }

const { selectable = false } = Astro.props
---

<activity-heatmap>
  <div class="heat-frame">
    <div class="heat-days" aria-hidden="true">
      {["Mon", "Wed", "Fri", "Sun"].map((day) => <span>{day}</span>)}
    </div>
    <div
      class="heat-grid"
      data-skeleton
      data-pick={selectable ? "" : undefined}
      tabindex={selectable ? 0 : undefined}
      role={selectable ? "group" : undefined}
      aria-label={selectable
        ? "Activity by day. Arrow keys pick a day, Home returns to today."
        : undefined}
    ></div>
  </div>
  {selectable && <p class="heat-status sr" role="status"></p>}
  <div class="heat-scale" aria-hidden="true">
    <span>Less</span>
    {[0, 1, 2, 3, 4].map((level) => <i data-level={level} />)}
    <span>More</span>
  </div>
</activity-heatmap>

<style>
  activity-heatmap {
    /* Single source of truth for cell geometry — mountHeatmap in
       @/lib/client/heatmap reads these computed values to fit weeks. */
    --heat-cell: 12px;
    --heat-gap: 3px;

    display: block;
  }

  .heat-frame {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: start;
  }

  .heat-days {
    display: grid;
    grid-template-rows: repeat(7, var(--heat-cell));
    gap: var(--heat-gap);
    font-size: var(--step--2);
    line-height: 1;
    color: var(--muted-foreground);
  }

  .heat-days span {
    align-self: center;
  }

  .heat-days span:nth-child(2) {
    grid-row: 3;
  }

  .heat-days span:nth-child(3) {
    grid-row: 5;
  }

  .heat-days span:nth-child(4) {
    grid-row: 7;
  }

  .heat-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--heat-cell));
    grid-auto-columns: var(--heat-cell);
    gap: var(--heat-gap);
    min-block-size: calc(var(--heat-cell) * 7 + var(--heat-gap) * 6);
    /* Never let a transient misfit widen the page; the ResizeObserver
       in mountHeatmap re-fits the week count right after. */
    overflow: hidden;
  }

  .heat-grid[data-skeleton] {
    border-radius: var(--radius-sm);
    background-color: var(--neutral-4);
  }

  .heat-grid :global(span) {
    border-radius: var(--radius-xs);
  }

  .heat-grid :global(span[data-pad]) {
    visibility: hidden;
  }

  .heat-grid[data-pick] :global(span:not([data-pad])) {
    cursor: pointer;
  }

  .heat-grid[data-pick]:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
    border-radius: var(--radius-xs);
  }

  /* The ring is inset: the grid clips its overflow (see above), so an
     outline on an edge cell would be cut in half. */
  .heat-grid :global(span[data-selected]) {
    box-shadow: inset 0 0 0 1.5px var(--foreground);
  }

  .heat-scale {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--heat-gap);
    margin-block-start: var(--space-3xs);
    font-size: var(--step--2);
    color: var(--muted-foreground);
  }

  .heat-scale i {
    inline-size: 10px;
    block-size: 10px;
    border-radius: var(--radius-xs);
  }

  .heat-scale span:first-child {
    margin-inline-end: var(--space-3xs);
  }

  .heat-scale span:last-child {
    margin-inline-start: var(--space-3xs);
  }

  activity-heatmap :global([data-level="0"]) {
    background-color: var(--heat-0);
  }

  /* Level -1: activity happened but its size is unknown (e.g. token
     counts missing from early logs) — a hollow cell instead of a filled
     one, so it reads as "something, not nothing" without claiming an
     intensity. */
  activity-heatmap :global([data-level="-1"]) {
    background-color: var(--heat-0);
    box-shadow: inset 0 0 0 1.5px var(--heat-2);
  }

  activity-heatmap :global([data-level="1"]) {
    background-color: var(--heat-1);
  }

  activity-heatmap :global([data-level="2"]) {
    background-color: var(--heat-2);
  }

  activity-heatmap :global([data-level="3"]) {
    background-color: var(--heat-3);
  }

  activity-heatmap :global([data-level="4"]) {
    background-color: var(--heat-4);
  }
</style>
