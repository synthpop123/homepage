---
/**
 * The heading an index page opens with (Blog, Tags, Memos, Misc,
 * Tokens): the page's one h1, set large above whatever it lists. An
 * `aside` slot sits at the line's far end (Blog's link to its tags).
 */
---

<header>
  <h1><slot /></h1>
  <slot name="aside" />
</header>

<style>
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-m);

    > :global(a) {
      font-size: var(--step--1);
      color: var(--muted-foreground);
      text-decoration-line: none;

      &:hover {
        color: var(--foreground);
        text-decoration-line: underline;
      }
    }
  }

  h1 {
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--tracking-display);
  }
</style>
