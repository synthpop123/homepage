---
import Heatmap from "@/components/Heatmap.astro"
import { KOITO, MISC } from "@/consts"
import type { SiteStats } from "@/lib/client/music"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = MISC.endpoint, limit = KOITO.limit } = Astro.props
const instance = KOITO.instance

const stats: { key: keyof SiteStats; label: string }[] = [
  { key: "plays", label: "Plays" },
  { key: "tracks", label: "Tracks" },
  { key: "albums", label: "Albums" },
  { key: "artists", label: "Artists" },
  { key: "minutes", label: "Minutes" },
  { key: "daysActive", label: "Days active" },
  { key: "avgDailyPlays", label: "Avg. daily plays" },
  { key: "longestStreak", label: "Day streak" },
]
---

<p class="music-intro">
  Music I've been listening to, pulled live from my self-hosted
  <a href={instance} target="_blank" rel="noopener noreferrer">Koito</a>
  instance.
</p>
<music-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <div class="music-body">
    <h3 class="music-label">All-time stats</h3>
    <dl class="readout">
      {stats.map(({ key, label }) => (
        <div class="stat" data-key={key}>
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>
    <h3 class="music-label">Activity</h3>
    <Heatmap />
    <h3 class="music-label">Last played</h3>
    <ol class="music-list">
      {Array.from({ length: limit }).map((_, i) => (
        <li
          class="music-item"
          data-skeleton
          data-lead={i === 0 ? "" : undefined}
          aria-hidden="true"
        >
          <div class="music-link">
            <span class="cover" />
            <span class="meta">
              <span class="sk-line sk-title" />
              <span class="sk-line sk-artists" />
            </span>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="music-fallback" hidden>
    Couldn’t load right now — see what I’ve been listening to on
    <a href={instance} target="_blank" rel="noopener noreferrer">Koito</a>.
  </p>
</music-feed>

<script>
  import { el } from "@/lib/client/dom"
  import { TIME_ZONE } from "@/lib/client/feed"
  import { mountHeatmap } from "@/lib/client/heatmap"
  import {
    isPlaying,
    loadSite,
    type Site,
    type SiteListen,
    STAT_KEYS,
  } from "@/lib/client/music"
  import { setReadout } from "@/lib/client/readout"

  const numberFormatter = new Intl.NumberFormat("en-US", {
    maximumFractionDigits: 1,
  })
  const dayFormatter = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    timeZone: TIME_ZONE,
  })
  const timeFormatter = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZone: TIME_ZONE,
  })
  // Short enough to sit beside the artists on a half-width row without
  // either one being cut; the full instant is on hover.
  const formatWhen = (iso: string) => {
    const value = new Date(iso)
    const minutes = Math.round((Date.now() - value.getTime()) / 60_000)
    if (minutes < 1) return "just now"
    if (minutes < 60) return `${minutes}m ago`
    if (minutes < 60 * 24) return `${Math.round(minutes / 60)}h ago`
    return dayFormatter.format(value)
  }

  const fillStats = (feed: HTMLElement, stats: Site["stats"]) => {
    feed.querySelectorAll<HTMLElement>(".stat").forEach((stat) => {
      const key = STAT_KEYS.find((name) => name === stat.dataset.key)
      const target = stat.querySelector<HTMLElement>(".value")
      if (key && target) setReadout(target, numberFormatter.format(stats[key]))
    })
  }

  const buildHeatmap = (feed: HTMLElement, activity: Site["activity"]) => {
    const grid = feed.querySelector<HTMLElement>(".heat-grid")
    if (!grid || activity.length === 0) throw new Error("No activity data")

    mountHeatmap(grid, activity, (shown) => {
      // Linear scale over the visible window, so narrow viewports keep
      // their contrast instead of inheriting a year-wide maximum.
      const max = Math.max(...shown.map((day) => day.plays), 1)
      return shown.map((day) => ({
        level:
          day.plays === 0 ? 0 : Math.max(1, Math.ceil((day.plays / max) * 4)),
        title: `${day.plays} ${day.plays === 1 ? "play" : "plays"} on ${dayFormatter.format(new Date(`${day.date}T00:00:00+08:00`))}`,
      }))
    })
  }

  /**
   * One listen. The first row of the list is the lead: the same markup
   * plus a record sliding out of the sleeve, its label printed with the
   * cover art, still turning if the play was only minutes ago.
   */
  const buildRow = (listen: SiteListen, lead: boolean) => {
    const row = el("li", "music-item")

    const link = el("a", "music-link") as HTMLAnchorElement
    link.href = listen.url
    link.target = "_blank"
    link.rel = "noopener noreferrer"

    const src = lead
      ? (listen.cover.medium ?? listen.cover.small)
      : listen.cover.small
    const art = (alt: string, size: number) => {
      const img = document.createElement("img")
      img.src = src ?? ""
      img.alt = alt
      img.loading = "lazy"
      img.decoding = "async"
      img.width = size
      img.height = size
      return img
    }

    const cover = el("span", "cover")
    if (src) cover.append(art(`${listen.title} cover art`, lead ? 160 : 40))

    if (lead) {
      row.dataset.lead = ""
      if (isPlaying(listen.at)) row.dataset.recent = ""
      const disc = el("span", "disc")
      disc.setAttribute("aria-hidden", "true")
      const label = el("span", "disc-label")
      if (src) label.append(art("", 64))
      disc.append(label)
      const sleeve = el("span", "sleeve")
      sleeve.append(disc, cover)
      link.append(sleeve)
    } else {
      link.append(cover)
    }

    const when = el("time", "when", formatWhen(listen.at)) as HTMLTimeElement
    when.dateTime = listen.at
    when.title = timeFormatter.format(new Date(listen.at))

    const artists = el("span", "artists", listen.artists.join(", "))

    const meta = el("span", "meta")
    if (lead) {
      meta.append(when, el("span", "title", listen.title), artists)
    } else {
      const sub = el("span", "sub")
      sub.append(artists, when)
      meta.append(el("span", "title", listen.title), sub)
    }
    link.append(meta)

    row.append(link)
    return row
  }

  document.querySelectorAll<HTMLElement>("music-feed").forEach((feed) => {
    const endpoint = feed.dataset.endpoint
    const body = feed.querySelector<HTMLElement>(".music-body")
    const list = feed.querySelector<HTMLOListElement>(".music-list")
    const fallback = feed.querySelector<HTMLElement>(".music-fallback")
    if (!endpoint || !body || !list) return

    const limit = Number(feed.dataset.limit) || 10

    // Cached and refreshed payloads land in the same renderer, which
    // replaces rather than appends, so a second delivery just repaints.
    loadSite(endpoint, (site) => {
      if (site.listens.length === 0) throw new Error("No listens")
      fillStats(feed, site.stats)
      buildHeatmap(feed, site.activity)
      const fragment = document.createDocumentFragment()
      site.listens
        .slice(0, limit)
        .forEach((listen, i) => fragment.append(buildRow(listen, i === 0)))
      list.replaceChildren(fragment)
      feed.setAttribute("aria-busy", "false")
    }).catch(() => {
      body.hidden = true
      if (fallback) fallback.hidden = false
      feed.setAttribute("aria-busy", "false")
    })
  })
</script>

<style>
  music-feed {
    display: block;
  }

  /* Last played: the lead listen across the top, the rest in as many
     columns as fit (one on a phone, two in the column) — intrinsic, so
     no query has to know how wide the column is. */

  .music-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-3xs) var(--space-s);
  }

  music-feed :global(.music-item[data-lead]) {
    grid-column: 1 / -1;
    margin-block-end: var(--space-2xs);
  }

  music-feed :global(.music-link) {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-inline: calc(-1 * var(--space-3xs));
    padding: var(--space-3xs);
    border-radius: var(--radius-lg);
    color: var(--foreground);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  @media (hover: hover) {
    music-feed :global(.music-item:not([data-lead]) .music-link:hover) {
      background-color: var(--muted);
    }

    music-feed :global(.music-link:hover .title) {
      text-decoration: underline;
      text-decoration-thickness: max(1px, 0.0625em);
      text-underline-offset: 0.15em;
    }
  }

  music-feed :global(.cover) {
    position: relative;
    display: block;
    flex-shrink: 0;
    inline-size: 2.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  music-feed :global(.cover img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  music-feed :global(.meta) {
    display: flex;
    min-inline-size: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
  }

  music-feed :global(.title) {
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Artists give way before the time does: the time is short and is the
     one fact on the line that can't be read off the cover. */
  music-feed :global(.sub) {
    display: flex;
    gap: var(--space-2xs);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  music-feed :global(.artists) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  music-feed :global(.sub .artists) {
    flex: 1;
  }

  music-feed :global(.when) {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  /* The lead: a sleeve with the record half out of it. The grooves are
     radial, so turning them would show nothing; the label is printed with
     the cover art, and it is the label that shows the record turning. */

  music-feed :global([data-lead] .music-link) {
    gap: var(--space-s);
  }

  music-feed :global(.sleeve) {
    --sleeve: 6.5rem;
    position: relative;
    display: block;
    flex-shrink: 0;
    inline-size: calc(var(--sleeve) * 1.45);
    block-size: var(--sleeve);
  }

  music-feed :global([data-lead] .cover) {
    position: relative;
    z-index: 1;
    inline-size: var(--sleeve, 6.5rem);
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--foreground) 10%, transparent),
      0 1px 2px rgb(0 0 0 / 0.1),
      0 8px 18px -10px rgb(0 0 0 / 0.45);
  }

  music-feed :global(.disc) {
    position: absolute;
    inset-block-start: 4%;
    inset-inline-start: 36%;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    inline-size: calc(var(--sleeve) * 0.92);
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        transparent 0 30%,
        rgb(255 255 255 / 0.05) 31%,
        transparent 32%
      ),
      repeating-radial-gradient(circle, #161616 0 1.5px, #0c0c0c 1.5px 3px);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--foreground) 12%, transparent),
      0 6px 14px -8px rgb(0 0 0 / 0.5);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* A fixed sheen over the grooves: light doesn't turn with the record. */
  music-feed :global(.disc::after) {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(
      from 20deg,
      transparent 0 8%,
      rgb(255 255 255 / 0.1) 13%,
      transparent 20% 55%,
      rgb(255 255 255 / 0.07) 62%,
      transparent 70%
    );
    pointer-events: none;
  }

  music-feed :global(.disc-label) {
    inline-size: 36%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--gray-8);
    animation: music-spin 3.2s linear infinite;
  }

  music-feed :global(.disc-label img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    mask: radial-gradient(circle, transparent 0 6%, #000 7%);
  }

  @keyframes music-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (hover: hover) {
    music-feed :global([data-lead] .music-link:hover .disc) {
      transform: translateX(12%);
    }
  }

  music-feed :global([data-lead] .when) {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  music-feed :global([data-recent] .when::before) {
    content: "";
    display: inline-block;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    margin-inline-end: 0.4rem;
    border-radius: 50%;
    background-color: light-dark(#30a14e, #3dd68c);
    vertical-align: 0.1em;
  }

  music-feed :global([data-lead] .title) {
    font-size: var(--step-1);
    line-height: 1.25;
    white-space: normal;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  music-feed :global([data-lead] .artists) {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    white-space: normal;
  }

  /* Skeletons */

  music-feed :global([data-skeleton][data-lead] .cover) {
    inline-size: 6.5rem;
  }

  music-feed :global(.sk-title) {
    inline-size: 60%;
  }

  music-feed :global(.sk-artists) {
    inline-size: 35%;
    block-size: 0.7em;
  }
</style>
