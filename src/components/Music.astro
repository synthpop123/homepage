---
import { KOITO } from "@/consts"

type Props = {
  instance?: string
  limit?: number
}

const { instance = KOITO.instance, limit = KOITO.limit } = Astro.props

const stats: { key: string; label: string }[] = [
  { key: "listen_count", label: "Plays" },
  { key: "track_count", label: "Tracks" },
  { key: "album_count", label: "Albums" },
  { key: "artist_count", label: "Artists" },
  { key: "minutes_listened", label: "Minutes" },
  { key: "days_active", label: "Days active" },
  { key: "avg_daily_plays", label: "Avg. daily plays" },
  { key: "longest_streak", label: "Day streak" },
]
---

<p class="music-intro">
  Music I've been listening to, pulled live from my self-hosted
  <a href={instance} target="_blank" rel="noopener noreferrer">Koito</a>
  instance.
</p>
<music-feed data-instance={instance} data-limit={limit} aria-busy="true">
  <div class="music-body">
    <h3 class="music-label">All-time stats</h3>
    <dl class="music-stats">
      {stats.map(({ key, label }) => (
        <div class="stat" data-key={key}>
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>
    <h3 class="music-label">Activity</h3>
    <div class="music-heatmap">
      <div class="heat-days" aria-hidden="true">
        {["Mon", "Wed", "Fri", "Sun"].map((day) => <span>{day}</span>)}
      </div>
      <div class="heat-grid" data-skeleton></div>
    </div>
    <h3 class="music-label">Last played</h3>
    <ol class="music-list">
      {Array.from({ length: limit }).map(() => (
        <li class="music-item" data-skeleton aria-hidden="true">
          <div class="music-link">
            <span class="cover" />
            <span class="meta">
              <span class="sk-line sk-title" />
              <span class="sk-line sk-artists" />
            </span>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="music-fallback" hidden>
    Couldn’t load right now — see what I’ve been listening to on
    <a href={instance} target="_blank" rel="noopener noreferrer">Koito</a>.
  </p>
</music-feed>

<script>
  import { cached, fetchJson, TIME_ZONE } from "@/lib/client/feed"

  type KoitoStats = Record<string, number>

  type KoitoActivity = {
    activity?: { start_time: string; listens: number }[]
  }

  type KoitoListens = {
    items?: {
      time: string
      track?: {
        id?: number
        title?: string
        artists?: { name?: string }[]
        image?: { xs?: string; small?: string; medium?: string }
      }
    }[]
  }

  const HEAT_CELL = 12 // px, keep in sync with --heat-cell
  const HEAT_GAP = 3 // px, keep in sync with --heat-gap
  const HEAT_MAX_WEEKS = 52

  const numberFormatter = new Intl.NumberFormat("en-US", {
    maximumFractionDigits: 1,
  })
  const dayFormatter = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    timeZone: TIME_ZONE,
  })
  const timeFormatter = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZone: TIME_ZONE,
  })
  const relativeFormatter = new Intl.RelativeTimeFormat("en-US", {
    numeric: "always",
  })

  const formatWhen = (iso: string) => {
    const value = new Date(iso)
    const minutes = Math.round((Date.now() - value.getTime()) / 60_000)
    if (minutes < 1) return "just now"
    if (minutes < 60) return relativeFormatter.format(-minutes, "minute")
    if (minutes < 60 * 24)
      return relativeFormatter.format(-Math.round(minutes / 60), "hour")
    return timeFormatter.format(value)
  }

  // Monday = 0 … Sunday = 6, derived from the date part alone so the
  // grid stays aligned to the instance's day boundaries, not the
  // visitor's local time zone.
  const weekdayIndex = (isoDay: string) =>
    (new Date(`${isoDay.slice(0, 10)}T12:00:00Z`).getUTCDay() + 6) % 7

  type KoitoData = [KoitoStats, KoitoActivity, KoitoListens]

  const fillStats = (feed: HTMLElement, stats: KoitoStats) => {
    feed.querySelectorAll<HTMLElement>(".stat").forEach((stat) => {
      const value = stats[stat.dataset.key ?? ""]
      const target = stat.querySelector<HTMLElement>(".value")
      if (target && typeof value === "number") {
        target.textContent = numberFormatter.format(value)
      }
    })
  }

  const buildHeatmap = (container: HTMLElement, activity: KoitoActivity) => {
    const grid = container.querySelector<HTMLElement>(".heat-grid")
    const days = activity.activity ?? []
    if (!grid || days.length === 0) throw new Error("No activity data")

    const lastWeekday = weekdayIndex(days[days.length - 1].start_time)
    let weeks = 0

    const render = () => {
      const fittable = Math.floor(
        (grid.clientWidth + HEAT_GAP) / (HEAT_CELL + HEAT_GAP),
      )
      const next = Math.max(1, Math.min(HEAT_MAX_WEEKS, fittable))
      if (next === weeks) return
      weeks = next

      const shown = days.slice(-((weeks - 1) * 7 + lastWeekday + 1))
      const max = Math.max(...shown.map((day) => day.listens), 1)

      const cells = document.createDocumentFragment()
      for (let pad = weekdayIndex(shown[0].start_time); pad > 0; pad--) {
        const cell = document.createElement("span")
        cell.dataset.pad = ""
        cells.append(cell)
      }
      for (const day of shown) {
        const cell = document.createElement("span")
        const level =
          day.listens === 0
            ? 0
            : Math.max(1, Math.ceil((day.listens / max) * 4))
        cell.dataset.level = String(level)
        const date = dayFormatter.format(new Date(day.start_time))
        cell.title = `${day.listens} ${day.listens === 1 ? "play" : "plays"} on ${date}`
        cells.append(cell)
      }
      grid.replaceChildren(cells)
    }

    render()
    grid.removeAttribute("data-skeleton")
    // Re-fit on viewport changes (rotation, resize, mobile URL bar) so the
    // fixed-size cells never overflow the container.
    new ResizeObserver(render).observe(grid)
  }

  const buildRow = (
    item: NonNullable<KoitoListens["items"]>[number],
    instance: string,
  ) => {
    const row = document.createElement("li")
    row.className = "music-item"

    const link = document.createElement("a")
    link.className = "music-link"
    link.href = `${instance}/track/${item.track?.id}`
    link.target = "_blank"
    link.rel = "noopener noreferrer"

    const cover = document.createElement("span")
    cover.className = "cover"
    const src = item.track?.image?.small ?? item.track?.image?.xs
    if (src) {
      const img = document.createElement("img")
      img.src = `${instance}${src}`
      img.alt = `${item.track?.title ?? ""} cover art`
      img.loading = "lazy"
      img.decoding = "async"
      img.width = 40
      img.height = 40
      cover.append(img)
    }
    link.append(cover)

    const meta = document.createElement("span")
    meta.className = "meta"
    const title = document.createElement("span")
    title.className = "title"
    title.textContent = item.track?.title ?? "Untitled"
    const artists = document.createElement("span")
    artists.className = "artists"
    artists.textContent = (item.track?.artists ?? [])
      .map((artist) => artist.name)
      .filter(Boolean)
      .join(", ")
    meta.append(title, artists)
    link.append(meta)

    const when = document.createElement("time")
    when.className = "when"
    when.dateTime = new Date(item.time).toISOString()
    when.textContent = formatWhen(item.time)
    link.append(when)

    row.append(link)
    return row
  }

  document.querySelectorAll<HTMLElement>("music-feed").forEach((feed) => {
    const instance = feed.dataset.instance
    const body = feed.querySelector<HTMLElement>(".music-body")
    const heatmap = feed.querySelector<HTMLElement>(".music-heatmap")
    const list = feed.querySelector<HTMLOListElement>(".music-list")
    const fallback = feed.querySelector<HTMLElement>(".music-fallback")
    if (!instance || !body || !heatmap || !list) return

    const limit = Number(feed.dataset.limit) || 10
    const api = `${instance}/apis/web/v1`
    const cacheKey = `koito:${instance}:${limit}`

    const load = (): Promise<KoitoData> =>
      cached(
        cacheKey,
        () =>
          Promise.all([
            fetchJson<KoitoStats>(`${api}/stats?period=all_time`),
            fetchJson<KoitoActivity>(
              `${api}/listen-activity?step=day&range=${HEAT_MAX_WEEKS * 7}&tz=${encodeURIComponent(TIME_ZONE)}`,
            ),
            fetchJson<KoitoListens>(
              `${api}/listens?period=all_time&limit=${limit}`,
            ),
          ]),
        (data) => Array.isArray(data) && data.length === 3,
      )

    load()
      .then(([stats, activity, listens]) => {
        const items = (listens.items ?? []).filter(
          (item) => item?.track?.title && item?.track?.id,
        )
        if (items.length === 0) throw new Error("No listens")
        fillStats(feed, stats)
        buildHeatmap(heatmap, activity)
        const fragment = document.createDocumentFragment()
        for (const item of items.slice(0, limit))
          fragment.append(buildRow(item, instance))
        list.replaceChildren(fragment)
        feed.setAttribute("aria-busy", "false")
      })
      .catch(() => {
        body.hidden = true
        if (fallback) fallback.hidden = false
        feed.setAttribute("aria-busy", "false")
      })
  })
</script>

<style>
  .music-intro {
    margin-block-end: var(--space-s);
    color: var(--muted-foreground);
  }

  .music-fallback {
    margin-block-end: 0;
    color: var(--muted-foreground);
  }

  .music-intro a,
  .music-fallback a {
    color: var(--foreground);
    text-decoration: underline;
  }

  music-feed {
    display: block;
  }

  .music-label {
    margin-block: var(--space-m) var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .music-label:first-child {
    margin-block-start: 0;
  }

  /* Stats */

  .music-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xs) var(--space-s);
    margin: 0;

    @media (width < 40rem) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat {
    display: flex;
    /* dt comes first in the DOM for validity, value renders on top */
    flex-direction: column-reverse;
    gap: var(--space-3xs);
  }

  .stat .value {
    margin: 0;
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .stat .label {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  /* Heatmap */

  .music-heatmap {
    --heat-cell: 12px;
    --heat-gap: 3px;
    --heat-0: var(--gray-4);
    --heat-1: light-dark(#9be9a8, #0e4429);
    --heat-2: light-dark(#40c463, #006d32);
    --heat-3: light-dark(#30a14e, #26a641);
    --heat-4: light-dark(#216e39, #39d353);

    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: start;
  }

  .heat-days {
    display: grid;
    grid-template-rows: repeat(7, var(--heat-cell));
    gap: var(--heat-gap);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--muted-foreground);
  }

  .heat-days span {
    align-self: center;
  }

  .heat-days span:nth-child(2) {
    grid-row: 3;
  }

  .heat-days span:nth-child(3) {
    grid-row: 5;
  }

  .heat-days span:nth-child(4) {
    grid-row: 7;
  }

  .heat-grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--heat-cell));
    grid-auto-columns: var(--heat-cell);
    gap: var(--heat-gap);
    min-block-size: calc(var(--heat-cell) * 7 + var(--heat-gap) * 6);
    /* Never let a transient misfit widen the page; the ResizeObserver
       in the script re-fits the week count right after. */
    overflow: hidden;
  }

  .heat-grid[data-skeleton] {
    border-radius: var(--radius-sm);
  }

  .heat-grid :global(span) {
    border-radius: var(--radius-xs);
  }

  .heat-grid :global(span[data-pad]) {
    visibility: hidden;
  }

  .music-heatmap :global([data-level="0"]) {
    background-color: var(--heat-0);
  }

  .music-heatmap :global([data-level="1"]) {
    background-color: var(--heat-1);
  }

  .music-heatmap :global([data-level="2"]) {
    background-color: var(--heat-2);
  }

  .music-heatmap :global([data-level="3"]) {
    background-color: var(--heat-3);
  }

  .music-heatmap :global([data-level="4"]) {
    background-color: var(--heat-4);
  }

  /* Last played list */

  .music-list {
    display: flex;
    flex-direction: column;
  }

  music-feed :global(.music-item + .music-item) {
    border-block-start: 1px solid var(--border);
  }

  music-feed :global(.music-link) {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-block: var(--space-2xs);
    color: var(--foreground);
    text-decoration: none;
  }

  music-feed :global(.music-link:hover .title) {
    text-decoration: underline;
    text-decoration-thickness: max(1px, 0.0625em);
    text-underline-offset: 0.15em;
  }

  music-feed :global(.cover) {
    flex-shrink: 0;
    inline-size: 2.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--muted);
  }

  music-feed :global(.cover img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  music-feed :global(.meta) {
    display: flex;
    min-inline-size: 0;
    flex: 1;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  music-feed :global(.title) {
    overflow: hidden;
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    line-height: 1.25;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  music-feed :global(.artists) {
    overflow: hidden;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  music-feed :global(.when) {
    flex-shrink: 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  /* Skeletons */

  music-feed :global(.sk-line) {
    display: block;
    block-size: 0.85em;
    border-radius: var(--radius-sm);
  }

  music-feed :global(.sk-stat) {
    inline-size: 3.5em;
    block-size: 1em;
  }

  music-feed :global(.sk-title) {
    inline-size: 60%;
  }

  music-feed :global(.sk-artists) {
    inline-size: 35%;
    block-size: 0.7em;
  }

  .heat-grid[data-skeleton],
  music-feed :global([data-skeleton] .cover),
  music-feed :global(.sk-line) {
    background-color: var(--gray-5);
    animation: var(--sk-pulse);
  }
</style>
