---
import Heatmap from "@/components/Heatmap.astro"
import { KOITO, MISC } from "@/consts"
import type { SiteStats } from "@/lib/client/music"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = MISC.endpoint, limit = KOITO.limit } = Astro.props
const instance = KOITO.instance

const stats: { key: keyof SiteStats; label: string }[] = [
  { key: "plays", label: "Plays" },
  { key: "tracks", label: "Tracks" },
  { key: "artists", label: "Artists" },
  { key: "daysActive", label: "Days active" },
]
---

<music-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <div class="music-body">
    <h3 class="music-label">All-time stats</h3>
    <dl class="readout">
      {stats.map(({ key, label }) => (
        <div class="stat" data-key={key}>
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>
    <h3 class="music-label">Activity</h3>
    <Heatmap />
    <h3 class="music-label">Last played</h3>
    <ol class="music-list">
      {Array.from({ length: limit }).map((_, i) => (
        <li
          class="music-item"
          data-skeleton
          data-lead={i === 0 ? "" : undefined}
          aria-hidden="true"
        >
          <div class="music-link">
            <span class="cover" />
            <span class="meta">
              <span class="sk-line sk-title" />
              <span class="sk-line sk-artists" />
            </span>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="music-fallback" hidden>
    Couldn’t load right now — see what I’ve been listening to on
    <a href={instance} target="_blank" rel="noopener noreferrer">Koito</a>.
  </p>
</music-feed>

<script>
  import { mountMusic } from "@/lib/client/music-feed"

  document.querySelectorAll<HTMLElement>("music-feed").forEach(mountMusic)
</script>

<style>
  music-feed {
    display: block;
  }

  /* Last played: the lead listen across the top, the rest in as many
     columns as fit (one on a phone, two in the column) — intrinsic, so
     no query has to know how wide the column is. */

  .music-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-3xs) var(--space-s);
  }

  music-feed :global(.music-item[data-lead]) {
    grid-column: 1 / -1;
    margin-block-end: var(--space-2xs);
  }

  music-feed :global(.music-link) {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-inline: calc(-1 * var(--space-3xs));
    padding: var(--space-3xs);
    border-radius: var(--radius-lg);
    color: var(--foreground);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  @media (hover: hover) {
    music-feed :global(.music-item:not([data-lead]) .music-link:hover) {
      background-color: var(--muted);
    }

    music-feed :global(.music-link:hover .title) {
      text-decoration: underline;
      text-decoration-thickness: max(1px, 0.0625em);
      text-underline-offset: 0.15em;
    }
  }

  music-feed :global(.cover) {
    position: relative;
    display: block;
    flex-shrink: 0;
    inline-size: 2.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  music-feed :global(.cover img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  music-feed :global(.meta) {
    display: flex;
    min-inline-size: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.125rem;
  }

  music-feed :global(.title) {
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Artists give way before the time does: the time is short and is the
     one fact on the line that can't be read off the cover. */
  music-feed :global(.sub) {
    display: flex;
    gap: var(--space-2xs);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  music-feed :global(.artists) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  music-feed :global(.sub .artists) {
    flex: 1;
  }

  music-feed :global(.when) {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  /* The lead: a sleeve with the record half out of it. The grooves are
     radial, so turning them would show nothing; the label is printed with
     the cover art, and it is the label that shows the record turning. */

  music-feed :global([data-lead] .music-link) {
    gap: var(--space-s);
  }

  music-feed :global(.sleeve) {
    --sleeve: 6.5rem;
    position: relative;
    display: block;
    flex-shrink: 0;
    inline-size: calc(var(--sleeve) * 1.45);
    block-size: var(--sleeve);
  }

  music-feed :global([data-lead] .cover) {
    position: relative;
    z-index: 1;
    inline-size: var(--sleeve, 6.5rem);
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--foreground) 10%, transparent),
      0 1px 2px rgb(0 0 0 / 0.1),
      0 8px 18px -10px rgb(0 0 0 / 0.45);
  }

  music-feed :global(.disc) {
    position: absolute;
    inset-block-start: 4%;
    inset-inline-start: 36%;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    inline-size: calc(var(--sleeve) * 0.92);
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        transparent 0 30%,
        rgb(255 255 255 / 0.05) 31%,
        transparent 32%
      ),
      repeating-radial-gradient(circle, #161616 0 1.5px, #0c0c0c 1.5px 3px);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--foreground) 12%, transparent),
      0 6px 14px -8px rgb(0 0 0 / 0.5);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* A fixed sheen over the grooves: light doesn't turn with the record. */
  music-feed :global(.disc::after) {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(
      from 20deg,
      transparent 0 8%,
      rgb(255 255 255 / 0.1) 13%,
      transparent 20% 55%,
      rgb(255 255 255 / 0.07) 62%,
      transparent 70%
    );
    pointer-events: none;
  }

  music-feed :global(.disc-label) {
    inline-size: 36%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--gray-8);
    animation: music-spin 3.2s linear infinite;
  }

  music-feed :global(.disc-label img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    mask: radial-gradient(circle, transparent 0 6%, #000 7%);
  }

  /* Off screen the record stops where it is (music-feed/index.ts sets
     the attribute), and picks up from there when it scrolls back. */
  music-feed :global(.disc[data-offscreen] .disc-label) {
    animation-play-state: paused;
  }

  @keyframes music-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (hover: hover) {
    music-feed :global([data-lead] .music-link:hover .disc) {
      transform: translateX(12%);
    }
  }

  music-feed :global([data-lead] .when) {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  music-feed :global([data-recent] .when::before) {
    content: "";
    display: inline-block;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    margin-inline-end: 0.4rem;
    border-radius: 50%;
    background-color: light-dark(#30a14e, #3dd68c);
    vertical-align: 0.1em;
  }

  music-feed :global([data-lead] .title) {
    font-size: var(--step-1);
    line-height: 1.25;
    white-space: normal;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  music-feed :global([data-lead] .artists) {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    white-space: normal;
  }

  /* Skeletons */

  music-feed :global([data-skeleton][data-lead] .cover) {
    inline-size: 6.5rem;
  }

  music-feed :global(.sk-title) {
    inline-size: 60%;
  }

  music-feed :global(.sk-artists) {
    inline-size: 35%;
    block-size: 0.7em;
  }
</style>
