---
import "@/styles/feed.css"
import MastodonIcon from "@/assets/icons/mastodon.svg"
import { MASTODON, MEMOS } from "@/consts"
import { SKELETON_ROWS } from "@/lib/utils"

const profileUrl = `${MASTODON.instance}/@${MASTODON.username}`
---

<memos-feed data-endpoint={MEMOS.endpoint} aria-busy="true">
  <p class="memos-intro">
    Short notes, pulled live from my
    <MastodonIcon class="memos-mark" aria-hidden="true" />
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>
    instance.
  </p>
  <ol class="memos-list">
    <li class="memo-year" data-skeleton aria-hidden="true">
      <span class="sk-line sk-year" />
    </li>
    {Array.from({ length: SKELETON_ROWS }).map(() => (
        <li class="memo" data-skeleton aria-hidden="true">
          <span class="memo-rail">
            <span class="sk-line sk-meta" />
          </span>
          <span class="memo-main">
            <span class="sk-line" style="inline-size: 92%" />
            <span class="sk-line" style="inline-size: 64%" />
            <span class="sk-media" />
          </span>
        </li>
      ))}
  </ol>
  <p class="memos-empty" hidden>
    No notes here yet — say hi on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>.
  </p>
  <p class="memos-fallback" hidden>
    Couldn’t load memos right now — read them on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>.
  </p>
</memos-feed>

<script>
  import { mountMemos } from "@/lib/client/memos-feed"

  document.querySelectorAll<HTMLElement>("memos-feed").forEach(mountMemos)
</script>

<style>
  memos-feed {
    /* Width of the date column right of the thread. */
    --memos-rail: 5.5rem;
    /* Room left of every entry for the thread and its nodes. */
    --thread: 1.5rem;
    /* Where the thread runs, measured from the list's edge. */
    --axis: 0.3125rem;
    /* The first line box of an entry — its date and the prose's first
       line share it, and each node sits on its centre. */
    --memo-line: calc(var(--leading-offset) + 1rem);

    display: block;
  }

  .memos-mark {
    display: inline-block;
    inline-size: 1.1em;
    block-size: 1.1em;
    vertical-align: -0.18em;
  }

  /* A thread rather than a stack of ruled rows: one line runs down the
     left edge, every memo is a node on it and every year a larger, filled
     one. Each entry draws the stretch of line from its own top down to
     the next entry, so no piece has to know where another sits; the last
     one trails off, since the account goes on past what is shown. */

  .memos-list {
    display: flex;
    flex-direction: column;
  }

  memos-feed :global(.memos-list > li) {
    --gap-after: var(--space-l);
    --node-y: calc(var(--memo-line) / 2);
    --node: 0.625rem;

    position: relative;
    padding-inline-start: var(--thread);
  }

  memos-feed :global(.memos-list > li:not(:last-child)) {
    margin-block-end: var(--gap-after);
  }

  memos-feed :global(.memos-list > li::before) {
    content: "";
    position: absolute;
    inset-block: 0 calc(-1 * var(--gap-after));
    inset-inline-start: calc(var(--axis) - 0.5px);
    inline-size: 1px;
    background-color: var(--border);
  }

  memos-feed :global(.memos-list > li:first-child::before) {
    inset-block-start: var(--node-y);
  }

  memos-feed :global(.memos-list > li:last-child::before) {
    inset-block-end: auto;
    block-size: calc(var(--node-y) + 3rem);
    mask: linear-gradient(#000 calc(100% - 3rem), transparent);
  }

  memos-feed :global(.memos-list > li:only-child::before) {
    inset-block-start: var(--node-y);
    block-size: 3rem;
    mask: linear-gradient(#000, transparent);
  }

  memos-feed :global(.memos-list > li::after) {
    content: "";
    position: absolute;
    inset-block-start: calc(var(--node-y) - var(--node) / 2);
    inset-inline-start: calc(var(--axis) - var(--node) / 2);
    box-sizing: border-box;
    inline-size: var(--node);
    aspect-ratio: 1;
    border: 1.5px solid var(--gray-8);
    border-radius: 50%;
    background-color: var(--background);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  @media (hover: hover) {
    memos-feed :global(.memo:not([data-skeleton]):hover::after) {
      border-color: var(--foreground);
      background-color: var(--foreground);
    }
  }

  /* A year opens with its number on the thread; its node is filled and
     the one step larger, so the years read as the thread's joints. */
  memos-feed :global(.memos-list > .memo-year) {
    --gap-after: var(--space-s);
    --node-y: 1rem;
    --node: 0.75rem;
  }

  memos-feed :global(.memos-list > .memo-year::after) {
    border-color: var(--foreground);
    background-color: var(--foreground);
    box-shadow: 0 0 0 4px var(--background);
  }

  memos-feed :global(.memo-year h2) {
    margin: 0;
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    line-height: 2rem;
    letter-spacing: -0.01em;
  }

  memos-feed :global(.memo article),
  memos-feed :global(.memo[data-skeleton]) {
    display: grid;
    gap: var(--space-3xs) var(--space-m);
    align-items: start;

    @media (width >= 40rem) {
      grid-template-columns: var(--memos-rail) minmax(0, 1fr);
    }
  }

  /* The date label, echoing the section labels on the Tokens and Misc
     feeds. Its line box matches the prose's first line so the caps
     align across the two columns. */
  memos-feed :global(.memo-rail) {
    display: flex;
    margin: 0;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5em;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    line-height: calc(var(--leading-offset) + 1rem);
    text-transform: uppercase;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;

    /* On a wide screen the date rides down beside a long entry, so the
       day stays in view while its photos scroll past. */
    @media (width >= 40rem) {
      position: sticky;
      inset-block-start: var(--page-offset-top);
    }
  }

  memos-feed :global(.memo-time) {
    color: inherit;
    text-decoration: none;
  }

  memos-feed :global(.memo-time:hover) {
    color: var(--foreground);
    text-decoration: underline;
  }

  memos-feed :global(.memo-edited) {
    color: var(--faint-foreground);
  }

  memos-feed :global(.memo-main) {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  /* Content */

  memos-feed :global(.memo-content) {
    overflow-wrap: anywhere;
  }

  memos-feed :global(.invisible) {
    display: none;
  }

  memos-feed :global(.ellipsis::after) {
    content: "…";
  }

  memos-feed :global(.emoji) {
    display: inline-block;
    inline-size: 1.25em;
    block-size: 1.25em;
    margin-inline: 0.05em;
    object-fit: contain;
    vertical-align: text-bottom;
  }

  /* Content warnings: the note (or just its media) folded behind the
     warning text, with the disclosure state spelled out after it —
     a bare triangle doesn't say what opening it costs. */

  memos-feed :global(.memo-cw) {
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: color-mix(in oklab, var(--muted) 50%, transparent);
  }

  memos-feed :global(.memo-cw summary) {
    cursor: pointer;
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  memos-feed :global(.memo-cw summary::after) {
    content: " · Show";
    color: var(--faint-foreground);
  }

  memos-feed :global(.memo-cw[open] summary::after) {
    content: " · Hide";
  }

  memos-feed :global(.memo-cw-body) {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
  }

  /* Media grid: one rounded card, hairline seams between cells. */

  memos-feed :global(.memo-media) {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--border);
  }

  memos-feed :global(.memo-media:not([data-count="1"])) {
    grid-template-columns: repeat(2, 1fr);
  }

  memos-feed :global(.memo-media[data-count="3"]) {
    grid-template-columns: 2fr 1fr;
  }

  memos-feed :global(.memo-shot) {
    margin: 0;
    overflow: hidden;
    background-color: var(--muted);
  }

  memos-feed :global(.memo-media:not([data-count="1"]) .memo-shot) {
    aspect-ratio: 4 / 3;
  }

  memos-feed :global(.memo-media[data-count="3"] .memo-shot:first-child) {
    grid-row: span 2;
    aspect-ratio: auto;
  }

  memos-feed :global(.memo-shot a) {
    display: block;
    block-size: 100%;
  }

  memos-feed :global(.memo-shot :is(img, video)) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Only images fade in: a video paints its poster frame immediately,
     and a gifv starts playing on its own. */
  memos-feed :global(.memo-shot img) {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  memos-feed :global(.memo-shot img.is-loaded) {
    opacity: 1;
  }

  /* A single attachment keeps a fixed height and takes its width from
     its own ratio (the width/height attributes), so one shot never
     fills the column; the card shrink-wraps it. */
  memos-feed :global(.memo-media[data-count="1"]) {
    display: block;
    inline-size: fit-content;
    max-inline-size: 100%;
  }

  memos-feed :global(.memo-media[data-count="1"] :is(img, video)) {
    inline-size: auto;
    block-size: auto;
    max-inline-size: 100%;
    max-block-size: 22rem;
  }

  /* Audio has no thumbnail worth a grid cell, so it plays on its own
     row under whatever else the memo attached. */
  memos-feed :global(.memo-audio) {
    inline-size: 100%;
  }

  /* Skeletons: the thread opens on a year, as the loaded list always
     does, so the first memo lands where its placeholder was. */

  memos-feed :global(.memo-year[data-skeleton]) {
    display: flex;
    align-items: center;
    block-size: 2rem;
  }

  memos-feed :global(.memos-list > .memo-year[data-skeleton]::after) {
    border-color: var(--gray-5);
    background-color: var(--gray-5);
  }

  .sk-year {
    inline-size: 3em;
    block-size: 1.1em;
  }

  .sk-meta {
    inline-size: 6.5em;
    block-size: 0.7em;
  }

  .sk-media {
    display: block;
    inline-size: min(26rem, 100%);
    block-size: 14rem;
    border-radius: var(--radius-lg);
  }

  .sk-media {
    background-color: var(--gray-5);
    animation: var(--sk-pulse);
  }
</style>
