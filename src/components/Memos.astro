---
import MastodonIcon from "@/assets/icons/mastodon.svg"
import { MASTODON } from "@/consts"
import { SKELETON_ROWS } from "@/lib/utils"

type Props = {
  limit?: number
}

const { limit = MASTODON.limit } = Astro.props
const { instance, username, accountId } = MASTODON

const profileUrl = `${instance}/@${username}`
---

<memos-feed
  data-instance={instance}
  data-account-id={accountId}
  data-limit={limit}
  aria-busy="true"
>
  <p class="memos-intro">
    Short notes, pulled live from my
    <MastodonIcon class="memos-mark" aria-hidden="true" />
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>
    instance.
  </p>
  <ol class="memos-list">
    {Array.from({ length: SKELETON_ROWS }).map(() => (
        <li class="memo" data-skeleton aria-hidden="true">
          <span class="memo-rail">
            <span class="sk-line sk-meta" />
          </span>
          <span class="memo-main">
            <span class="sk-line" style="inline-size: 92%" />
            <span class="sk-line" style="inline-size: 64%" />
            <span class="sk-media" />
          </span>
        </li>
      ))}
  </ol>
  <p class="memos-empty" hidden>
    No notes here yet — say hi on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>.
  </p>
  <p class="memos-fallback" hidden>
    Couldn’t load memos right now — read them on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>.
  </p>
</memos-feed>

<script>
  import { mountMemos } from "@/lib/client/memos-feed"

  document.querySelectorAll<HTMLElement>("memos-feed").forEach(mountMemos)
</script>

<style>
  memos-feed {
    /* Width of the date column left of each entry. */
    --memos-rail: 8rem;

    display: block;
  }

  .memos-mark {
    display: inline-block;
    inline-size: 1.1em;
    block-size: 1.1em;
    vertical-align: -0.18em;
  }

  /* Entries: a date rail on the left, content on the right; below
     40rem the rail folds above the content. */

  .memos-list {
    display: flex;
    flex-direction: column;
  }

  memos-feed :global(.memo + .memo) {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  memos-feed :global(.memo article),
  memos-feed :global(.memo[data-skeleton]) {
    display: grid;
    gap: var(--space-3xs) var(--space-m);
    align-items: start;

    @media (width >= 40rem) {
      grid-template-columns: var(--memos-rail) minmax(0, 1fr);
    }
  }

  /* The date label, echoing the section labels on the Tokens and Misc
     feeds. Its line box matches the prose's first line so the caps
     align across the two columns. */
  memos-feed :global(.memo-rail) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5em;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    line-height: calc(var(--leading-offset) + 1rem);
    text-transform: uppercase;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  memos-feed :global(.memo-time) {
    color: inherit;
    text-decoration: none;
  }

  memos-feed :global(.memo-time:hover) {
    color: var(--foreground);
    text-decoration: underline;
  }

  memos-feed :global(.memo-edited) {
    color: color-mix(in oklab, var(--muted-foreground) 60%, transparent);
  }

  memos-feed :global(.memo-main) {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  /* Content */

  memos-feed :global(.memo-content) {
    overflow-wrap: anywhere;
  }

  memos-feed :global(.invisible) {
    display: none;
  }

  memos-feed :global(.ellipsis::after) {
    content: "…";
  }

  memos-feed :global(.emoji) {
    display: inline-block;
    inline-size: 1.25em;
    block-size: 1.25em;
    margin-inline: 0.05em;
    object-fit: contain;
    vertical-align: text-bottom;
  }

  /* Content warnings: the note (or just its media) folded behind the
     warning text, with the disclosure state spelled out after it —
     a bare triangle doesn't say what opening it costs. */

  memos-feed :global(.memo-cw) {
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: color-mix(in oklab, var(--muted) 50%, transparent);
  }

  memos-feed :global(.memo-cw summary) {
    cursor: pointer;
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  memos-feed :global(.memo-cw summary::after) {
    content: " · Show";
    color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
  }

  memos-feed :global(.memo-cw[open] summary::after) {
    content: " · Hide";
  }

  memos-feed :global(.memo-cw-body) {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
  }

  /* Media grid: one rounded card, hairline seams between cells. */

  memos-feed :global(.memo-media) {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--border);
  }

  memos-feed :global(.memo-media:not([data-count="1"])) {
    grid-template-columns: repeat(2, 1fr);
  }

  memos-feed :global(.memo-media[data-count="3"]) {
    grid-template-columns: 2fr 1fr;
  }

  memos-feed :global(.memo-shot) {
    margin: 0;
    overflow: hidden;
    background-color: var(--muted);
  }

  memos-feed :global(.memo-media:not([data-count="1"]) .memo-shot) {
    aspect-ratio: 4 / 3;
  }

  memos-feed :global(.memo-media[data-count="3"] .memo-shot:first-child) {
    grid-row: span 2;
    aspect-ratio: auto;
  }

  memos-feed :global(.memo-shot a) {
    display: block;
    block-size: 100%;
  }

  memos-feed :global(.memo-shot :is(img, video)) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Only images fade in: a video paints its poster frame immediately,
     and a gifv starts playing on its own. */
  memos-feed :global(.memo-shot img) {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  memos-feed :global(.memo-shot img.is-loaded) {
    opacity: 1;
  }

  /* A single attachment keeps a fixed height and takes its width from
     its own ratio (the width/height attributes), so one shot never
     fills the column; the card shrink-wraps it. */
  memos-feed :global(.memo-media[data-count="1"]) {
    display: block;
    inline-size: fit-content;
    max-inline-size: 100%;
  }

  memos-feed :global(.memo-media[data-count="1"] :is(img, video)) {
    inline-size: auto;
    block-size: auto;
    max-inline-size: 100%;
    max-block-size: 22rem;
  }

  /* Audio has no thumbnail worth a grid cell, so it plays on its own
     row under whatever else the memo attached. */
  memos-feed :global(.memo-audio) {
    inline-size: 100%;
  }

  /* Skeletons */

  .sk-meta {
    inline-size: 6.5em;
    block-size: 0.7em;
  }

  .sk-media {
    display: block;
    inline-size: min(26rem, 100%);
    block-size: 14rem;
    border-radius: var(--radius-lg);
  }

  .sk-media {
    background-color: var(--gray-5);
    animation: var(--sk-pulse);
  }
</style>
