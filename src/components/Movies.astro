---
import { LETTERBOXD, MISC } from "@/consts"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = MISC.endpoint, limit = LETTERBOXD.limit } = Astro.props

const profileUrl = `https://letterboxd.com/${LETTERBOXD.username}/`
---

<movies-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <ol class="movies-grid">
    {Array.from({ length: limit }).map(() => (
        <li class="movie-card" data-skeleton aria-hidden="true">
          <div class="movie-link">
            <span class="poster" />
            <span class="meta">
              <span class="title"><span class="sk-line sk-title" /></span>
              <span class="foot">
                <span class="sk-line sk-rating" />
                <span class="sk-line sk-date" />
              </span>
            </span>
          </div>
        </li>
      ))}
  </ol>
  <p class="movies-fallback" hidden>
    Couldn’t load right now — browse them on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Letterboxd</a
    >.
  </p>
</movies-feed>

<script>
  import { el } from "@/lib/client/dom"
  import { dateFormatter, TIME_ZONE } from "@/lib/client/feed"
  import { loadSite, type SiteFilm, watchedInstant } from "@/lib/client/movies"

  // The wall is recent by construction, so the year is noise on the card;
  // the full date is on hover.
  const shortDate = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    timeZone: TIME_ZONE,
  })

  /**
   * One poster in the wall: the artwork carries the card, the title and
   * its year sit under it, and the line under that pairs the rating with
   * the day it was watched. A rewatch is a tag on the poster's corner,
   * since it qualifies the film rather than the date.
   */
  const buildCard = (film: SiteFilm) => {
    const card = el("li", "movie-card")
    const link = el("a", "movie-link") as HTMLAnchorElement
    link.href = film.url
    link.target = "_blank"
    link.rel = "noopener noreferrer"

    const poster = el("span", "poster")
    if (film.poster) {
      const img = document.createElement("img")
      img.src = film.poster
      img.alt = `${film.title} poster`
      img.loading = "lazy"
      img.decoding = "async"
      img.width = 150
      img.height = 225
      poster.append(img)
    }
    if (film.rewatch) poster.append(el("span", "rewatch", "Rewatch"))
    link.append(poster)

    const title = el("span", "title", film.title)
    if (film.year) title.append(" ", el("span", "year", String(film.year)))

    const foot = el("span", "foot")
    if (film.rating !== null) {
      const rating = el("span", "rating")
      rating.style.setProperty("--score", String(film.rating))
      rating.setAttribute("role", "img")
      rating.setAttribute("aria-label", `${film.rating} out of 5 stars`)
      rating.append(el("span"))
      foot.append(rating)
    }
    const watched = watchedInstant(film.watched)
    const time = el(
      "time",
      "date",
      shortDate.format(watched),
    ) as HTMLTimeElement
    time.dateTime = film.watched
    time.title = dateFormatter.format(watched)
    foot.append(time)

    const meta = el("span", "meta")
    meta.append(title, foot)
    link.append(meta)
    card.append(link)
    return card
  }

  document.querySelectorAll<HTMLElement>("movies-feed").forEach((feed) => {
    const grid = feed.querySelector<HTMLOListElement>(".movies-grid")
    const fallback = feed.querySelector<HTMLElement>(".movies-fallback")
    const endpoint = feed.dataset.endpoint
    if (!grid || !endpoint) return

    const limit = Number(feed.dataset.limit) || 8

    loadSite(endpoint, (site) => {
      if (site.films.length === 0) throw new Error("No diary entries")
      const fragment = document.createDocumentFragment()
      for (const film of site.films.slice(0, limit))
        fragment.append(buildCard(film))
      grid.replaceChildren(fragment)
      feed.setAttribute("aria-busy", "false")
    }).catch(() => {
      grid.hidden = true
      if (fallback) fallback.hidden = false
      feed.setAttribute("aria-busy", "false")
    })
  })
</script>

<style>
  /* A poster wall rather than a list: the artwork is what a film is
     recognised by, so it takes the width and the words sit under it. The
     wall sizes itself against its own column (see Uses.astro for why a
     viewport query would be wrong between 64rem and 76rem): three across
     on a phone, four once the column has room. */
  movies-feed {
    display: block;
    container-type: inline-size;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m) var(--space-xs);

    /* Two full rows either way: six posters three across, eight four
       across. */
    > :global(:nth-child(n + 7)) {
      display: none;
    }

    @container (width >= 30rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));

      > :global(:nth-child(n + 7)) {
        display: block;
      }
    }
  }

  /* The card answers the pointer the way the Music rows do — a faint wash
     behind it — rather than moving: the artwork stays put. */
  movies-feed :global(.movie-link) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: calc(-1 * var(--space-3xs));
    padding: var(--space-3xs);
    border-radius: calc(var(--radius-lg) + var(--space-3xs));
    color: var(--foreground);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      transform 0.12s ease;
  }

  @media (hover: hover) {
    movies-feed :global(.movie-link:hover) {
      background-color: var(--muted);
    }
  }

  movies-feed :global(.movie-link:active) {
    transform: scale(0.985);
  }

  movies-feed :global(.poster) {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--muted);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 4px 12px -6px rgb(0 0 0 / 0.18);
  }

  /* An inset hairline, so a pale poster keeps its edge on a pale page
     without a border changing its size. */
  movies-feed :global(.poster::after) {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px
      color-mix(in oklab, var(--foreground) 12%, transparent);
    pointer-events: none;
  }

  movies-feed :global(.poster img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Solid, not frosted: a tag on artwork has to read on any poster. */
  movies-feed :global(.rewatch) {
    position: absolute;
    inset-block-start: var(--space-3xs);
    inset-inline-start: var(--space-3xs);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    background-color: var(--foreground);
    color: var(--background);
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  movies-feed :global(.meta) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  movies-feed :global(.title) {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-wrap: pretty;
    /* Two lines whatever the title needs, so the stars line up across a
       row and the skeleton reserves exactly what the card will take. */
    min-block-size: 2lh;
  }

  movies-feed :global(.year) {
    font-weight: var(--font-weight-normal);
    color: var(--muted-foreground);
  }

  movies-feed :global(.foot) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-block-size: 1lh;
    font-size: 0.75rem;
    justify-content: space-between;
    gap: var(--space-3xs);
  }

  movies-feed :global(.date) {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  movies-feed :global(.rating) {
    --score: 0;
    position: relative;
    inline-size: max-content;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--gray-6);
  }

  movies-feed :global(.rating::before) {
    content: "★★★★★";
  }

  movies-feed :global(.rating > span) {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: calc(var(--score) / 5 * 100%);
    overflow: hidden;
    color: var(--foreground);
  }

  movies-feed :global(.rating > span::before) {
    content: "★★★★★";
  }

  movies-feed :global([data-skeleton] .poster) {
    box-shadow: none;
  }

  movies-feed :global(.sk-title) {
    inline-size: 80%;
  }

  movies-feed :global(.sk-rating) {
    inline-size: 4.5em;
    block-size: 0.8em;
  }

  movies-feed :global(.sk-date) {
    inline-size: 3em;
    block-size: 0.7em;
  }
</style>
