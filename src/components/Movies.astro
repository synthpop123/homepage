---
import "@/styles/feed.css"
import { LETTERBOXD, MISC } from "@/consts"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = MISC.endpoint, limit = LETTERBOXD.limit } = Astro.props

const profileUrl = `https://letterboxd.com/${LETTERBOXD.username}/`
---

<movies-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <ol class="movies-grid">
    {Array.from({ length: limit }).map(() => (
        <li class="movie-card" data-skeleton aria-hidden="true">
          <div class="movie-link">
            <span class="poster" />
            <span class="meta">
              <span class="title"><span class="sk-line sk-title" /></span>
              <span class="foot">
                <span class="sk-line sk-rating" />
                <span class="sk-line sk-date" />
              </span>
            </span>
          </div>
        </li>
      ))}
  </ol>
  <p class="feed-fallback" hidden>
    Couldn’t load right now — browse them on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Letterboxd</a
    >.
  </p>
</movies-feed>

<script>
  import { mountMovies } from "@/lib/client/movies-feed"

  document.querySelectorAll<HTMLElement>("movies-feed").forEach(mountMovies)
</script>

<style>
  /* A poster wall rather than a list: the artwork is what a film is
     recognised by, so it takes the width and the words sit under it. The
     wall sizes itself against its own column (see Uses.astro for why a
     viewport query would be wrong): three across
     on a phone, four once the column has room. */
  movies-feed {
    display: block;
    container-type: inline-size;
  }

  /* Each card spans three of the wall's rows (poster, title, foot) and
     lays its parts on them through subgrid, so a row's titles all take
     the height of its longest and the stars under them stay on one line,
     however many lines that is. */
  .movies-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m) var(--space-xs);

    > :global(.movie-card) {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: 0;
    }

    /* Two full rows either way: six posters three across, eight four
       across. */
    > :global(:nth-child(n + 7)) {
      display: none;
    }

    @container (width >= 30rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));

      > :global(:nth-child(n + 7)) {
        display: grid;
      }
    }
  }

  /* The card answers the pointer the way the Music rows do, a neutral 3
     wash behind it, its corner concentric with the poster's. */
  movies-feed :global(.movie-link) {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: var(--space-3xs);
    margin: calc(-1 * var(--space-3xs));
    padding: var(--space-3xs);
    border-radius: calc(var(--radius-md) + var(--space-3xs));
    color: var(--foreground);
    text-decoration: none;
  }

  @media (hover: hover) {
    movies-feed :global(.movie-link:hover) {
      background-color: var(--muted);
    }
  }

  movies-feed :global(.movie-link:active) {
    background-color: var(--muted-hover);
  }

  movies-feed :global(.poster) {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--muted);
    /* An inset hairline, so a pale poster keeps its edge on a pale page
       without a border changing its size. */
    outline: var(--hairline) solid var(--neutral-a6);
    outline-offset: calc(-1 * var(--hairline));
  }

  movies-feed :global(.poster img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Solid, not frosted: a tag on artwork has to read on any poster. Its
     corner is the poster's less the inset (6px = 2px + 4px), so the two
     curves run parallel. A rewatch takes the top corner, the year the
     bottom one. */
  movies-feed :global(.tag) {
    position: absolute;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-xs);
    background-color: var(--foreground);
    color: var(--background);
    font-size: var(--step--2);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
    font-feature-settings: var(--font-label-features);
  }

  movies-feed :global(.rewatch) {
    inset-block-start: 0.25rem;
    inset-inline-start: 0.25rem;
  }

  /* The year is on every poster, so it is a quieter stamp than the
     rewatch: Radix Black A8 under White A12 in both schemes, which still
     reads on a pale poster and does not light up a dark page. */
  movies-feed :global(.year) {
    inset-block-end: 0.25rem;
    inset-inline-end: 0.25rem;
    background-color: var(--black-a8);
    color: var(--white-a12);
    font-weight: var(--font-weight-normal);
    font-variant-numeric: tabular-nums;
  }

  /* The title and foot take the card's second and third rows. */
  movies-feed :global(.meta) {
    display: contents;
  }

  /* Up to four lines, shared by the head and, after a break and a size
     down, its subtitle: the clamp counts both, so the subtitle has what
     the head leaves. Two at least, so a wall of short titles keeps the
     height the skeleton reserved. */
  movies-feed :global(.title) {
    display: -webkit-box;
    overflow: hidden;
    margin-block-start: calc(var(--space-2xs) - var(--space-3xs));
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    text-wrap: pretty;
    min-block-size: 2lh;
  }

  movies-feed :global(.sub) {
    font-size: var(--step--2);
    font-weight: var(--font-weight-normal);
    color: var(--muted-foreground);
  }

  /* Held to the top of its row, which a neighbour's wrapped foot can
     make taller than this one. */
  movies-feed :global(.foot) {
    display: flex;
    align-self: start;
    flex-wrap: wrap;
    align-items: center;
    min-block-size: 1lh;
    font-size: var(--step--2);
    justify-content: space-between;
    gap: var(--space-3xs);
  }

  movies-feed :global(.date) {
    font-size: var(--step--2);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  movies-feed :global(.rating) {
    --score: 0;
    position: relative;
    inline-size: max-content;
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--neutral-6);
  }

  movies-feed :global(.rating::before) {
    content: "★★★★★";
  }

  movies-feed :global(.rating > span) {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: calc(var(--score) / 5 * 100%);
    overflow: hidden;
    color: var(--foreground);
  }

  movies-feed :global(.rating > span::before) {
    content: "★★★★★";
  }

  movies-feed :global(.sk-title) {
    inline-size: 80%;
  }

  movies-feed :global(.sk-rating) {
    inline-size: 4.5em;
    block-size: 0.8em;
  }

  movies-feed :global(.sk-date) {
    inline-size: 3em;
    block-size: 0.7em;
  }
</style>
