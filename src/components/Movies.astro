---
import "@/styles/feed.css"
import { LETTERBOXD, MISC } from "@/consts"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = MISC.endpoint, limit = LETTERBOXD.limit } = Astro.props

const profileUrl = `https://letterboxd.com/${LETTERBOXD.username}/`
---

<movies-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <ol class="movies-grid">
    {Array.from({ length: limit }).map(() => (
        <li class="movie-card" data-skeleton aria-hidden="true">
          <div class="movie-link">
            <span class="poster" />
            <span class="meta">
              <span class="title"><span class="sk-line sk-title" /></span>
              <span class="foot">
                <span class="sk-line sk-rating" />
                <span class="sk-line sk-date" />
              </span>
            </span>
          </div>
        </li>
      ))}
  </ol>
  <p class="movies-fallback" hidden>
    Couldn’t load right now — browse them on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Letterboxd</a
    >.
  </p>
</movies-feed>

<script>
  import { mountMovies } from "@/lib/client/movies-feed"

  document.querySelectorAll<HTMLElement>("movies-feed").forEach(mountMovies)
</script>

<style>
  /* A poster wall rather than a list: the artwork is what a film is
     recognised by, so it takes the width and the words sit under it. The
     wall sizes itself against its own column (see Uses.astro for why a
     viewport query would be wrong between 64rem and 76rem): three across
     on a phone, four once the column has room. */
  movies-feed {
    display: block;
    container-type: inline-size;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m) var(--space-xs);

    /* Two full rows either way: six posters three across, eight four
       across. */
    > :global(:nth-child(n + 7)) {
      display: none;
    }

    @container (width >= 30rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));

      > :global(:nth-child(n + 7)) {
        display: block;
      }
    }
  }

  /* The card answers the pointer the way the Music rows do, a neutral 3
     wash behind it, its corner concentric with the poster's. */
  movies-feed :global(.movie-link) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: calc(-1 * var(--space-3xs));
    padding: var(--space-3xs);
    border-radius: calc(var(--radius-md) + var(--space-3xs));
    color: var(--foreground);
    text-decoration: none;
  }

  @media (hover: hover) {
    movies-feed :global(.movie-link:hover) {
      background-color: var(--muted);
    }
  }

  movies-feed :global(.movie-link:active) {
    background-color: var(--muted-hover);
  }

  movies-feed :global(.poster) {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--muted);
    /* An inset hairline, so a pale poster keeps its edge on a pale page
       without a border changing its size. */
    outline: var(--hairline) solid var(--neutral-a6);
    outline-offset: calc(-1 * var(--hairline));
  }

  movies-feed :global(.poster img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Solid, not frosted: a tag on artwork has to read on any poster. */
  movies-feed :global(.rewatch) {
    position: absolute;
    inset-block-start: var(--space-3xs);
    inset-inline-start: var(--space-3xs);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    background-color: var(--foreground);
    color: var(--background);
    font-size: var(--step--2);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
    font-feature-settings: var(--font-label-features);
  }

  movies-feed :global(.meta) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  movies-feed :global(.title) {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-wrap: pretty;
    /* Two lines whatever the title needs, so the stars line up across a
       row and the skeleton reserves exactly what the card will take. */
    min-block-size: 2lh;
  }

  movies-feed :global(.year) {
    font-weight: var(--font-weight-normal);
    color: var(--muted-foreground);
  }

  movies-feed :global(.foot) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-block-size: 1lh;
    font-size: var(--step--2);
    justify-content: space-between;
    gap: var(--space-3xs);
  }

  movies-feed :global(.date) {
    font-size: var(--step--2);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  movies-feed :global(.rating) {
    --score: 0;
    position: relative;
    inline-size: max-content;
    font-size: var(--step--2);
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--neutral-6);
  }

  movies-feed :global(.rating::before) {
    content: "★★★★★";
  }

  movies-feed :global(.rating > span) {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: calc(var(--score) / 5 * 100%);
    overflow: hidden;
    color: var(--foreground);
  }

  movies-feed :global(.rating > span::before) {
    content: "★★★★★";
  }

  movies-feed :global(.sk-title) {
    inline-size: 80%;
  }

  movies-feed :global(.sk-rating) {
    inline-size: 4.5em;
    block-size: 0.8em;
  }

  movies-feed :global(.sk-date) {
    inline-size: 3em;
    block-size: 0.7em;
  }
</style>
