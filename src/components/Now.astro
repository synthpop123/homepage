---
import Claude from "@/assets/icons/ai/claude.svg"
import Spotify from "@/assets/icons/spotify.svg"
import { NOW } from "@/consts"

type Props = {
  endpoint?: string
}

const { endpoint = NOW.endpoint } = Astro.props
---

{/* A bento of four tiles from one small payload (/now/site): the listen
    across the top as a record half out of its sleeve, the poster standing
    two rows tall beside or under it, and the two tiles that are a figure,
    today's tokens and the last flight, filling the corner they leave.
    Every tile's size comes from the grid, the sleeve and the poster's
    aspect ratio, never from what loads into it, so the skeleton and the
    loaded section are the same height. */}
<now-feed data-endpoint={endpoint} aria-busy="true">
  <ul class="now-grid">
    <li class="now-tile" data-tile="listen">
      <a class="now-link" target="_blank" rel="noopener noreferrer">
        <span class="now-mark" aria-hidden="true"><Spotify /></span>
        <span class="sleeve" aria-hidden="true">
          <span class="disc"
            ><span class="disc-label"
              ><img alt="" width="64" height="64" hidden></span
            ></span
          >
          <span class="cover"
            ><img alt="" width="300" height="300" hidden></span
          >
        </span>
        <span class="now-body">
          <span class="now-label">Listening</span>
          <span class="now-title"><span class="sk-line sk-title"></span></span>
          <span class="now-sub"><span class="sk-line sk-sub"></span></span>
          <span class="now-foot"><span class="sk-line sk-foot"></span></span>
        </span>
      </a>
    </li>
    <li class="now-tile" data-tile="film">
      <a class="now-link" target="_blank" rel="noopener noreferrer">
        <span class="now-art"
          ><img alt="" width="320" height="480" hidden></span
        >
        <span class="now-body">
          <span class="now-label">Watched</span>
          <span class="now-title"><span class="sk-line sk-title"></span></span>
          <span class="now-foot"><span class="sk-line sk-foot"></span></span>
        </span>
      </a>
    </li>
    <li class="now-tile" data-tile="tokens">
      <a class="now-link" href="/tokens">
        <span class="now-mark" aria-hidden="true"><Claude /></span>
        <span class="now-label">Tokens today</span>
        <span class="now-figure"><span class="sk-line sk-figure"></span></span>
        <span class="now-foot"><span class="sk-line sk-foot"></span></span>
      </a>
    </li>
    <li class="now-tile" data-tile="flight">
      <a class="now-link" href="/misc#flights">
        <span class="now-label">Last flight<time class="now-when"></time></span>
        <span class="now-figure now-route">
          <b data-end="from"><span class="sk-line sk-code"></span></b>
          <span class="now-track" aria-hidden="true">
            <svg viewBox="-13 -11 26 22">
              <path
                d="M13 0 11 -1.6 3 -2 -3 -10 -6 -10 -2.5 -2 -8 -2 -10.5 -5.5 -12.5 -5.5 -11 0 -12.5 5.5 -10.5 5.5 -8 2 -2.5 2 -6 10 -3 10 3 2 11 1.6Z"
              ></path>
            </svg>
          </span>
          <b data-end="to"><span class="sk-line sk-code"></span></b>
        </span>
        <span class="now-foot"><span class="sk-line sk-foot"></span></span>
      </a>
    </li>
  </ul>
</now-feed>

<script>
  import { el } from "@/lib/client/dom"
  import { dateFormatter } from "@/lib/client/feed"
  import { isPlaying } from "@/lib/client/music"
  import {
    ago,
    flightFoot,
    flightTitle,
    flownLabel,
    loadSite,
    type Site,
    tokensFoot,
    watchedLabel,
  } from "@/lib/client/now"
  import { setReadout } from "@/lib/client/readout"
  import { formatTokens } from "@/lib/client/tokens/format"
  import { pauseOffscreen } from "@/lib/client/vinyl"

  const exact = new Intl.DateTimeFormat("en-US", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Asia/Shanghai",
  })

  /** A time element whose text is relative and whose title is exact. */
  const setTime = (time: HTMLTimeElement, at: string, text: string) => {
    time.dateTime = at
    time.textContent = text
    time.title = exact.format(new Date(at))
  }

  /** Swap an image only when its source moved, so a repaint with the
   *  same payload never flashes the artwork. */
  const setImage = (img: HTMLImageElement | null, src: string | null) => {
    if (!img) return
    img.hidden = !src
    if (src && img.getAttribute("src") !== src) img.src = src
  }

  const empty = (tile: HTMLElement, what: string) => {
    tile.dataset.empty = ""
    tile.querySelector("a")?.removeAttribute("href")
    tile.querySelector("a")?.removeAttribute("title")
    tile.querySelector(".now-title, .now-figure")?.replaceChildren(what)
    for (const extra of tile.querySelectorAll(".now-sub, .now-foot"))
      extra.replaceChildren()
  }

  const text = (tile: HTMLElement, selector: string, value: string) => {
    tile.querySelector(selector)?.replaceChildren(value)
  }

  function renderListen(tile: HTMLElement, site: Site, now: number) {
    const listen = site.listen
    if (!listen) return empty(tile, "Nothing yet")
    delete tile.dataset.empty
    const link = tile.querySelector("a")!
    link.href = listen.url
    // The cover, and the record's label printed with the same art.
    setImage(
      tile.querySelector(".cover img"),
      listen.cover.medium ?? listen.cover.small,
    )
    setImage(
      tile.querySelector(".disc-label img"),
      listen.cover.small ?? listen.cover.medium,
    )
    const playing = isPlaying(listen.at, now)
    tile.toggleAttribute("data-playing", playing)
    text(tile, ".now-label", playing ? "Now playing" : "Listening")
    text(tile, ".now-title", listen.title)
    text(tile, ".now-sub", listen.artists.join(", "))
    const time = el("time") as HTMLTimeElement
    setTime(time, listen.at, ago(listen.at, now))
    tile.querySelector(".now-foot")?.replaceChildren(time)
  }

  function renderFilm(tile: HTMLElement, site: Site) {
    const film = site.film
    if (!film) return empty(tile, "Nothing yet")
    delete tile.dataset.empty
    tile.querySelector("a")!.href = film.url
    setImage(tile.querySelector("img"), film.poster)
    text(tile, ".now-label", film.rewatch ? "Rewatched" : "Watched")
    const title = el("span", undefined, film.title)
    if (film.year) title.append(" ", el("span", "now-year", String(film.year)))
    tile.querySelector(".now-title")?.replaceChildren(title)

    const foot: Node[] = []
    if (film.rating !== null) {
      const rating = el("span", "now-rating")
      rating.style.setProperty("--score", String(film.rating))
      rating.setAttribute("role", "img")
      rating.setAttribute("aria-label", `${film.rating} out of 5 stars`)
      rating.append(el("span"))
      foot.push(rating)
    }
    const time = el(
      "time",
      undefined,
      watchedLabel(film.watched, site.today),
    ) as HTMLTimeElement
    time.dateTime = film.watched
    time.title = dateFormatter.format(
      new Date(`${film.watched}T00:00:00+08:00`),
    )
    foot.push(time)
    tile.querySelector(".now-foot")?.replaceChildren(...foot)
  }

  /** Runs as spans: a narrow tile wraps between them, never inside one. */
  const runs = (tile: HTMLElement, values: string[]) =>
    tile
      .querySelector(".now-foot")
      ?.replaceChildren(...values.map((run) => el("span", undefined, run)))

  function renderTokens(tile: HTMLElement, site: Site) {
    const tokens = site.tokens
    if (!tokens) return empty(tile, "—")
    delete tile.dataset.empty
    tile.querySelector("a")?.setAttribute("href", "/tokens")
    const figure = tile.querySelector<HTMLElement>(".now-figure")
    if (figure) setReadout(figure, formatTokens(tokens.tokens))
    runs(tile, tokensFoot(tokens))
  }

  function renderFlight(tile: HTMLElement, site: Site, track: Element) {
    const flight = site.flight
    const when = tile.querySelector<HTMLTimeElement>(".now-when")
    if (!flight) {
      when?.replaceChildren()
      return empty(tile, "—")
    }
    delete tile.dataset.empty
    const link = tile.querySelector("a")!
    link.setAttribute("href", "/misc#flights")
    link.title = flightTitle(flight)
    if (when) {
      when.dateTime = flight.date
      when.textContent = flownLabel(flight.date, site.today)
    }
    tile
      .querySelector(".now-figure")
      ?.replaceChildren(
        el("b", undefined, flight.from.code),
        track,
        el("b", undefined, flight.to.code),
      )
    runs(tile, flightFoot(flight))
  }

  document.querySelectorAll<HTMLElement>("now-feed").forEach((feed) => {
    const endpoint = feed.dataset.endpoint
    if (!endpoint) return
    const tile = (name: string) =>
      feed.querySelector<HTMLElement>(`[data-tile="${name}"]`)!

    // The track between the codes is markup, kept to put back between
    // whichever codes the payload names.
    const track = feed.querySelector(".now-track")!
    const spin = pauseOffscreen()
    const disc = feed.querySelector(".disc")
    if (disc) spin.observe(disc)

    let last: Site | null = null
    const render = (site: Site) => {
      const now = Date.now()
      renderListen(tile("listen"), site, now)
      renderFilm(tile("film"), site)
      renderTokens(tile("tokens"), site)
      renderFlight(tile("flight"), site, track)
      feed.setAttribute("aria-busy", "false")
      last = site
    }

    loadSite(endpoint, render).catch(() => {
      // Nothing cached and nothing answered: a home page has no reason to
      // explain a backend, so the section steps aside.
      feed.closest("section")?.setAttribute("hidden", "")
    })

    // "3m ago" is only true for a minute; keep it honest while the tab is
    // open without asking the network again.
    setInterval(() => {
      if (last && document.visibilityState === "visible") render(last)
    }, 60_000)
  })
</script>

<style is:global>
  /* Global and nested under the element: the tiles' insides are built at
     runtime, where Astro's scoped styles cannot see them. */
  now-feed {
    --now-flight: light-dark(#e2700b, #ffb547);
    display: block;
    container-type: inline-size;

    /* Phone: two columns. The listen across the top, then the poster in
       the first column standing the height of the tokens and the flight
       stacked in the second. From 34rem of column: three, the listen
       over the two small tiles and the poster beside all three. */
    .now-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: var(--space-xs);
      margin: 0;
      padding: 0;
      list-style: none;

      [data-tile="listen"] {
        grid-column: 1 / -1;
      }

      [data-tile="film"] {
        grid-row: span 2;
      }

      @container (width >= 34rem) {
        /* The poster's column a little narrower: at a full third it
           stands so tall that the small tiles beside it are mostly air. */
        grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 0.8fr);
        grid-template-rows: auto 1fr;

        [data-tile="listen"] {
          grid-column: 1 / 3;
          grid-row: 1;
        }

        [data-tile="film"] {
          grid-column: 3;
          grid-row: 1 / 3;
        }

        [data-tile="tokens"] {
          grid-column: 1;
          grid-row: 2;
        }

        [data-tile="flight"] {
          grid-column: 2;
          grid-row: 2;
        }
      }
    }

    .now-tile {
      display: grid;
      min-inline-size: 0;
      margin: 0;
      padding: 0;
    }

    /* One surface for every tile: a soft fill and a round corner, no
       border, so the grid reads as one object cut into parts. */
    .now-link {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      min-inline-size: 0;
      padding: var(--space-s);
      overflow: hidden;
      border-radius: var(--radius-xl);
      background-color: color-mix(in oklab, var(--muted) 60%, transparent);
      color: var(--foreground);
      text-decoration: none;
      isolation: isolate;
      transition: background-color 0.15s ease;
    }

    @media (hover: hover) {
      .now-link[href]:hover {
        background-color: var(--muted);
      }
    }

    /* A brand mark as the tile's backdrop, large, faint and cropped by its
       corner, the way the quota and Uses cards carry theirs. */
    .now-mark {
      position: absolute;
      z-index: -1;
      inset-block-end: -1.5rem;
      inset-inline-end: -1.25rem;
      font-size: 7rem;
      line-height: 0;
      color: color-mix(in oklab, var(--mark) 10%, transparent);
      pointer-events: none;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    [data-tile="listen"] .now-mark {
      --mark: light-dark(#1db954, #1ed760);
    }

    [data-tile="tokens"] .now-mark {
      --mark: #d97757;
      font-size: 6rem;
    }

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .now-link[href]:hover .now-mark {
        transform: rotate(-8deg) scale(1.04);
      }
    }

    .now-label {
      display: flex;
      justify-content: space-between;
      gap: var(--space-2xs);
      font-size: 0.6875rem;
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    .now-when {
      letter-spacing: 0;
      text-transform: none;
      font-weight: var(--font-weight-normal);
      font-variant-numeric: tabular-nums;
    }

    .now-title {
      display: -webkit-box;
      overflow: hidden;
      font-weight: var(--font-weight-medium);
      line-height: 1.3;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      text-wrap: pretty;
    }

    .now-sub,
    .now-foot {
      min-block-size: 1lh;
      overflow: hidden;
      font-size: var(--step--1);
      color: var(--muted-foreground);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .now-foot {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
      font-variant-numeric: tabular-nums;
    }

    /* Listen: the record half out of its sleeve (.sleeve, feed.css, the
       same one the Music lead on /misc uses), the words beside it. */
    [data-tile="listen"] {
      .now-link {
        flex-direction: row;
        align-items: center;
        gap: var(--space-s);
      }

      .sleeve {
        --sleeve: 5.5rem;

        @container (width >= 34rem) {
          --sleeve: 6.5rem;
        }
      }

      .now-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--space-3xs);
        min-inline-size: 0;
      }

      .now-title {
        @container (width >= 34rem) {
          font-size: var(--step-1);
          line-height: 1.25;
        }
      }

      &[data-playing] .now-label::before {
        content: "";
        order: -1;
        inline-size: 0.5rem;
        block-size: 0.5rem;
        margin-block: auto;
        border-radius: var(--radius-full);
        background-color: light-dark(#30a14e, #3dd68c);
      }

      &[data-playing] .now-label {
        justify-content: start;
        color: light-dark(#216e39, #3dd68c);
      }
    }

    /* Film: the poster is the tile, 2:3, with the words laid over its foot
       on a scrim, so the words cost the poster no height. */
    [data-tile="film"] {
      /* The poster sets the tile's height (2:3 of its width, held open by
         a spacer, since aspect-ratio on a stretched item would widen it
         instead) and fills whatever taller row the tile is stretched into. */
      .now-link {
        padding: 0;
        background-color: var(--muted);
      }

      .now-link::before {
        content: "";
        padding-block-start: 150%;
      }

      .now-art {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background-color: var(--muted);

        img {
          inline-size: 100%;
          block-size: 100%;
          object-fit: cover;
          filter: saturate(0.6);
          transition: filter 0.3s ease;
        }

        /* A veil in the page's own colour, so the poster sits back among
           tiles of flat fill instead of outshouting them; it lifts on
           hover. */
        &::after {
          content: "";
          position: absolute;
          inset: 0;
          background-color: color-mix(
            in oklab,
            var(--background) 55%,
            transparent
          );
          transition: background-color 0.3s ease;
        }
      }

      @media (hover: hover) {
        .now-link[href]:hover .now-art {
          img {
            filter: none;
          }

          &::after {
            background-color: color-mix(
              in oklab,
              var(--background) 10%,
              transparent
            );
          }
        }
      }

      .now-body {
        position: absolute;
        inset: auto 0 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-xl) var(--space-s) var(--space-s);
        background-image: linear-gradient(
          to top,
          rgb(0 0 0 / 0.86),
          rgb(0 0 0 / 0.62) 50%,
          transparent
        );
        color: #fff;
      }

      .now-label,
      .now-foot,
      .now-year {
        color: rgb(255 255 255 / 0.78);
      }

      .now-year {
        font-weight: var(--font-weight-normal);
      }

      .sk-line {
        background-color: rgb(255 255 255 / 0.25);
      }

      /* An inset hairline, so a pale poster keeps its edge on a pale page. */
      .now-link::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: inset 0 0 0 1px
          color-mix(in oklab, var(--foreground) 12%, transparent);
        pointer-events: none;
      }

      /* No film: no poster to lay words over, so no scrim either. */
      &[data-empty] .now-body {
        background-image: none;
        color: var(--muted-foreground);

        .now-label {
          color: var(--muted-foreground);
        }
      }
    }

    .now-rating {
      --score: 0;
      position: relative;
      font-size: 0.8125rem;
      letter-spacing: 0.05em;
      line-height: 1;
      color: rgb(255 255 255 / 0.35);

      &::before {
        content: "★★★★★";
      }

      > span {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        inline-size: calc(var(--score) / 5 * 100%);
        overflow: hidden;
        color: #fff;

        &::before {
          content: "★★★★★";
        }
      }
    }

    /* The two small tiles: a label at the top, a figure and one line at
       the foot. Their runs (cost and messages, cities and distance) sit
       on one line where the tile has room and two where it does not,
       never one cut short. Every run carries its separator in front, in a
       strip the clip cuts away at the start of each line, so a wrapped
       run never begins with a stray dot. */
    :is([data-tile="tokens"], [data-tile="flight"]) .now-foot {
      flex-wrap: wrap;
      gap: 0;
      margin-inline-start: -0.9em;
      overflow: visible;
      white-space: normal;
      clip-path: inset(0 0 0 0.9em);

      span {
        position: relative;
        padding-inline-start: 0.9em;
        white-space: nowrap;
      }

      span::before {
        content: "·";
        position: absolute;
        inset-inline-start: 0;
        inline-size: 0.9em;
        text-align: center;
      }
    }

    .now-figure {
      min-block-size: 1lh;
      margin-block-start: auto;
      padding-block-start: var(--space-s);
      font-size: var(--step-2);
      font-weight: var(--font-weight-medium);
      font-variant-numeric: tabular-nums;
      line-height: 1.15;
      letter-spacing: -0.02em;
      white-space: nowrap;

      .unit {
        margin-inline: 0.05em;
        font-size: 0.56em;
        font-weight: var(--font-weight-normal);
        letter-spacing: 0;
        color: var(--muted-foreground);
      }
    }

    /* The flight: its two codes at either end of a dashed track, the
       plane half way, in the amber /misc draws the flights in. */
    .now-route {
      display: flex;
      align-items: center;
      gap: 0.3em;

      b {
        font-weight: inherit;
      }
    }

    .now-track {
      position: relative;
      flex: 1;
      min-inline-size: 1rem;
      block-size: 1rem;

      &::before {
        content: "";
        position: absolute;
        inset-inline: 0;
        inset-block-start: 50%;
        border-block-start: 1.5px dashed
          color-mix(in oklab, var(--muted-foreground) 60%, transparent);
      }

      svg {
        position: absolute;
        inset: 50% auto auto 50%;
        inline-size: 0.95rem;
        block-size: 0.95rem;
        translate: -50% -50%;
        fill: var(--now-flight);
        transition: translate 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
    }

    @media (hover: hover) {
      [data-tile="flight"] .now-link[href]:hover .now-track svg {
        translate: 20% -50%;
      }
    }

    [data-empty] :is(.now-title, .now-figure) {
      color: var(--muted-foreground);
      font-weight: var(--font-weight-normal);
    }

    .sk-line {
      display: block;
      block-size: 0.85em;
      margin-block: 0.2em;
      border-radius: var(--radius-sm);
      background-color: var(--gray-5);
      animation: var(--sk-pulse);
    }

    .sk-title {
      inline-size: 70%;
    }

    .sk-sub {
      inline-size: 45%;
    }

    .sk-foot {
      inline-size: 35%;
    }

    .sk-figure {
      inline-size: 3.5em;
      block-size: 0.8em;
    }

    .sk-code {
      inline-size: 1.8em;
      block-size: 0.8em;
    }
  }
</style>
