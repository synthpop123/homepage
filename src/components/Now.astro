---
import "@/styles/feed.css"
import Claude from "@/assets/icons/ai/claude.svg"
import Spotify from "@/assets/icons/spotify.svg"
import { NOW } from "@/consts"

type Props = {
  endpoint?: string
}

const { endpoint = NOW.endpoint } = Astro.props
---

{/* A bento of four tiles from one small payload (/now/site): the listen
    across the top as a record half out of its sleeve, the poster standing
    two rows tall beside it, today's tokens under the listen with the last
    two weeks as bars where the listen has its record (so the words of the
    two line up) and the week's busiest model under the figure, and the
    portfolio across the foot, its three months
    as a line over day cells. On a phone it folds to two columns, the
    poster beside the two figures and the charts reduced to a sparkline.
    Every tile's size comes from the grid, the sleeve, the poster's aspect
    ratio and fixed chart heights, never from what loads into it, so the
    skeleton and the loaded section are the same height. */}
<now-feed data-endpoint={endpoint} aria-busy="true">
  <ul class="now-grid">
    <li class="now-tile" data-tile="listen">
      <a class="now-link" target="_blank" rel="noopener noreferrer">
        <span class="now-mark" aria-hidden="true"><Spotify /></span>
        <span class="sleeve" aria-hidden="true">
          <span class="disc"
            ><span class="disc-label"
              ><img alt="" width="64" height="64" hidden></span
            ></span
          >
          <span class="cover"
            ><img alt="" width="300" height="300" hidden></span
          >
        </span>
        <span class="now-body">
          <span class="now-label">Listening</span>
          <span class="now-title"><span class="sk-line sk-title"></span></span>
          <span class="now-sub"><span class="sk-line sk-sub"></span></span>
          <span class="now-foot"><span class="sk-line sk-foot"></span></span>
        </span>
      </a>
    </li>
    <li class="now-tile" data-tile="film">
      <a class="now-link" target="_blank" rel="noopener noreferrer">
        <span class="now-art"
          ><img alt="" width="320" height="480" hidden></span
        >
        <span class="now-body">
          <span class="now-label">Watched</span>
          <span class="now-title"><span class="sk-line sk-title"></span></span>
          <span class="now-foot"><span class="sk-line sk-foot"></span></span>
        </span>
      </a>
    </li>
    <li class="now-tile" data-tile="tokens">
      <a class="now-link" href="/tokens">
        <span class="now-mark" aria-hidden="true"><Claude /></span>
        <span class="now-side">
          <span class="now-label">Tokens today</span>
          <span class="now-bars" aria-hidden="true">
            {Array.from({ length: 14 }, () => <i />)}
          </span>
        </span>
        <span class="now-info">
          <span class="now-figure"
            ><span class="sk-line sk-figure"></span></span
          >
          <span class="now-foot"><span class="sk-line sk-foot"></span></span>
          <span class="now-model"><span class="sk-line sk-model"></span></span>
        </span>
      </a>
    </li>
    <li class="now-tile" data-tile="portfolio">
      <a class="now-link" href="/misc#portfolio">
        <span class="now-info">
          <span class="now-label">Portfolio</span>
          <span class="now-figure"
            ><span class="sk-line sk-figure"></span></span
          >
          <span class="now-foot"><span class="sk-line sk-foot"></span></span>
        </span>
        <span class="now-chart" aria-hidden="true">
          <span class="now-plot">
            <svg
              class="now-spark"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
            ></svg>
            <span class="now-dot"></span>
          </span>
          <span class="now-strip"></span>
          <span class="now-axis"></span>
        </span>
      </a>
    </li>
  </ul>
</now-feed>

<script>
  import { mountNow } from "@/lib/client/now-feed"

  document.querySelectorAll<HTMLElement>("now-feed").forEach(mountNow)
</script>

<style is:global>
  /* Global and nested under the element: the tiles' insides are built at
     runtime, where Astro's scoped styles cannot see them. */
  now-feed {
    display: block;
    container-type: inline-size;

    /* Phone: two columns. The listen across the top, then the poster in
       the first column standing the height of the tokens and the
       portfolio stacked in the second. From 34rem of column: three, the
       listen over the tokens with the poster beside both, and the
       portfolio across all three under them. */
    .now-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
      gap: var(--space-xs);
      margin: 0;
      padding: 0;
      list-style: none;

      [data-tile="listen"] {
        grid-column: 1 / -1;
      }

      [data-tile="film"] {
        grid-row: span 2;
      }

      @container (width >= 34rem) {
        /* The poster's column a little narrower: at a full third it
           stands so tall that the small tiles beside it are mostly air. */
        grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 0.8fr);
        grid-template-rows: auto 1fr auto;

        [data-tile="listen"] {
          grid-column: 1 / 3;
          grid-row: 1;
        }

        [data-tile="film"] {
          grid-column: 3;
          grid-row: 1 / 3;
        }

        [data-tile="tokens"] {
          grid-column: 1 / 3;
          grid-row: 2;
        }

        [data-tile="portfolio"] {
          grid-column: 1 / -1;
          grid-row: 3;
        }
      }
    }

    .now-tile {
      display: grid;
      min-inline-size: 0;
      margin: 0;
      padding: 0;
    }

    /* One surface for every tile: a neutral 3 fill and an 8px corner, no
       border, so the grid reads as one object cut into parts. */
    .now-link {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      min-inline-size: 0;
      padding: var(--space-s);
      overflow: hidden;
      border-radius: var(--radius-lg);
      background-color: var(--muted);
      color: var(--foreground);
      text-decoration: none;
      isolation: isolate;
    }

    @media (hover: hover) {
      .now-link[href]:hover {
        background-color: var(--muted-hover);
      }
    }

    .now-link[href]:active {
      background-color: var(--muted-active);
    }

    /* A brand mark as the tile's backdrop, large, faint and cropped by its
       corner, the way the quota and Uses cards carry theirs: the brand's
       colour at 10%. */
    .now-mark {
      position: absolute;
      z-index: -1;
      inset-block-end: -1.5rem;
      inset-inline-end: -1.25rem;
      font-size: 7rem;
      line-height: 0;
      color: var(--mark);
      opacity: 0.1;
      pointer-events: none;
    }

    [data-tile="listen"] .now-mark {
      --mark: var(--brand-spotify);
    }

    [data-tile="tokens"] .now-mark {
      --mark: var(--brand-claude);
      font-size: 6rem;
    }

    .now-label {
      display: flex;
      justify-content: space-between;
      gap: var(--space-2xs);
      font-size: var(--step--2);
      font-weight: var(--font-weight-medium);
      letter-spacing: var(--tracking-label);
      line-height: 1.4;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    .now-title {
      display: -webkit-box;
      overflow: hidden;
      font-weight: var(--font-weight-medium);
      line-height: 1.3;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      text-wrap: pretty;
    }

    .now-sub,
    .now-foot {
      min-block-size: 1lh;
      overflow: hidden;
      font-size: var(--step--1);
      color: var(--muted-foreground);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .now-foot {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
      font-variant-numeric: tabular-nums;
    }

    /* Listen: the record half out of its sleeve (.sleeve, feed.css, the
       same one the Music lead on /misc uses), the words beside it. */
    [data-tile="listen"] {
      .now-link {
        flex-direction: row;
        align-items: center;
        gap: var(--space-s);
      }

      .sleeve {
        --sleeve: 5.5rem;

        @container (width >= 34rem) {
          --sleeve: 6.5rem;
        }
      }

      .now-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: var(--space-3xs);
        min-inline-size: 0;
      }

      &[data-playing] .now-label::before {
        content: "";
        order: -1;
        inline-size: 0.5rem;
        block-size: 0.5rem;
        margin-block: auto;
        border-radius: var(--radius-full);
        background-color: var(--accent-fill);
      }

      &[data-playing] .now-label {
        justify-content: start;
        color: var(--accent);
      }
    }

    /* Film: the poster is the tile, 2:3, with the words laid over its foot
       on a scrim, so the words cost the poster no height. */
    [data-tile="film"] {
      /* The poster sets the tile's height (2:3 of its width, held open by
         a spacer, since aspect-ratio on a stretched item would widen it
         instead) and fills whatever taller row the tile is stretched into. */
      .now-link {
        padding: 0;
        background-color: var(--muted);
      }

      .now-link::before {
        content: "";
        padding-block-start: 150%;
      }

      .now-art {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background-color: var(--muted);

        img {
          inline-size: 100%;
          block-size: 100%;
          object-fit: cover;
        }

        /* Keep the poster's original colours on a light page. Only the
           dark scheme needs a veil (Radix Black A5) to temper its
           brightness; the foot's scrim gives the words their contrast in
           both schemes. */
        &::after {
          content: "";
          position: absolute;
          inset: 0;
          background-color: light-dark(transparent, var(--black-a5));
        }
      }

      .now-body {
        position: absolute;
        inset: auto 0 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3xs);
        padding: var(--space-xl) var(--space-s) var(--space-s);
        /* Radix Black A10 to A8; the words in White and White A10. */
        background-image: linear-gradient(
          to top,
          var(--black-a10),
          var(--black-a8) 50%,
          transparent
        );
        color: white;
      }

      .now-label,
      .now-foot,
      .now-year {
        color: var(--white-a10);
      }

      .now-year {
        font-weight: var(--font-weight-normal);
      }

      .sk-line {
        background-color: var(--white-a4);
      }

      /* An inset hairline, so a pale poster keeps its edge on a pale page. */
      .now-link {
        outline: var(--hairline) solid var(--neutral-a6);
        outline-offset: calc(-1 * var(--hairline));
      }

      /* No film: no poster to lay words over, so no scrim either. */
      &[data-empty] .now-body {
        background-image: none;
        color: var(--muted-foreground);

        .now-label {
          color: var(--muted-foreground);
        }
      }
    }

    .now-rating {
      --score: 0;
      position: relative;
      font-size: var(--step--2);
      letter-spacing: 0.05em;
      line-height: 1;
      color: var(--white-a6);

      &::before {
        content: "★★★★★";
      }

      > span {
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        inline-size: calc(var(--score) / 5 * 100%);
        overflow: hidden;
        color: white;

        &::before {
          content: "★★★★★";
        }
      }
    }

    /* The two figure tiles: a label at the top, a figure and one line at
       the foot. Their runs (cost and messages) sit on one line where the
       tile has room and two where it does not, never one cut short; the
       space between them is the only separator. */
    :is([data-tile="tokens"], [data-tile="portfolio"]) .now-foot {
      flex-wrap: wrap;
      gap: 0 var(--space-xs);
      overflow: visible;
      white-space: normal;

      span {
        white-space: nowrap;
      }
    }

    .now-figure {
      min-block-size: 1lh;
      margin-block-start: auto;
      padding-block-start: var(--space-s);
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      font-variant-numeric: tabular-nums;
      line-height: 1.2;
      letter-spacing: var(--tracking-figure);
      white-space: nowrap;

      .unit {
        margin-inline: 0.1em;
        font-size: var(--step--1);
        font-weight: var(--font-weight-normal);
        letter-spacing: 0;
        color: var(--muted-foreground);
      }
    }

    /* A return's sign is its colour, as on /misc: the text-grade green
       up, muted ink and a true minus down. The sign itself is set at the
       figure's size, not as a unit. */
    .now-figure[data-dir="up"] {
      color: var(--accent);
    }

    .now-figure[data-dir="down"] {
      color: var(--muted-foreground);
    }

    .now-figure[data-dir] .unit {
      color: inherit;
    }

    .now-figure[data-dir] .unit:first-child {
      margin-inline: 0 0.02em;
      font-size: inherit;
      font-weight: inherit;
    }

    /* The words of a figure tile, and beside them (from 34rem) a chart. */
    .now-info {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: var(--space-3xs);
      min-inline-size: 0;
    }

    /* Tokens: the label over the last two weeks as bars, today's in the
       accent, in a column as wide as the listen's sleeve (feed.css'
       --sleeve at this width, times its 1.45), so the words of the two
       tiles start on one line; the figure, its runs and the week's
       busiest model on the right. The bars only where the tile runs
       across two columns. */
    .now-side {
      display: flex;
      flex-direction: column;
      min-inline-size: 0;
    }

    /* Two lines on a phone's narrow tile rather than a cut name; one,
       cut if it must be, beside the bars. */
    .now-model {
      display: block;
      min-block-size: 1lh;
      overflow: hidden;
      font-size: var(--step--1);
      color: var(--foreground);
      text-overflow: ellipsis;
      font-variant-numeric: tabular-nums;

      @container (width >= 34rem) {
        white-space: nowrap;
      }
    }

    .sk-model {
      inline-size: 60%;
    }

    .now-bars {
      display: none;
      flex: 1;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      align-items: end;
      gap: 3px;
      padding-block-start: var(--space-xs);

      i {
        display: block;
        block-size: max(2px, calc(var(--bar, 0.08) * 100%));
        border-radius: var(--radius-xs) var(--radius-xs) 0 0;
        background-color: var(--neutral-6);
      }

      i:last-child {
        background-color: var(--accent-fill);
      }
    }

    /* Portfolio: one ink line with the S&P 500 as a dashed ghost rebased
       onto it, a dot on the latest session; from 34rem the same days as
       cells under it and the axis' two ends. On a phone, the line alone
       under the figure. */
    .now-chart {
      display: grid;
      grid-template-rows: auto;
      gap: var(--space-2xs);
      min-inline-size: 0;
      margin-block-start: var(--space-2xs);
    }

    .now-plot {
      position: relative;
      display: block;
      block-size: 1.75rem;
    }

    .now-spark {
      inline-size: 100%;
      block-size: 100%;
      overflow: visible;
    }

    .now-line,
    .now-ghost,
    .now-base {
      fill: none;
      vector-effect: non-scaling-stroke;
    }

    .now-line {
      stroke: var(--foreground);
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .now-ghost {
      stroke: var(--neutral-9);
      stroke-dasharray: 2.5 2.5;
      stroke-width: 1;
    }

    .now-area {
      fill: var(--neutral-a3);
    }

    .now-base {
      stroke: var(--neutral-a6);
      stroke-width: var(--hairline);
    }

    .now-dot {
      position: absolute;
      inset-block-start: var(--end, 50%);
      inset-inline-start: 100%;
      inline-size: 7px;
      block-size: 7px;
      border-radius: var(--radius-full);
      background-color: var(--foreground);
      outline: 2px solid var(--background);
      translate: -50% -50%;

      &[data-dir="up"] {
        background-color: var(--accent-fill);
      }
    }

    [aria-busy="true"] .now-dot,
    [data-empty] .now-dot {
      display: none;
    }

    .now-strip,
    .now-axis {
      display: none;
    }

    .now-strip {
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      gap: 2px;
      block-size: 0.6rem;

      i {
        border-radius: var(--radius-xs);
        background-color: var(--heat-0);
      }

      i[data-dir="up"][data-level="1"] {
        background-color: var(--heat-1);
      }

      i[data-dir="up"][data-level="2"] {
        background-color: var(--heat-2);
      }

      i[data-dir="up"][data-level="3"] {
        background-color: var(--heat-3);
      }

      i[data-dir="up"][data-level="4"] {
        background-color: var(--heat-4);
      }

      i[data-dir="down"][data-level="1"] {
        background-color: var(--down-1);
      }

      i[data-dir="down"][data-level="2"] {
        background-color: var(--down-2);
      }

      i[data-dir="down"][data-level="3"] {
        background-color: var(--down-3);
      }

      i[data-dir="down"][data-level="4"] {
        background-color: var(--down-4);
      }
    }

    .now-axis {
      justify-content: space-between;
      gap: var(--space-s);
      min-block-size: 1lh;
      font-size: var(--step--2);
      line-height: 1.4;
      color: var(--muted-foreground);
      font-variant-numeric: tabular-nums;
    }

    /* The key sits between the two dates: a solid stroke for the
       portfolio, a dashed one for the benchmark. */
    .now-key {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;

      &::before {
        content: "";
        inline-size: 0.9rem;
        border-block-start: 1.5px solid var(--foreground);
      }
    }

    .now-keys {
      display: flex;
      gap: var(--space-s);
    }

    .now-key-ghost::before {
      border-block-start: 1px dashed var(--neutral-9);
    }

    @container (width >= 34rem) {
      [data-tile="tokens"] .now-link,
      [data-tile="portfolio"] .now-link {
        flex-direction: row;
        align-items: stretch;
        gap: var(--space-m);
      }

      [data-tile="tokens"] .now-link {
        gap: var(--space-s);
      }

      .now-side {
        flex: 0 0 calc(6.5rem * 1.45);
      }

      .now-bars {
        display: grid;
      }

      [data-tile="portfolio"] .now-info {
        flex: 0 0 10rem;
      }

      .now-chart {
        flex: 1;
        align-content: end;
        margin-block-start: 0;
      }

      .now-plot {
        block-size: 5.5rem;
      }

      .now-strip {
        display: grid;
      }

      .now-axis {
        display: flex;
      }
    }

    [data-empty] :is(.now-title, .now-figure) {
      color: var(--muted-foreground);
      font-weight: var(--font-weight-normal);
    }

    .sk-line {
      display: block;
      block-size: 0.85em;
      margin-block: 0.2em;
      border-radius: var(--radius-sm);
      background-color: var(--neutral-4);
    }

    .sk-title {
      inline-size: 70%;
    }

    .sk-sub {
      inline-size: 45%;
    }

    .sk-foot {
      inline-size: 35%;
    }

    .sk-figure {
      inline-size: 3.5em;
      block-size: 0.8em;
    }
  }
</style>
