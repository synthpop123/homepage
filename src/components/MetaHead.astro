---
import sansWoff2 from "@/assets/fonts/Geist-Variable.woff2?url"
import { SITE, UMAMI } from "@/consts"

// Mirrors --gray-1 (the page background) in src/styles/color.css.
const themeColor = { light: "#fcfcfc", dark: "#111111" }
---

<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  >
  <meta name="generator" content={Astro.generator}>

  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content={SITE.title}>
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  >

  {(["light", "dark"] as const).map((scheme) => (
    <meta
      name="theme-color"
      content={themeColor[scheme]}
      media={`(prefers-color-scheme: ${scheme})`}
      data-scheme={scheme}
    >
  ))}

  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="sitemap" href="/sitemap-index.xml">
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", Astro.site)}
  >

  <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin>

  <script is:inline define:vars={{ themeColor }}>
    const root = document.documentElement
    try {
      const theme = localStorage.theme
      if (theme === "light" || theme === "dark") root.dataset.theme = theme
    } catch {}
    // A chosen theme overrides the system's, so the browser's own chrome
    // follows it: both theme-color entries take the chosen colour.
    const paint = () => {
      for (const meta of document.querySelectorAll('meta[name="theme-color"]'))
        meta.content = themeColor[root.dataset.theme ?? meta.dataset.scheme]
    }
    paint()
    new MutationObserver(paint).observe(root, {
      attributeFilter: ["data-theme"],
    })
  </script>

  {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src={UMAMI.src}
        data-website-id={UMAMI.websiteId}
        data-host-url={UMAMI.hostUrl}
        data-performance={`${UMAMI.performance}`}
      />
    )}

  <slot />
</head>
