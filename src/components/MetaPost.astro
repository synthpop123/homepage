---
import { getEntries, type CollectionEntry } from "astro:content"
import MetaOpenGraph from "@/components/MetaOpenGraph.astro"
import { pageTitle, postLang } from "@/lib/content"
import { jsonForScript } from "@/lib/utils"

type Props = {
  post: CollectionEntry<"blog">
  canonical?: string
}

const { post, canonical: canonicalPath } = Astro.props
const { title, description, date, updatedDate, image } = post.data

const base = Astro.site ?? new URL(Astro.url.origin)
const authors = await getEntries(post.data.authors)
const authorNames = authors.map((author) => author.data.name)
// The first author with an X account, as `@handle`.
const xProfile = authors.find((author) => author.data.socials?.twitter)?.data
  .socials?.twitter
const creator = xProfile && `@${new URL(xProfile).pathname.split("/")[1]}`
const url = new URL(Astro.url.pathname, base)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base)
const ogImage = image
  ? new URL(image.src, base)
  : new URL(`/og/blog/${post.id}.png`, base)

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  image: ogImage.href,
  datePublished: date.toISOString(),
  dateModified: (updatedDate ?? date).toISOString(),
  author: authors.map((author) => ({
    "@type": "Person",
    name: author.data.name,
    url: new URL("/about", base).href,
  })),
}
---

<title>{pageTitle(title)}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link
  rel="alternate"
  type="text/markdown"
  href={new URL(`/blog/${post.id}.md`, base)}
  title={`${title} (Markdown)`}
>

<MetaOpenGraph
  title={title}
  description={description}
  url={url}
  type="article"
  locale={postLang(post)}
  image={ogImage}
/>
{creator && <meta name="twitter:creator" content={creator} />}

<meta property="article:published_time" content={date.toISOString()}>
{updatedDate && (
    <meta property="article:modified_time" content={updatedDate.toISOString()} />
  )}
{authorNames.map((name) => <meta property="article:author" content={name} />)}

<script is:inline type="application/ld+json" set:html={jsonForScript(jsonLd)} />
