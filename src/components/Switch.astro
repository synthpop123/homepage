---
/**
 * Switch play activity from cf-workers-api's switch service, delivered in
 * the /misc bundle.
 *
 * The question this answers is "what am I actually playing", not "what did
 * I touch last" — so the list is the catalog ranked by lifetime play time,
 * and each row's bar carries the recent window inside the lifetime one.
 */

import "@/styles/feed.css"
import Heatmap from "@/components/Heatmap.astro"
import { MISC, SWITCH } from "@/consts"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = MISC.endpoint, limit = SWITCH.limit } = Astro.props

// Four slots, filled in order by the script — the third one names itself,
// since a library with no resolved prices has nothing to put there.
const stats = ["Playtime", "Games", "", "Per active day"]
---

<switch-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <div class="switch-body">
    <h3 class="switch-label">All-time stats</h3>
    <dl class="readout">
      {stats.map((label) => (
        <div class="stat">
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>
    <h3 class="switch-label">Activity</h3>
    <Heatmap />
    <h3 class="switch-label">Most played</h3>
    <ol class="switch-list">
      {Array.from({ length: limit }).map(() => (
        <li class="switch-item" data-skeleton aria-hidden="true">
          <span class="rank" />
          <span class="cover" />
          <span class="meta">
            <span class="title"><span class="sk-line sk-title" /></span>
            <span class="sub"><span class="sk-line sk-sub" /></span>
          </span>
          <span class="amount"><span class="sk-line sk-amount" /></span>
        </li>
      ))}
    </ol>
  </div>
  <p class="switch-fallback" hidden>
    Couldn't load the play activity right now.
  </p>
</switch-feed>

<script>
  import { mountSwitch } from "@/lib/client/switch-feed"

  document.querySelectorAll<HTMLElement>("switch-feed").forEach(mountSwitch)
</script>

<style>
  switch-feed {
    display: block;
  }

  /* The list is the chart: every row is a bar (see buildRow), so rows sit
     a hairline apart instead of being ruled, and a row is one line tall —
     a cover the height of title plus recency, the hours at the far end. */
  .switch-list {
    display: grid;
    gap: 2px;
  }

  switch-feed :global(.switch-item) {
    --total: 0%;
    --recent: 0%;
    --fill: color-mix(in oklab, var(--foreground) 7%, transparent);
    --fill-recent: color-mix(in oklab, var(--accent-fill) 34%, transparent);

    /* Positioned so the eShop link can stretch across the whole row. */
    position: relative;
    display: grid;
    grid-template-columns: 1.5em auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-3xs) var(--space-xs) var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-lg);
    background-image: linear-gradient(
      to right,
      var(--fill-recent) var(--recent),
      var(--fill) var(--recent) var(--total),
      transparent var(--total)
    );
    transition: background-color 0.15s ease;
  }

  @media (hover: hover) {
    switch-feed :global(.switch-item:hover) {
      background-color: color-mix(in oklab, var(--muted) 70%, transparent);
    }
  }

  switch-feed :global(.rank) {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    text-align: end;
  }

  switch-feed :global(.cover) {
    display: block;
    inline-size: 2.75rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  switch-feed :global(.cover img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  switch-feed :global(.meta) {
    display: grid;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  /* One line each: a long title gives way before the hours do, and the
     whole name is on hover. The row's height is the cover's either way,
     which is what lets the skeleton reserve it exactly. */
  switch-feed :global(:is(.title, .sub)) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  switch-feed :global(.title) {
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
  }

  switch-feed :global(.sub) {
    min-block-size: 1lh;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  switch-feed :global(.amount) {
    min-block-size: 1lh;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The eShop link covers the row rather than sitting in it — the whole
     row is the hit target — and stays transparent, so the bar under it
     shows through. Keyboard focus still has to be visible. */
  switch-feed :global(.shop) {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  switch-feed :global(.shop:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  switch-feed :global([data-skeleton] :is(.title, .sub, .amount)) {
    display: grid;
    align-content: center;
  }

  switch-feed :global([data-skeleton] .title) {
    min-block-size: 1lh;
  }

  switch-feed :global(.sk-title) {
    inline-size: 45%;
  }

  switch-feed :global(.sk-sub) {
    inline-size: 30%;
    block-size: 0.7em;
  }

  switch-feed :global(.sk-amount) {
    inline-size: 3em;
  }
</style>
