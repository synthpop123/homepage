---
/**
 * Switch play activity from the self-hosted switch-play worker.
 *
 * The question this answers is "what am I actually playing", not "what did
 * I touch last" — so the list is the catalog ranked by lifetime play time,
 * and each row's bar carries the recent window inside the lifetime one.
 */

import Heatmap from "@/components/Heatmap.astro"
import { SWITCH } from "@/consts"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = SWITCH.endpoint, limit = SWITCH.limit } = Astro.props

// Four slots, filled in order by the script — the third one names itself,
// since a library with no resolved prices has nothing to put there.
const stats = ["Playtime", "Games", "", "Per active day"]
---

<p class="switch-intro">
  Synced daily from Nintendo's Parental Controls API via self-hosted
  <a href={endpoint} target="_blank" rel="noopener noreferrer">switch-play</a>
  worker.
</p>
<switch-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <div class="switch-body">
    <h3 class="switch-label">All-time stats</h3>
    <dl class="switch-stats">
      {stats.map((label) => (
        <div class="stat">
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>
    <h3 class="switch-label">Activity</h3>
    <Heatmap />
    <h3 class="switch-label">Most played</h3>
    <ol class="switch-list">
      {Array.from({ length: limit }).map(() => (
        <li class="switch-item" data-skeleton aria-hidden="true">
          <span class="rank" />
          <span class="cover" />
          <span class="meta">
            <span class="title"><span class="sk-line sk-title" /></span>
            <span class="sub"><span class="sk-line sk-sub" /></span>
          </span>
          <span class="amount"><span class="sk-line sk-amount" /></span>
        </li>
      ))}
    </ol>
  </div>
  <p class="switch-fallback" hidden>
    Couldn't load right now — play activity is synced to
    <a href={endpoint} target="_blank" rel="noopener noreferrer">switch-play</a
    >.
  </p>
</switch-feed>

<script>
  import { el } from "@/lib/client/dom"
  import { safeHttpUrl, TIME_ZONE } from "@/lib/client/feed"
  import { HEAT_MAX_WEEKS, mountHeatmap } from "@/lib/client/heatmap"
  import {
    formatPlaytime,
    heatmapWindow,
    loadSite,
    rowFoot,
    type Site,
    type SiteGame,
    statCards,
  } from "@/lib/client/switch"

  const numberFormatter = new Intl.NumberFormat("en-US")
  const dayFormatter = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    timeZone: TIME_ZONE,
  })

  // Calendar days from the payload are Asia/Shanghai already; anchoring at
  // noon UTC keeps them from sliding a day in either direction.
  const asDate = (day: string) => new Date(`${day}T12:00:00Z`)

  const fillStats = (feed: HTMLElement, stats: Site["stats"]) => {
    const cards = statCards(stats)
    feed.querySelectorAll<HTMLElement>(".stat").forEach((stat, index) => {
      const card = cards[index]
      const label = stat.querySelector<HTMLElement>(".label")
      const value = stat.querySelector<HTMLElement>(".value")
      if (!card || !label || !value) return
      label.textContent = card.label
      value.textContent = card.value
      stat.title = card.note
    })
  }

  const buildHeatmap = (feed: HTMLElement, site: Site) => {
    const grid = feed.querySelector<HTMLElement>(".heat-grid")
    if (!grid) return

    const days = heatmapWindow(site.activity, site.today, HEAT_MAX_WEEKS * 7)
    mountHeatmap(grid, days, (shown) => {
      const max = Math.max(...shown.map((day) => day.minutes), 1)
      return shown.map((day) => ({
        level:
          day.minutes === 0
            ? 0
            : Math.max(1, Math.ceil((day.minutes / max) * 4)),
        title: `${day.minutes === 0 ? "No play" : formatPlaytime(day.minutes)} on ${dayFormatter.format(asDate(day.date))}`,
      }))
    })
  }

  /**
   * One title, and one bar of a chart: the row's own background is the
   * bar. Its fill runs to the title's share of the most-played one, and
   * the part of that inside the recent window is drawn in the heatmap's
   * green — the same "played lately" the grid above says in cells. So the
   * list reads as a ranking, a chart and a recency check at once, in one
   * line per game.
   */
  const buildRow = (
    game: SiteGame,
    rank: number,
    max: number,
    recentDays: number,
    today: string,
  ) => {
    const row = el("li", "switch-item")
    // Both fills are measured against the same maximum, so the green part
    // is literally a slice of the bar it sits inside.
    row.style.setProperty("--total", `${(game.totalMinutes / max) * 100}%`)
    row.style.setProperty("--recent", `${(game.recentMinutes / max) * 100}%`)

    const cover = el("span", "cover")
    const src = safeHttpUrl(game.imageUrl)
    if (src) {
      const img = document.createElement("img")
      img.src = src
      img.alt = ""
      img.loading = "lazy"
      img.decoding = "async"
      img.width = 112
      img.height = 112
      cover.append(img)
    }

    const title = el("span", "title", game.title)
    title.title = game.title
    const meta = el("span", "meta")
    meta.append(title, el("span", "sub", rowFoot(game, recentDays, today)))

    const amount = el("span", "amount", formatPlaytime(game.totalMinutes))
    amount.title = `${numberFormatter.format(game.totalMinutes)} minutes`

    row.append(
      el("span", "rank", String(rank).padStart(2, "0")),
      cover,
      meta,
      amount,
    )

    const shop = safeHttpUrl(game.shopUrl)
    if (shop) {
      const link = document.createElement("a")
      link.className = "shop"
      link.href = shop
      link.target = "_blank"
      link.rel = "noopener noreferrer"
      link.setAttribute("aria-label", `${game.title} on the eShop`)
      row.append(link)
    }
    return row
  }

  document.querySelectorAll<HTMLElement>("switch-feed").forEach((feed) => {
    const endpoint = feed.dataset.endpoint
    const body = feed.querySelector<HTMLElement>(".switch-body")
    const list = feed.querySelector<HTMLOListElement>(".switch-list")
    const fallback = feed.querySelector<HTMLElement>(".switch-fallback")
    if (!endpoint || !body || !list) return

    const limit = Number(feed.dataset.limit) || 8

    let rendered = ""
    loadSite(endpoint, (site) => {
      if (site.games.length === 0 && site.activity.length === 0) {
        throw new Error("No play data")
      }

      const signature = JSON.stringify(site)
      if (signature === rendered) return

      fillStats(feed, site.stats)
      buildHeatmap(feed, site)

      const games = site.games.slice(0, limit)
      const max = Math.max(...games.map((game) => game.totalMinutes), 1)
      list.hidden = games.length === 0
      list.replaceChildren(
        ...games.map((game, i) =>
          buildRow(game, i + 1, max, site.recentDays, site.today),
        ),
      )
      rendered = signature
      feed.setAttribute("aria-busy", "false")
    }).catch(() => {
      body.hidden = true
      if (fallback) fallback.hidden = false
      feed.setAttribute("aria-busy", "false")
    })
  })
</script>

<style>
  switch-feed {
    display: block;
  }

  /* The list is the chart: every row is a bar (see buildRow), so rows sit
     a hairline apart instead of being ruled, and a row is one line tall —
     a cover the height of title plus recency, the hours at the far end. */
  .switch-list {
    display: grid;
    gap: 2px;
  }

  switch-feed :global(.switch-item) {
    --total: 0%;
    --recent: 0%;
    --fill: color-mix(in oklab, var(--foreground) 7%, transparent);
    --fill-recent: light-dark(
      color-mix(in oklab, #40c463 30%, transparent),
      color-mix(in oklab, #26a641 38%, transparent)
    );

    /* Positioned so the eShop link can stretch across the whole row. */
    position: relative;
    display: grid;
    grid-template-columns: 1.5em auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-3xs) var(--space-xs) var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-lg);
    background-image: linear-gradient(
      to right,
      var(--fill-recent) var(--recent),
      var(--fill) var(--recent) var(--total),
      transparent var(--total)
    );
    transition: background-color 0.15s ease;
  }

  @media (hover: hover) {
    switch-feed :global(.switch-item:hover) {
      background-color: color-mix(in oklab, var(--muted) 70%, transparent);
    }
  }

  switch-feed :global(.rank) {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    text-align: end;
  }

  switch-feed :global(.cover) {
    display: block;
    inline-size: 2.75rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  switch-feed :global(.cover img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  switch-feed :global(.meta) {
    display: grid;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  /* One line each: a long title gives way before the hours do, and the
     whole name is on hover. The row's height is the cover's either way,
     which is what lets the skeleton reserve it exactly. */
  switch-feed :global(:is(.title, .sub)) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  switch-feed :global(.title) {
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
  }

  switch-feed :global(.sub) {
    min-block-size: 1lh;
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  switch-feed :global(.amount) {
    min-block-size: 1lh;
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The eShop link covers the row rather than sitting in it — the whole
     row is the hit target — and stays transparent, so the bar under it
     shows through. Keyboard focus still has to be visible. */
  switch-feed :global(.shop) {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  switch-feed :global(.shop:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  switch-feed :global([data-skeleton] :is(.title, .sub, .amount)) {
    display: grid;
    align-content: center;
  }

  switch-feed :global([data-skeleton] .title) {
    min-block-size: 1lh;
  }

  switch-feed :global(.sk-title) {
    inline-size: 45%;
  }

  switch-feed :global(.sk-sub) {
    inline-size: 30%;
    block-size: 0.7em;
  }

  switch-feed :global(.sk-amount) {
    inline-size: 3em;
  }
</style>
