---
/**
 * Switch play activity from the self-hosted switch-play worker.
 *
 * The question this answers is "what am I actually playing", not "what did
 * I touch last" — so the list is the catalog ranked by lifetime play time,
 * and each row's bar carries the recent window inside the lifetime one.
 */

import Heatmap from "@/components/Heatmap.astro"
import { SWITCH } from "@/consts"
import { SKELETON_ROWS } from "@/lib/utils"

type Props = {
  endpoint?: string
  limit?: number
}

const { endpoint = SWITCH.endpoint, limit = SWITCH.limit } = Astro.props

// Four slots, filled in order by the script — the third one names itself,
// since a library with no resolved prices has nothing to put there.
const stats = ["Playtime", "Games", "", "Per active day"]
---

<p class="switch-intro">
  Synced daily from Nintendo's Parental Controls API via self-hosted
  <a href={endpoint} target="_blank" rel="noopener noreferrer">switch-play</a>
  worker.
</p>
<switch-feed data-endpoint={endpoint} data-limit={limit} aria-busy="true">
  <div class="switch-body">
    <h3 class="switch-label">All-time stats</h3>
    <dl class="switch-stats">
      {stats.map((label) => (
        <div class="stat">
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>
    <h3 class="switch-label">Activity</h3>
    <Heatmap />
    <div class="switch-head">
      <h3 class="switch-label">Most played</h3>
      <p class="switch-note" data-note></p>
    </div>
    <ol class="switch-list">
      {Array.from({ length: Math.min(limit, SKELETON_ROWS) }).map(() => (
        <li class="switch-item" data-skeleton aria-hidden="true">
          <span class="cover" />
          <span class="meta">
            <span class="title"><span class="sk-line sk-title" /></span>
            <span class="foot">
              <span class="sk-line sk-sub" />
              <span class="sk-line sk-amount" />
            </span>
            <span class="sk-line sk-bar" />
          </span>
        </li>
      ))}
    </ol>
  </div>
  <p class="switch-fallback" hidden>
    Couldn't load right now — play activity is synced to
    <a href={endpoint} target="_blank" rel="noopener noreferrer">switch-play</a
    >.
  </p>
</switch-feed>

<script>
  import { el } from "@/lib/client/dom"
  import { safeHttpUrl, TIME_ZONE } from "@/lib/client/feed"
  import { HEAT_MAX_WEEKS, mountHeatmap } from "@/lib/client/heatmap"
  import {
    formatPlaytime,
    heatmapWindow,
    lastPlayedLabel,
    loadSite,
    type Site,
    type SiteGame,
  } from "@/lib/client/switch"

  const numberFormatter = new Intl.NumberFormat("en-US")
  // zh-CN so the sign is a bare ¥ rather than en-US's "CN¥"; the note
  // beside it is where the currency is spelled out.
  const cnyFormatter = new Intl.NumberFormat("zh-CN", {
    style: "currency",
    currency: "CNY",
    maximumFractionDigits: 0,
  })
  const dayFormatter = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    timeZone: TIME_ZONE,
  })

  // Calendar days from the payload are Asia/Shanghai already; anchoring at
  // noon UTC keeps them from sliding a day in either direction.
  const asDate = (day: string) => new Date(`${day}T12:00:00Z`)

  /**
   * The four cards, in order. Prices are best-effort, so the third one
   * falls back to days active rather than showing a dash — and when it does
   * carry a value it admits how much of the library that value covers.
   */
  const statCards = (stats: Site["stats"]) => [
    { label: "Playtime", value: formatPlaytime(stats.totalMinutes) },
    { label: "Games", value: numberFormatter.format(stats.gameCount) },
    stats.libraryValueCny !== null
      ? {
          label: "Library value",
          value: cnyFormatter.format(stats.libraryValueCny),
          note:
            stats.pricedGameCount < stats.gameCount
              ? `CNY, at eShop list price for ${stats.pricedGameCount} of ${stats.gameCount} titles`
              : "CNY, at eShop list price for every title played",
        }
      : {
          label: "Days active",
          value: numberFormatter.format(stats.daysActive),
        },
    { label: "Per active day", value: formatPlaytime(stats.avgDailyMinutes) },
  ]

  const fillStats = (feed: HTMLElement, stats: Site["stats"]) => {
    const cards = statCards(stats)
    feed.querySelectorAll<HTMLElement>(".stat").forEach((stat, index) => {
      const card = cards[index]
      const label = stat.querySelector<HTMLElement>(".label")
      const value = stat.querySelector<HTMLElement>(".value")
      if (!card || !label || !value) return
      label.textContent = card.label
      value.textContent = card.value
      stat.title = "note" in card ? (card.note ?? "") : ""
    })
  }

  const buildHeatmap = (feed: HTMLElement, site: Site) => {
    const grid = feed.querySelector<HTMLElement>(".heat-grid")
    if (!grid) return

    const days = heatmapWindow(site.activity, site.today, HEAT_MAX_WEEKS * 7)
    mountHeatmap(grid, days, (shown) => {
      const max = Math.max(...shown.map((day) => day.minutes), 1)
      return shown.map((day) => ({
        level:
          day.minutes === 0
            ? 0
            : Math.max(1, Math.ceil((day.minutes / max) * 4)),
        title: `${day.minutes === 0 ? "No play" : formatPlaytime(day.minutes)} on ${dayFormatter.format(asDate(day.date))}`,
      }))
    })
  }

  /**
   * One title: a cover, the name over up to two lines, how lately it was
   * played and its lifetime hours on the line under that, and a bar
   * spanning the row underneath. The bar's length is its share of the
   * most-played game and the solid part inside it is the recent window —
   * so the row reads as "how much, and how much of that was lately"
   * without a second column.
   */
  const buildRow = (
    game: SiteGame,
    max: number,
    recentDays: number,
    today: string,
  ) => {
    const row = el("li", "switch-item")

    const cover = el("span", "cover")
    const src = safeHttpUrl(game.imageUrl)
    if (src) {
      const img = document.createElement("img")
      img.src = src
      img.alt = ""
      img.loading = "lazy"
      img.decoding = "async"
      img.width = 112
      img.height = 112
      cover.append(img)
    }

    const amount = el("span", "amount", formatPlaytime(game.totalMinutes))
    amount.title = `${numberFormatter.format(game.totalMinutes)} minutes`

    // Both fills are measured against the same maximum, so the solid part
    // is literally a slice of the bar it sits inside.
    const bar = el("span", "bar")
    bar.style.setProperty("--total", `${(game.totalMinutes / max) * 100}%`)
    bar.style.setProperty("--recent", `${(game.recentMinutes / max) * 100}%`)
    bar.append(el("span", "bar-total"), el("span", "bar-recent"))

    const parts = [lastPlayedLabel(game.lastPlayedDate, today)]
    // Only worth saying when it is less than the whole: on a title played
    // entirely inside the window it would restate the amount beside it.
    if (game.recentMinutes > 0 && game.recentMinutes < game.totalMinutes)
      parts.push(`${formatPlaytime(game.recentMinutes)} in ${recentDays}d`)

    const foot = el("span", "foot")
    foot.append(el("span", "sub", parts.filter(Boolean).join(" · ")), amount)

    const meta = el("span", "meta")
    meta.append(el("span", "title", game.title), foot, bar)

    row.append(cover, meta)

    const shop = safeHttpUrl(game.shopUrl)
    if (shop) {
      const link = document.createElement("a")
      link.className = "shop"
      link.href = shop
      link.target = "_blank"
      link.rel = "noopener noreferrer"
      link.setAttribute("aria-label", `${game.title} on the eShop`)
      row.append(link)
    }
    return row
  }

  document.querySelectorAll<HTMLElement>("switch-feed").forEach((feed) => {
    const endpoint = feed.dataset.endpoint
    const body = feed.querySelector<HTMLElement>(".switch-body")
    const list = feed.querySelector<HTMLOListElement>(".switch-list")
    const note = feed.querySelector<HTMLElement>("[data-note]")
    const fallback = feed.querySelector<HTMLElement>(".switch-fallback")
    if (!endpoint || !body || !list) return

    const limit = Number(feed.dataset.limit) || 8

    let rendered = ""
    loadSite(endpoint, (site) => {
      if (site.games.length === 0 && site.activity.length === 0) {
        throw new Error("No play data")
      }

      const signature = JSON.stringify(site)
      if (signature === rendered) return

      fillStats(feed, site.stats)
      buildHeatmap(feed, site)

      const games = site.games.slice(0, limit)
      const max = Math.max(...games.map((game) => game.totalMinutes), 1)
      list.hidden = games.length === 0
      if (note) note.textContent = ""
      if (games.length > 0) {
        list.replaceChildren(
          ...games.map((game) =>
            buildRow(game, max, site.recentDays, site.today),
          ),
        )
        // The legend earns its line only once a bar is actually split —
        // while every title is new, the solid part is the whole bar.
        if (note && games.some((g) => g.recentMinutes < g.totalMinutes))
          note.textContent = `Solid = last ${site.recentDays} days`
      }
      rendered = signature
      feed.setAttribute("aria-busy", "false")
    }).catch(() => {
      body.hidden = true
      if (fallback) fallback.hidden = false
      feed.setAttribute("aria-busy", "false")
    })
  })
</script>

<style>
  switch-feed {
    display: block;
  }

  /* The legend belongs on the heading line: it explains the bars below it,
     and a line of its own would read as content. */
  .switch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .switch-note {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .switch-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xs) var(--space-s);
    margin: 0;

    @media (width < 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .switch-list {
    display: flex;
    flex-direction: column;
  }

  switch-feed :global(.switch-item) {
    /* Positioned so the eShop link can stretch across the whole row. */
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--space-xs);
  }

  switch-feed :global(.switch-item + .switch-item) {
    border-block-start: 1px solid var(--border);
  }

  switch-feed :global(.cover) {
    inline-size: 5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--muted);
  }

  switch-feed :global(.cover img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  switch-feed :global(.meta) {
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  /* Two lines, always: a long title wraps rather than being cut mid-word,
     and reserving the second line keeps every row the same height — so the
     hours and the bars below them stay on one baseline down the list. */
  switch-feed :global(.title) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-block-size: 2lh;
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    line-height: 1.25;
  }

  /* How lately, and how much. The hours are what the list is ranked by, so
     they keep the right edge to be read as a column. */
  switch-feed :global(.foot) {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
  }

  /* Two nested fills, one box: --total is the share of the top title,
     --recent the part of that which falls in the recent window. It sits
     under the text rather than between its two lines, so it can span the
     row and be read as a measure. */
  switch-feed :global(.bar) {
    position: relative;
    display: block;
    inline-size: 100%;
    block-size: 0.375rem;
    margin-block-start: var(--space-3xs);
    border-radius: var(--radius-full);
    background-color: var(--muted);
  }

  switch-feed :global(.bar-total),
  switch-feed :global(.bar-recent) {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    border-radius: inherit;
  }

  switch-feed :global(.bar-total) {
    inline-size: var(--total);
    background-color: color-mix(in oklab, var(--foreground) 20%, transparent);
  }

  switch-feed :global(.bar-recent) {
    inline-size: var(--recent);
    background-color: color-mix(in oklab, var(--foreground) 65%, transparent);
  }

  switch-feed :global(.sub) {
    overflow: hidden;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  switch-feed :global(.amount) {
    flex: none;
    margin-inline-start: auto;
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
  }

  /* The eShop link covers the row rather than sitting in it — the whole
     row is the hit target, and a fourth column would crowd the amount.
     It carries no hover treatment of its own — like the Music rows, the
     list stays quiet and the pointer is the affordance. Keyboard focus
     still has to be visible, which is what the outline below is for. */
  switch-feed :global(.shop) {
    position: absolute;
    inset: 0;
  }

  switch-feed :global(.shop:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  switch-feed :global(.sk-title) {
    inline-size: 45%;
  }

  switch-feed :global(.sk-sub) {
    inline-size: 30%;
  }

  switch-feed :global(.sk-bar) {
    inline-size: 100%;
    block-size: 0.375rem;
    margin-block-start: var(--space-3xs);
  }

  switch-feed :global(.sk-amount) {
    flex: none;
    margin-inline-start: auto;
    inline-size: 3em;
  }
</style>
