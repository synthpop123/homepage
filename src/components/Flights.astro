---
/**
 * Where I've flown, from the self-hosted AirTrail instance through the
 * flights service in cf-workers-api (which holds the API key and ships the
 * map rather than the log: airports, routes and totals, never a single
 * flight).
 *
 * A flat map framed to the airports carries the section, with one strip
 * under it naming the route in focus, then the readout, every route
 * ranked, and what the flights were made of (airlines, aircraft) as two
 * composition bars. Markup, skeletons and styles only: the runtime is
 * src/lib/client/flights-feed/, the decisions src/lib/client/flights.ts.
 */

import regionMap from "@/assets/flights/asia-50m.json?url"
import worldMap from "@/assets/flights/world-110m.json?url"
import { FLIGHTS, MISC } from "@/consts"

type Props = {
  endpoint?: string
}

const { endpoint = MISC.endpoint } = Astro.props

const stats = ["Flights", "Distance", "In the air", "Airports"]
const tallies = [
  { key: "airlines", label: "Airlines" },
  { key: "aircraft", label: "Aircraft" },
]
---

<link rel="preload" as="fetch" href={regionMap} crossorigin>
<p class="flights-intro">
  Everywhere I've flown, from my self-hosted
  <a
    href="https://github.com/johanohly/AirTrail"
    target="_blank"
    rel="noopener noreferrer"
    >AirTrail</a
  >
  instance.
</p>
<flights-feed
  data-endpoint={endpoint}
  data-basemap={regionMap}
  data-world={worldMap}
  aria-busy="true"
>
  <div class="flights-body">
    <div class="flights-map"></div>
    <div class="flights-strip" aria-hidden="true">
      <b data-part="from"><span class="sk-line"></span></b>
      <span class="flights-path">
        <span data-part="km"></span>
        <span class="flights-line" data-part="line">
          <svg viewBox="-13 -11 26 22">
            <path
              d="M13 0 11 -1.6 3 -2 -3 -10 -6 -10 -2.5 -2 -8 -2 -10.5 -5.5 -12.5 -5.5 -11 0 -12.5 5.5 -10.5 5.5 -8 2 -2.5 2 -6 10 -3 10 3 2 11 1.6Z"
            ></path>
          </svg>
        </span>
        <span data-part="detail"></span>
      </span>
      <b data-part="to"><span class="sk-line"></span></b>
      <span class="flights-names">
        <span data-part="from-name"></span>
        <span data-part="to-name"></span>
      </span>
    </div>
    <dl class="readout">
      {stats.map((label) => (
          <div>
            <dt>{label}</dt>
            <dd class="value">
              <span class="sk-line sk-stat" aria-hidden="true" />
            </dd>
            <dd class="foot">
              <span class="sk-line sk-foot" aria-hidden="true" />
            </dd>
          </div>
        ))}
    </dl>
    <div class="flights-lists">
      <section class="flights-routes">
        <h3 class="flights-label">Routes <span>flights</span></h3>
        <ol>
          {Array.from({ length: FLIGHTS.routes }).map(() => (
              <li class="route" aria-hidden="true">
                <span class="route-hit" data-skeleton>
                  <span class="sk-line" />
                  <span class="sk-line" style="inline-size: min(10em, 70%)" />
                  <span class="sk-line" style="inline-size: 1em" />
                </span>
              </li>
            ))}
        </ol>
      </section>
      <div class="flights-tallies">
        {tallies.map(({ key, label }) => (
            <section class="flights-tally" data-tally={key}>
              <h3 class="flights-label">
                {label} <span class="comp-count" />
              </h3>
              <div class="comp-bar" role="img">
                <span class="sk-line" />
              </div>
              <ul>
                {Array.from({ length: FLIGHTS.named + 1 }).map(() => (
                  <li class="comp-row" aria-hidden="true">
                    <i data-skeleton />
                    <span class="sk-line" style="inline-size: 8em" />
                    <span class="sk-line" style="inline-size: 1em" />
                  </li>
                ))}
              </ul>
            </section>
          ))}
      </div>
    </div>
  </div>
  <p class="flights-fallback" hidden>
    The flight map is out of reach right now.
  </p>
</flights-feed>

<script>
  import "@/lib/client/flights-feed"
</script>

<style is:global>
  /* Global because the map, lists and bars are built at runtime, out of
     reach of Astro's scoped styles; every rule is nested under the
     element instead. */
  flights-feed {
    --flights-accent: light-dark(#e2700b, #ffb547);
    --flights-land: color-mix(
      in oklab,
      var(--foreground) 5%,
      var(--background)
    );
    --flights-coast: color-mix(
      in oklab,
      var(--foreground) 16%,
      var(--background)
    );
    --flights-grid: color-mix(
      in oklab,
      var(--foreground) 4%,
      var(--background)
    );

    display: block;

    & .readout {
      --readout-accent: var(--flights-accent);
    }

    /* The map ---------------------------------------------------------- */

    & .flights-map {
      position: relative;
      aspect-ratio: 3 / 2;
      margin-block: var(--space-2xs) var(--space-s);

      @media (width < 40rem) {
        aspect-ratio: 1;
      }

      & > svg {
        position: absolute;
        inset: 0;
        display: block;
        inline-size: 100%;
        block-size: 100%;
        overflow: visible;
      }
    }

    &[aria-busy="true"] .flights-map,
    & .flights-map[data-failed] {
      border-radius: var(--radius-lg);
      background-color: var(--muted);
    }

    &[aria-busy="true"] .flights-map {
      animation: var(--sk-pulse);
    }

    & .graticule {
      fill: none;
      stroke: var(--flights-grid);
      stroke-width: 0.6;
    }

    & .land {
      fill: var(--flights-land);
    }

    & .coast {
      fill: none;
      stroke: var(--flights-coast);
      stroke-width: 0.5;
    }

    & .borders {
      fill: none;
      stroke: var(--flights-coast);
      stroke-width: 0.6;
      stroke-dasharray: 2 2;
    }

    & .arc {
      fill: none;
      stroke: var(--flights-accent);
      stroke-linecap: round;
      opacity: 0.45;
      transition: opacity 0.2s ease;

      &[data-upcoming] {
        stroke-dasharray: 2 4;
      }

      &[data-on] {
        opacity: 1;
      }
    }

    & .flights-map[data-focus] .arc:not([data-on]) {
      opacity: 0.18;
    }

    & .hit {
      fill: none;
      stroke: transparent;
      stroke-width: 12;
      pointer-events: stroke;
      cursor: pointer;
    }

    & .dot {
      fill: var(--background);
      stroke: var(--foreground);
      stroke-width: 1.3;
      pointer-events: none;
      transition:
        fill 0.2s ease,
        stroke 0.2s ease;

      &[data-on] {
        fill: var(--flights-accent);
        stroke: var(--flights-accent);
      }
    }

    & .label {
      font-family: var(--font-mono);
      font-size: 10.5px;
      font-weight: var(--font-weight-medium);
      fill: var(--foreground);
      paint-order: stroke;
      stroke: var(--background);
      stroke-width: 3px;
      stroke-linejoin: round;
      pointer-events: none;
      transition: fill 0.2s ease;

      & .city {
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: var(--font-weight-normal);
        fill: var(--muted-foreground);
      }

      &[data-on] {
        fill: var(--flights-accent);
      }
    }

    /* The inset: the knot of airports drawn again, larger, in a corner. */
    & .lens {
      fill: none;
      stroke: var(--muted-foreground);
      stroke-width: 0.8;
    }

    & .leader {
      fill: none;
      stroke: var(--muted-foreground);
      stroke-width: 0.6;
      stroke-dasharray: 2 2.5;
    }

    & .inset-ground {
      fill: var(--background);
    }

    & .inset-rim {
      fill: none;
      stroke: var(--border);
    }

    /* The strip: the route in focus, codes large at either end. ------- */

    & .flights-strip {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-3xs) var(--space-s);
      margin-block-end: var(--space-m);

      & b {
        display: grid;
        align-items: center;
        min-inline-size: 2.2em;
        min-block-size: 1lh;
        font-size: clamp(2rem, 1.2rem + 4vw, 3.25rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      & [data-part="to"] {
        justify-items: end;
      }

      /* The names get a row of their own, so a long one can't widen
         the code's column and squeeze the line between the codes. */
      & .flights-names {
        grid-column: 1 / -1;
        display: flex;
        justify-content: space-between;
        gap: var(--space-s);
        min-block-size: 1lh;
        font-size: var(--step--1);
        color: var(--muted-foreground);

        & span {
          min-inline-size: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        & span:last-child {
          text-align: end;
        }
      }

      & .sk-line {
        block-size: 0.7em;
      }
    }

    & .flights-path {
      display: grid;
      justify-items: center;
      gap: var(--space-3xs);
      min-inline-size: 0;
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);

      & > span:not(.flights-line) {
        max-inline-size: 100%;
        min-block-size: 1lh;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    /* A dashed track the flown line fills along, the plane at its head. */
    & .flights-line {
      position: relative;
      inline-size: 100%;
      block-size: 1rem;

      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        inset-block-start: 50%;
      }

      &::before {
        border-block-start: 1.5px dashed var(--border);
      }

      &::after {
        border-block-start: 1.5px solid var(--flights-accent);
        transform-origin: left;
        scale: 0 1;
      }

      & svg {
        position: absolute;
        inset-block-start: 50%;
        inset-inline-start: 0;
        inline-size: 1rem;
        block-size: 1rem;
        translate: -50% -50%;
        fill: var(--foreground);
        opacity: 0;
      }

      &[data-drawn] {
        &::after {
          scale: 1 1;
          transition: scale 0.9s cubic-bezier(0.3, 0.7, 0.2, 1);
        }

        & svg {
          inset-inline-start: 100%;
          opacity: 1;
          transition:
            inset-inline-start 0.9s cubic-bezier(0.3, 0.7, 0.2, 1),
            opacity 0.2s ease;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        &[data-drawn]::after,
        &[data-drawn] svg {
          transition: none;
        }
      }
    }

    /* The lists -------------------------------------------------------- */

    /* Routes beside the bars when the column has room for both, stacked
       when it doesn't: an intrinsic grid, so no query is needed. */
    & .flights-lists {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
      gap: var(--space-s) var(--space-l);
    }

    & .flights-label {
      display: flex;
      justify-content: space-between;
      align-items: baseline;

      & span {
        font-weight: var(--font-weight-normal);
        text-transform: none;
        letter-spacing: normal;
      }
    }

    & .flights-routes ol {
      display: grid;
      gap: 2px;
    }

    /* The list is the chart, as in the Switch list: each row a bar
       filled to its share of the most flown route. */
    & .route-hit {
      --share: 0%;
      --fill: color-mix(in oklab, var(--foreground) 6%, transparent);

      display: grid;
      grid-template-columns: 6em minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2xs);
      inline-size: 100%;
      min-block-size: 2rem;
      padding-inline: var(--space-2xs);
      border-radius: var(--radius-lg);
      background-image: linear-gradient(
        to right,
        var(--fill) var(--share),
        transparent var(--share)
      );
      text-align: start;
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      cursor: pointer;
      transition: background-color 0.15s ease;

      &[aria-pressed="true"] {
        --fill: color-mix(in oklab, var(--flights-accent) 22%, transparent);

        & .route-code {
          color: var(--flights-accent);
        }
      }

      &[data-skeleton] {
        cursor: default;
      }

      @media (hover: hover) {
        &:not([data-skeleton]):hover {
          background-color: color-mix(in oklab, var(--muted) 70%, transparent);
        }
      }
    }

    & .route-code {
      font-family: var(--font-mono);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.03em;
    }

    & .route-name {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--muted-foreground);
    }

    & .flights-tally + .flights-tally .flights-label {
      margin-block-start: var(--space-m);
    }

    /* A composition bar: the named rows in shades of the accent, the rest
       in its faintest one. */
    & .comp-bar {
      display: flex;
      gap: 2px;
      block-size: 0.625rem;
      margin-block-end: var(--space-2xs);
      overflow: hidden;
      border-radius: var(--radius-sm);

      & span {
        flex-basis: 0;
        background-color: color-mix(
          in oklab,
          var(--flights-accent) var(--shade),
          var(--muted)
        );
      }

      & .sk-line {
        flex-grow: 1;
        block-size: 100%;
      }
    }

    & .comp-row,
    & .comp-more-btn {
      display: grid;
      grid-template-columns: 1em minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2xs);
      min-block-size: 1.75rem;
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
    }

    & .comp-row i {
      inline-size: 0.5rem;
      block-size: 0.5rem;
      border-radius: 2px;
      background-color: color-mix(
        in oklab,
        var(--flights-accent) var(--shade),
        var(--muted)
      );

      &[data-skeleton] {
        background-color: var(--gray-5);
      }
    }

    & .comp-n {
      color: var(--muted-foreground);
    }

    & .comp-more-btn {
      inline-size: 100%;
      text-align: start;
      color: var(--muted-foreground);
      cursor: pointer;

      &:hover {
        color: var(--foreground);
      }

      & svg {
        inline-size: 1em;
        block-size: 1em;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: rotate 0.15s ease;
      }

      &[aria-expanded="true"] svg {
        rotate: 180deg;
      }
    }

    & .sk-foot {
      inline-size: 6em;
    }
  }
</style>
