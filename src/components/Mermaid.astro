<script>
  // Mermaid is by far the heaviest chunk on the site, so it is fetched
  // only as the first diagram nears the viewport; a reader who never
  // scrolls that far never pays for it.
  const diagrams = [...document.querySelectorAll<HTMLElement>("pre.mermaid")]

  /** Without Mermaid (a blocked chunk, offline) or for a diagram it
   *  cannot parse, the source is still the diagram's content: shown as
   *  code rather than left as an invisible block. */
  const showSource = () => {
    for (const el of diagrams) {
      if (!el.hasAttribute("data-processed")) el.dataset.failed = ""
    }
  }

  async function mount() {
    const sources = new Map(diagrams.map((el) => [el, el.textContent ?? ""]))
    let mermaid: typeof import("mermaid").default
    try {
      ;({ default: mermaid } = await import("mermaid"))
    } catch {
      showSource()
      // The chunk is worth another try once the network is back.
      addEventListener("online", () => mount(), { once: true })
      return
    }

    const prefersDark = matchMedia("(prefers-color-scheme: dark)")
    const isDark = () => {
      const { theme } = document.documentElement.dataset
      return theme === "dark" || (!theme && prefersDark.matches)
    }

    // Mermaid can't read CSS variables, so each colour is resolved through
    // a probe: a custom property reads back as its declared light-dark()
    // text, but a property set from it reads back as the colour the current
    // scheme picks. Fills at neutral 2–4, edges at 6–7, lines at 9, text at 12.
    const probe = document.createElement("span")
    probe.hidden = true
    document.body.append(probe)
    const token = (name: string) => {
      probe.style.color = `var(--${name})`
      return getComputedStyle(probe).color
    }
    const palette = (dark: boolean) => ({
      darkMode: dark,
      background: token("neutral-1"),
      mainBkg: token("neutral-3"),
      primaryColor: token("neutral-3"),
      secondaryColor: token("neutral-4"),
      tertiaryColor: token("neutral-2"),
      primaryBorderColor: token("neutral-7"),
      clusterBkg: token("neutral-2"),
      clusterBorder: token("neutral-6"),
      lineColor: token("neutral-9"),
      primaryTextColor: token("neutral-12"),
      textColor: token("neutral-12"),
      noteBkgColor: token("neutral-3"),
      noteBorderColor: token("neutral-7"),
      edgeLabelBackground: token("neutral-1"),
    })

    const render = async () => {
      for (const [el, source] of sources) {
        el.removeAttribute("data-processed")
        delete el.dataset.failed
        el.textContent = source
      }
      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        themeVariables: palette(isDark()),
        // Mermaid 12 lays flowcharts out with ELK by default, a much larger
        // chunk that also moves every node; dagre keeps them as drawn.
        layout: "dagre",
        fontFamily: "var(--font-sans)",
      })
      await mermaid.run({ nodes: diagrams })
    }

    // One render at a time: a theme flip mid-render would otherwise reset
    // the nodes under the run still drawing into them.
    let queue = Promise.resolve()
    const rerender = () => {
      queue = queue.then(render).catch(showSource)
      return queue
    }

    await rerender()

    new MutationObserver(rerender).observe(document.documentElement, {
      attributeFilter: ["data-theme"],
    })
    prefersDark.addEventListener("change", () => {
      if (!document.documentElement.dataset.theme) rerender()
    })
  }

  if (diagrams.length > 0) {
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        near.disconnect()
        mount()
      },
      { rootMargin: "100% 0px" },
    )
    for (const diagram of diagrams) near.observe(diagram)
  }
</script>
