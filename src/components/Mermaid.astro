<script>
  // Mermaid is by far the heaviest chunk on the site, so it is fetched
  // only as the first diagram nears the viewport; a reader who never
  // scrolls that far never pays for it.
  const diagrams = [...document.querySelectorAll<HTMLElement>("pre.mermaid")]

  async function mount() {
    const sources = new Map(diagrams.map((el) => [el, el.textContent ?? ""]))
    const { default: mermaid } = await import("mermaid")

    const prefersDark = matchMedia("(prefers-color-scheme: dark)")
    const isDark = () => {
      const { theme } = document.documentElement.dataset
      return theme === "dark" || (!theme && prefersDark.matches)
    }

    const render = async () => {
      for (const [el, source] of sources) {
        el.removeAttribute("data-processed")
        el.textContent = source
      }
      mermaid.initialize({
        startOnLoad: false,
        theme: isDark() ? "dark" : "neutral",
        fontFamily: "var(--font-sans)",
      })
      await mermaid.run({ nodes: diagrams })
    }

    await render()

    new MutationObserver(render).observe(document.documentElement, {
      attributeFilter: ["data-theme"],
    })
    prefersDark.addEventListener("change", () => {
      if (!document.documentElement.dataset.theme) render()
    })
  }

  if (diagrams.length > 0) {
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        near.disconnect()
        mount()
      },
      { rootMargin: "100% 0px" },
    )
    for (const diagram of diagrams) near.observe(diagram)
  }
</script>
