---
/**
 * Click-to-zoom for content images (see @/lib/client/lightbox): drop
 * this component on any page whose images should enlarge in place.
 * Only the click trigger loads with the page — PhotoSwipe arrives as
 * its own chunk on first use, bringing its stylesheet with it.
 */
---

<script>
  import { mountLightbox } from "@/lib/client/lightbox"

  mountLightbox()
</script>

<style is:global>
  prose-content img:not(.emoji),
  post-banner img,
  .memo-shot a {
    cursor: zoom-in;
  }
</style>
