---
import { titleLang } from "@/lib/content"
import { titleTransition } from "@/lib/site-links"
import { formatPostDate } from "@/lib/utils"
import type { CollectionEntry } from "astro:content"

/** A compact list of posts, date then title (the home page's Writing,
 *  the 404 page's way back in). */
type Props = { posts: CollectionEntry<"blog">[] }

const { posts } = Astro.props
---

<ol>
  {posts.map((post) => (
    <li>
      <time datetime={post.data.date.toISOString()}>
        {formatPostDate(post.data.date)}
      </time>
      <a
        href={`/blog/${post.id}`}
        lang={titleLang(post)}
        style={`view-transition-name: ${titleTransition(post.id)}`}
        >{post.data.title}</a
      >
    </li>
  ))}
</ol>

<style>
  /* Date and title, the dates in a column of their own so the titles
     start on one line however long each date is. */
  ol {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    margin: 0;
    padding: 0;
  }

  time {
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }

  a {
    color: var(--foreground);
    text-decoration: none;
    text-wrap: pretty;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
</style>
