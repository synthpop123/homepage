---
import Logo from "@/assets/logo.svg"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(({ href, also = [] }) =>
  [href, ...also].some(
    (path) => pathname === path || pathname.startsWith(`${path}/`),
  ),
)
---

<aside data-bar>
  <sidebar-inner>
    <a href="/" aria-label={SITE.title}>
      <Logo />
      <span>{SITE.title}</span>
    </a>
    <nav>
      <ul>
        {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
              {item === section && crumbs.length > 0 && pathname !== item.href && (
                <ul>
                  {crumbs.map((crumb, i) => (
                    <li data-depth={i ? 1 : undefined}>
                      <a
                        href={crumb.href}
                        aria-current={
                          i === crumbs.length - 1 ? "page" : undefined
                        }
                      >
                        {crumb.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        {!section &&
            crumbs.map((crumb, i) => (
              <li data-crumb data-depth={i ? 1 : undefined}>
                <a
                  href={crumb.href}
                  aria-current={i === crumbs.length - 1 ? "page" : undefined}
                >
                  {crumb.label}
                </a>
              </li>
            ))}
      </ul>
    </nav>
  </sidebar-inner>
  <sidebar-toggle>
    <ThemeToggle />
    <slot name="actions" />
  </sidebar-toggle>
</aside>

<style>
  aside {
    /* Held still through page transitions (layout.css). */
    view-transition-name: sidebar;
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    > a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      width: fit-content;
      font-weight: var(--font-weight-medium);
      font-size: var(--step-0);
      color: var(--foreground);
      text-decoration-line: none;

      svg {
        inline-size: 1.125rem;
        block-size: 1.125rem;
        flex-shrink: 0;
      }

      /* On one row with the nav, the name crowds the entries: the logo
         alone says whose site it is. */
      @media (width < 64rem) {
        span {
          display: none;
        }
      }
    }

    @media (width < 64rem) {
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Where you are: a hairline rail hung in the gutter beside the list,
     the current entry's stretch of it in ink and a hovered entry's in
     grey; the words stay on the logo's left edge. No underline, and no
     accent: the rail is the nav's only mark. */
  nav > ul {
    --rail: 0.75rem;
    margin-inline-start: calc(-1 * var(--rail));
    padding-inline-start: calc(var(--rail) - var(--hairline));
    border-inline-start: var(--hairline) solid var(--border);

    @media (width < 64rem) {
      margin-inline-start: 0;
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      position: relative;
      display: block;
      margin-inline-start: var(--indent, 0px);
      color: var(--muted-foreground);
      text-decoration: none;

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }

    /* The entry's stretch of the rail, reached back across its indent. */
    a::before {
      content: "";
      position: absolute;
      inset-block: 0.15em;
      inset-inline-start: calc(-1 * var(--rail) - var(--indent, 0px));
      inline-size: var(--hairline);
      background-color: transparent;
    }

    a:hover::before {
      background-color: var(--neutral-8);
    }

    a[aria-current="page"]::before {
      background-color: var(--foreground);
    }

    li[data-depth="1"] a {
      --indent: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        --indent: var(--space-xs);
      }

      li[data-depth="1"] a {
        --indent: calc(2 * var(--space-xs));
      }
    }

    @media (width < 64rem) {
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);

      /* Five entries and the theme toggle share a phone's width. */
      @media (width < 26rem) {
        gap: var(--space-xs);
      }

      @media (width < 24rem) {
        gap: var(--space-2xs);
      }

      @media (width < 22rem) {
        font-size: var(--step--1);
      }

      /* The row holds the sections alone: a page's crumbs, nested or
         (outside any section, as on the 404) at the top level, would push
         the theme toggle past the edge. */
      ul,
      li[data-crumb] {
        display: none;
      }

      /* On the row the rail lies under the word instead. */
      a::before {
        inset: auto 0 -0.3rem;
        inline-size: auto;
        block-size: var(--hairline);
      }
    }
  }

  /* On the phone the crumbs are hidden, so the section they sit under
     is the current entry. */
  nav li:has(> ul) > a {
    @media (width < 64rem) {
      color: var(--foreground);
    }
  }

  @media (width < 64rem) {
    nav li:has(> ul) > a::before {
      background-color: var(--foreground);
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;

    @media (width < 64rem) {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
    }
  }
</style>
