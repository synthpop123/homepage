---
import SocialIcons from "@/components/SocialIcons.astro"
import { SITE, SOCIALS } from "@/consts"
---

<footer>
  <p>
    &copy; 2021-{new Date().getFullYear()}
    {SITE.title}
  </p>
  <SocialIcons links={SOCIALS} />
</footer>

<style>
  /* One line for as long as the two of them fit on one — the pair is barely
     17rem wide, so that is every phone. Wrapping is the fallback rather than
     the mobile layout, and once a line holds only one of them it reads
     better centred than pinned to an edge. */
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
    margin-block: var(--space-xs) var(--page-offset-bottom);

    @media (width < 22rem) {
      justify-content: center;
    }

    p {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }
</style>
