---
import Heatmap from "@/components/Heatmap.astro"
import { GITHUB } from "@/consts"

type Props = {
  username?: string
}

const { username = GITHUB.username } = Astro.props

const profileUrl = `https://github.com/${username}`
const feedUrl = `${GITHUB.contributionsApi}/${username}?y=last`
---

<github-feed data-endpoint={feedUrl} aria-busy="true">
  <div class="gh-body">
    <p class="gh-total">
      <span class="sk-total" aria-hidden="true"></span>
    </p>
    <Heatmap />
  </div>
  <p class="gh-fallback" hidden>
    Couldn’t load right now — see what I’ve been building on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">GitHub</a>.
  </p>
</github-feed>

<script>
  import { cached, fetchJson, TIME_ZONE } from "@/lib/client/feed"
  import { mountHeatmap } from "@/lib/client/heatmap"

  type Contributions = {
    total?: Record<string, number>
    contributions?: { date: string; count: number; level: number }[]
  }

  const numberFormatter = new Intl.NumberFormat("en-US")
  const dayFormatter = new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    timeZone: TIME_ZONE,
  })

  // Date-only strings anchored at noon UTC so the formatted day never
  // drifts across the day boundary, mirroring weekdayIndex in heatmap.ts.
  const formatDay = (day: string) =>
    dayFormatter.format(new Date(`${day}T12:00:00Z`))

  document.querySelectorAll<HTMLElement>("github-feed").forEach((feed) => {
    const endpoint = feed.dataset.endpoint
    const body = feed.querySelector<HTMLElement>(".gh-body")
    const total = feed.querySelector<HTMLElement>(".gh-total")
    const grid = feed.querySelector<HTMLElement>(".heat-grid")
    const fallback = feed.querySelector<HTMLElement>(".gh-fallback")
    if (!endpoint || !body || !total || !grid) return

    cached(
      `github:${endpoint}`,
      () => fetchJson<Contributions>(endpoint),
      (data) =>
        Array.isArray((data as Contributions | null)?.contributions) &&
        ((data as Contributions).contributions?.length ?? 0) > 0,
    )
      .then((data) => {
        const days = data.contributions ?? []
        if (days.length === 0) throw new Error("No contributions")

        const sum =
          data.total?.lastYear ??
          days.reduce((count, day) => count + day.count, 0)
        total.textContent = `${numberFormatter.format(sum)} contributions in the last year`

        // The API already buckets counts into GitHub's own 0–4 levels.
        mountHeatmap(grid, days, (shown) =>
          shown.map((day) => ({
            level: day.level,
            title: `${day.count} ${day.count === 1 ? "contribution" : "contributions"} on ${formatDay(day.date)}`,
          })),
        )
        feed.setAttribute("aria-busy", "false")
      })
      .catch(() => {
        body.hidden = true
        if (fallback) fallback.hidden = false
        feed.setAttribute("aria-busy", "false")
      })
  })
</script>

<style>
  .gh-fallback {
    margin-block-end: 0;
    color: var(--muted-foreground);
  }

  .gh-fallback a {
    color: var(--foreground);
    text-decoration: underline;
  }

  github-feed {
    display: block;
  }

  .gh-total {
    margin-block-end: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
    font-variant-numeric: tabular-nums;
  }

  .sk-total {
    display: block;
    inline-size: 14em;
    block-size: 1em;
    border-radius: var(--radius-sm);
    background-color: var(--gray-5);
    animation: var(--sk-pulse);
  }
</style>
