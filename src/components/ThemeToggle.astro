---
import MoonIcon from "@/assets/icons/moon.svg"
import SunIcon from "@/assets/icons/sun.svg"
---

<button id="theme-toggle" data-icon-button aria-label="Toggle theme">
  <light-icon><SunIcon /></light-icon>
  <dark-icon><MoonIcon /></dark-icon>
</button>

<style is:global>
  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
  }

  dark-icon {
    display: none;
  }

  :root[data-theme="dark"] {
    light-icon {
      display: none;
    }

    dark-icon {
      display: inline;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      light-icon {
        display: none;
      }

      dark-icon {
        display: inline;
      }
    }
  }
</style>

<script>
  const root = document.documentElement
  const system = matchMedia("(prefers-color-scheme: dark)")

  /**
   * Repaints in the new scheme with every transition off. A colour that
   * transitions (a link's hover, a map label's fill) and resolves
   * through light-dark() would otherwise keep the old scheme's value
   * until something else restyles it, since the declared value never
   * changed. Forcing a style pass while transitions are off settles
   * every element at once.
   */
  const instantly = (change: () => void) => {
    const style = document.createElement("style")
    style.textContent = "*,*::before,*::after{transition:none!important}"
    document.head.append(style)
    change()
    getComputedStyle(root).color
    setTimeout(() => style.remove())
  }

  /** Flips the scheme. Landing on the system's own scheme drops the
   *  stored choice, so the page follows the system again from there. */
  const toggleTheme = () =>
    instantly(() => {
      const dark =
        root.dataset.theme === "dark" || (!root.dataset.theme && system.matches)
      const theme = dark ? "light" : "dark"
      const follow = (theme === "dark") === system.matches
      if (follow) delete root.dataset.theme
      else root.dataset.theme = theme
      try {
        if (follow) localStorage.removeItem("theme")
        else localStorage.theme = theme
      } catch {
        // Storage blocked: the choice holds for this page only.
      }
    })

  const button = document.getElementById("theme-toggle")
  if (button) button.onclick = toggleTheme
  // The system switching schemes (sunset, say) repaints the same way.
  system.addEventListener("change", () => {
    if (!root.dataset.theme) instantly(() => {})
  })
</script>
