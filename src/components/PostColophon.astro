---
/**
 * What closes a post, between its last paragraph and the site's footer:
 * where it sits among the rest (the timeline, this post lit, its kin
 * tinted), its address under the timeline's years (copied on click),
 * and what it may be used under, centred as a book's last line.
 */

import PostStrip from "@/components/PostStrip.astro"
import { LICENSE } from "@/consts"
import { getSeries, timeline } from "@/lib/content"
import type { CollectionEntry } from "astro:content"

type Props = {
  chain: CollectionEntry<"blog">[]
  /** The chrome's language, on a page in another one (a Chinese post). */
  lang?: string
}

const { chain, lang } = Astro.props
const [post] = chain
const cells = timeline(await getSeries(), [post.id])
const url = new URL(`/blog/${post.id}`, Astro.site)
---

<post-colophon lang={lang}>
  <PostStrip cells={cells}>
    <button type="button" data-url={url.href} title="Copy link">
      <span>{url.host}/blog/</span><span>{post.id}</span>
    </button>
    <span class="sr" aria-live="polite"></span>
  </PostStrip>
  <p>
    <a href={LICENSE.href} rel="license noopener noreferrer" target="_blank">
      {LICENSE.label}
    </a>
  </p>
</post-colophon>

<style>
  post-colophon {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-xl);

    > p {
      margin: 0;
      font-family: var(--font-mono);
      font-feature-settings: normal;
      font-size: 0.625rem;
      letter-spacing: 0.12em;
      text-align: center;
    }

    a {
      color: var(--faint-foreground);
      text-decoration-line: none;
      transition: color 0.15s ease;

      &:hover {
        color: var(--foreground);
      }
    }
  }

  /* The address: the host faint, the post's own slug in full, between
     two short rules that reach out on hover and take the accent once
     it is copied. */
  button {
    display: inline-flex;
    align-items: center;
    min-inline-size: 0;
    max-inline-size: 100%;
    font: inherit;
    font-size: 0.75rem;
    color: var(--foreground);
    cursor: pointer;

    /* On a narrow strip the host gives way first, never the slug. */
    > span:first-child {
      min-inline-size: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--faint-foreground);
    }

    > span + span {
      flex: none;
    }

    &::before,
    &::after {
      content: "";
      flex: none;
      inline-size: 1.5rem;
      block-size: 1px;
      margin-inline: 0.45em;
      background-color: var(--border);
      transition:
        inline-size 0.2s ease,
        background-color 0.2s ease;
    }

    &:hover::before,
    &:hover::after {
      inline-size: 2.25rem;
      background-color: var(--gray-8);
    }

    &[data-state] {
      color: var(--accent);

      &::before,
      &::after {
        background-color: var(--accent-fill);
      }
    }

    &[data-state="error"] {
      color: var(--destructive);

      &::before,
      &::after {
        background-color: var(--destructive);
      }
    }
  }
</style>

<script>
  import { copyText } from "@/lib/client/copy"

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "post-colophon button[data-url]",
  )) {
    const status = button.nextElementSibling
    const url = button.dataset.url
    if (status && url) {
      button.addEventListener("click", () => copyText(button, status, url))
    }
  }
</script>
