---
import { GLOBE_LOCATIONS } from "@/consts"
---

<canvas data-globe data-locations={JSON.stringify(GLOBE_LOCATIONS)}></canvas>

<script>
  import createGlobe from "cobe"

  const canvas = document.querySelector<HTMLCanvasElement>("canvas[data-globe]")

  if (canvas) {
    const markers = JSON.parse(canvas.dataset.locations ?? "[]") as {
      location: [number, number]
      size: number
    }[]
    const size = 400

    // `phi` accumulates the idle auto-rotation; `drag` accumulates rotation from
    // pointer dragging. The rendered angle is their sum so the two never fight
    // and motion stays continuous across separate drags.
    let phi = Math.PI - 0.3
    let pointerStart: number | null = null
    let dragOffset = 0
    let dragTarget = 0
    let dragCurrent = 0

    const globe = createGlobe(canvas, {
      devicePixelRatio: 2,
      width: size * 2,
      height: size * 2,
      phi,
      theta: 0.4,
      dark: 0.1,
      diffuse: 1.2,
      mapSamples: 25000,
      mapBrightness: 4,
      baseColor: [0.6, 0.6, 0.6],
      markerColor: [0.9, 0.1, 0.1],
      glowColor: [0.5, 0.5, 0.5],
      markerElevation: 0,
      markers,
    })

    canvas.addEventListener("pointerdown", (e) => {
      // offset the anchor by the existing drag so this drag continues smoothly
      pointerStart = e.clientX - dragOffset
      canvas.setPointerCapture(e.pointerId)
      canvas.style.cursor = "grabbing"
    })

    const stopDragging = () => {
      pointerStart = null
      canvas.style.cursor = "grab"
    }
    canvas.addEventListener("pointerup", stopDragging)
    canvas.addEventListener("pointercancel", stopDragging)

    canvas.addEventListener("pointermove", (e) => {
      if (pointerStart === null) return
      dragOffset = e.clientX - pointerStart
      dragTarget = dragOffset / 200
    })

    // cobe 2.0.1 ships no onRender hook / internal loop, so rotation is driven
    // here via update(); this also re-renders once the map texture has loaded.
    const render = () => {
      if (pointerStart === null) phi += 0.0006
      // ease the drag toward its target for a smooth, spring-like response
      dragCurrent += (dragTarget - dragCurrent) * 0.15
      globe.update({ phi: phi + dragCurrent })
      requestAnimationFrame(render)
    }
    requestAnimationFrame(render)
  }
</script>

<style>
  canvas[data-globe] {
    display: block;
    inline-size: 400px;
    max-inline-size: 100%;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
</style>
