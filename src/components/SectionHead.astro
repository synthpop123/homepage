---
/**
 * A section heading with, at the far end of its row, the one link the
 * section has: where its data comes from (external, with an arrow) or
 * where the rest of it lives.
 */

import "@/styles/feed.css"

type Props = {
  id: string
  label: string
  source?: { href: string; label: string }
}

const { id, label, source } = Astro.props
const external = source ? /^https?:/.test(source.href) : false
---

<div class="section-head">
  <h2 id={id}>{label}</h2>
  {source && (
      <a
        class="section-link"
        href={source.href}
        {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      >
        {source.label}
        {external && <span aria-hidden="true">↗</span>}
      </a>
    )}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-s);
  }

  h2 {
    margin: 0;
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);

    @media (width >= 64rem) {
      scroll-margin-block-start: calc(var(--page-offset-top) - 0.2em);
    }
  }
</style>
