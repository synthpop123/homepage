---
/**
 * The owner's portfolio from cf-workers-api's portfolio service (kept in
 * Wealthfolio), delivered in the /misc bundle.
 *
 * Returns, never amounts: the hero figure is what the money did over the
 * range — its gain over the value it started from plus everything put in
 * since — the line that return day by day with the same money in the
 * S&P 500 as a dashed ghost, the strip under it the daily returns cut
 * into days, weeks or months and graded like the heatmaps (gains in their
 * greens, losses in ink — the site keeps one colour). The table is the holdings by weight
 * with price and average cost; a row opens in place into its price line
 * against that cost, what the company is, and how the position has done.
 */

import "@/styles/feed.css"
import "@/styles/portfolio/hero.css"
import "@/styles/portfolio/chart.css"
import "@/styles/portfolio/allocation.css"
import "@/styles/portfolio/holdings.css"
import { MISC } from "@/consts"
import { SKELETON_ROWS } from "@/lib/utils"

type Props = {
  endpoint?: string
}

const { endpoint = MISC.endpoint } = Astro.props
const stats = ["Return", "Last session", "vs S&P 500", "Max drawdown"]
---

<portfolio-feed data-endpoint={endpoint} aria-busy="true">
  <div class="portfolio-body">
    <div class="portfolio-toolbar">
      <div
        class="portfolio-accounts"
        role="group"
        aria-label="Account"
        aria-busy="true"
      >
        {Array.from({ length: 4 }).map(() => (
          <span class="chip-skeleton" aria-hidden="true"><span class="sk-line" /></span>
        ))}
      </div>
      <div
        class="portfolio-ranges range-tabs"
        role="group"
        aria-label="Range"
        aria-busy="true"
      >
        {Array.from({ length: 5 }).map(() => (
          <span class="tab-skeleton" aria-hidden="true"><span class="sk-line" /></span>
        ))}
      </div>
    </div>

    <div class="portfolio-hero">
      <p class="portfolio-kicker">
        <span class="sk-line sk-kicker" aria-hidden="true" />
      </p>
      <p class="portfolio-figure">
        <span class="sk-line sk-figure" aria-hidden="true" />
      </p>
      <p class="portfolio-note">
        <span class="sk-line sk-note" aria-hidden="true" />
      </p>
    </div>

    <p class="chart-keys" aria-hidden="true">
      <span class="chart-key">Portfolio</span>
      <span class="chart-key chart-key-ghost">S&amp;P 500</span>
    </p>
    <svg class="portfolio-chart" aria-label="Portfolio growth"></svg>

    <div class="portfolio-strip">
      <div class="strip-cells" aria-hidden="true"></div>
    </div>

    <dl class="readout portfolio-readout">
      {stats.map((label) => (
        <div class="stat">
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
          <dd class="note"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>

    <div class="alloc-head">
      <h3 class="feed-label alloc-title">Allocation</h3>
      <div class="alloc-tools">
        <div
          class="alloc-modes"
          role="group"
          aria-label="Colour by"
          aria-busy="true"
        >
          {Array.from({ length: 2 }).map(() => (
            <span class="chip-skeleton" aria-hidden="true"><span class="sk-line" /></span>
          ))}
        </div>
        <button
          class="alloc-zoom"
          type="button"
          aria-label="Show the whole account, cash included"
          disabled
        ></button>
      </div>
    </div>
    <div class="alloc-map"></div>

    <h3 class="feed-label">Holdings</h3>
    <div class="portfolio-head holding-row" aria-hidden="true">
      <span></span>
      <span>Holding</span>
      <span class="holding-spark">Range</span>
      <span class="holding-price">Price</span>
      <span class="holding-cost">Avg cost</span>
      <span class="holding-weight">Weight</span>
      <span class="holding-change">Return</span>
    </div>
    <ol class="portfolio-list">
      {Array.from({ length: SKELETON_ROWS }).map(() => (
        <li class="holding" data-skeleton aria-hidden="true">
          <div class="holding-row">
            <span class="holding-logo" />
            <span class="holding-name">
              <span class="holding-ticker"><span class="sk-line sk-ticker" /></span>
              <span class="holding-sub"><span class="sk-line sk-sub" /></span>
            </span>
            <span class="holding-spark" />
            <span class="holding-price"><span class="sk-line sk-num" /></span>
            <span class="holding-cost"><span class="sk-line sk-num" /></span>
            <span class="holding-weight"><span class="sk-line sk-num" /></span>
            <span class="holding-change"><span class="sk-line sk-num" /></span>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="feed-fallback" hidden>Couldn't load the portfolio right now.</p>
</portfolio-feed>

<script>
  import { mountPortfolio } from "@/lib/client/portfolio-feed"

  document
    .querySelectorAll<HTMLElement>("portfolio-feed")
    .forEach(mountPortfolio)
</script>
