---
/**
 * The owner's portfolio from cf-workers-api's portfolio service (kept in
 * Wealthfolio), delivered in the /misc bundle.
 *
 * Returns, never amounts: the hero figure is what the money did over the
 * range — its gain over the value it started from plus everything put in
 * since — the line that return day by day with the same money in the
 * S&P 500 as a dashed ghost, the strip under it the daily returns cut
 * into days, weeks or months and graded like the heatmaps (gains in their
 * greens, losses in ink — the site keeps one colour). The table is the holdings by weight
 * with price and average cost; a row opens in place into its price line
 * against that cost, what the company is, and how the position has done.
 */

import "@/styles/feed.css"
import { MISC } from "@/consts"
import { SKELETON_ROWS } from "@/lib/utils"

type Props = {
  endpoint?: string
}

const { endpoint = MISC.endpoint } = Astro.props
const stats = ["Return", "Last session", "vs S&P 500", "Max drawdown"]
---

<portfolio-feed data-endpoint={endpoint} aria-busy="true">
  <div class="portfolio-body">
    <div class="portfolio-toolbar">
      <div
        class="portfolio-accounts"
        role="group"
        aria-label="Account"
        aria-busy="true"
      >
        {Array.from({ length: 4 }).map(() => (
          <span class="chip-skeleton" aria-hidden="true"><span class="sk-line" /></span>
        ))}
      </div>
      <div
        class="portfolio-ranges range-tabs"
        role="group"
        aria-label="Range"
        aria-busy="true"
      >
        {Array.from({ length: 5 }).map(() => (
          <span class="tab-skeleton" aria-hidden="true"><span class="sk-line" /></span>
        ))}
      </div>
    </div>

    <div class="portfolio-hero">
      <p class="portfolio-kicker">
        <span class="sk-line sk-kicker" aria-hidden="true" />
      </p>
      <p class="portfolio-figure">
        <span class="sk-line sk-figure" aria-hidden="true" />
      </p>
      <p class="portfolio-note">
        <span class="sk-line sk-note" aria-hidden="true" />
      </p>
    </div>

    <svg class="portfolio-chart" aria-label="Portfolio growth"></svg>

    <div class="portfolio-strip">
      <div class="strip-cells" aria-hidden="true"></div>
    </div>

    <dl class="readout portfolio-readout">
      {stats.map((label) => (
        <div class="stat">
          <dt class="label">{label}</dt>
          <dd class="value"><span class="sk-line sk-stat" aria-hidden="true" /></dd>
          <dd class="note"><span class="sk-line sk-sub" aria-hidden="true" /></dd>
        </div>
      ))}
    </dl>

    <div class="alloc-head">
      <h3 class="portfolio-label alloc-title">Allocation</h3>
      <div
        class="alloc-modes"
        role="group"
        aria-label="Colour by"
        aria-busy="true"
      >
        {Array.from({ length: 2 }).map(() => (
          <span class="chip-skeleton" aria-hidden="true"><span class="sk-line" /></span>
        ))}
      </div>
    </div>
    <div class="alloc-map"></div>

    <h3 class="portfolio-label">Holdings</h3>
    <div class="portfolio-head holding-row" aria-hidden="true">
      <span></span>
      <span>Holding</span>
      <span class="holding-spark">Range</span>
      <span class="holding-price">Price</span>
      <span class="holding-cost">Avg cost</span>
      <span class="holding-weight">Weight</span>
      <span class="holding-change">Return</span>
    </div>
    <ol class="portfolio-list">
      {Array.from({ length: SKELETON_ROWS }).map(() => (
        <li class="holding" data-skeleton aria-hidden="true">
          <div class="holding-row">
            <span class="holding-logo" />
            <span class="holding-name">
              <span class="holding-ticker"><span class="sk-line sk-ticker" /></span>
              <span class="holding-sub"><span class="sk-line sk-sub" /></span>
            </span>
            <span class="holding-spark" />
            <span class="holding-price"><span class="sk-line sk-num" /></span>
            <span class="holding-cost"><span class="sk-line sk-num" /></span>
            <span class="holding-weight"><span class="sk-line sk-num" /></span>
            <span class="holding-change"><span class="sk-line sk-num" /></span>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="portfolio-fallback" hidden>
    Couldn't load the portfolio right now.
  </p>
</portfolio-feed>

<script>
  import { mountPortfolio } from "@/lib/client/portfolio-feed"

  document
    .querySelectorAll<HTMLElement>("portfolio-feed")
    .forEach(mountPortfolio)
</script>

<style>
  portfolio-feed {
    display: block;
    /* The column's width is not the viewport's (the sidebar takes its
       cut, and the TOC from 76rem): the table reads its own width. */
    container-type: inline-size;
  }

  .portfolio-body {
    display: grid;
  }

  /* One toolbar: whose portfolio on the left, over what range on the
     right. Accounts (and the allocation map's Day / Return) are a
     segmented control, each broker with its mark:
     an 8px track with 2px of padding, so each segment's corner is 6px. */
  .portfolio-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    margin-block-end: var(--space-s);
  }

  .portfolio-accounts,
  .alloc-modes {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    min-block-size: 1.875rem;
    padding: 2px;
    border-radius: var(--radius-lg);
    background-color: var(--muted);
  }

  portfolio-feed :global(:is(.portfolio-accounts, .alloc-modes) button),
  .chip-skeleton {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    block-size: 1.625rem;
    padding-inline: 0.65rem;
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .chip-skeleton {
    display: grid;
    align-content: center;
    inline-size: 4rem;
  }

  .chip-skeleton .sk-line {
    inline-size: 100%;
  }

  portfolio-feed :global(.portfolio-accounts button img) {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    border-radius: var(--radius-xs);
    /* Brand marks are drawn for a white ground: Gray 1 (light), in
       either scheme. */
    background-color: var(--logo-ground);
  }

  @media (hover: hover) {
    portfolio-feed
      :global(:is(.portfolio-accounts, .alloc-modes) button:hover) {
      color: var(--foreground);
    }
  }

  portfolio-feed
    :global(
      :is(.portfolio-accounts, .alloc-modes) button[aria-pressed="true"]
    ) {
    color: var(--foreground);
    background-color: var(--background);
    outline: var(--hairline) solid var(--neutral-a6);
    outline-offset: calc(-1 * var(--hairline));
  }

  /* Hero: what the account did over the range, set large. */
  .portfolio-hero p {
    margin: 0;
  }

  .portfolio-kicker {
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-block-size: 1lh;
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  portfolio-feed :global(.kicker-name:empty) {
    display: none;
  }

  /* The brokers' marks: small rounded tiles, overlapped like a fanned
     deck, each cut out of the page by a ring of the background. Picking
     an account folds the others away over 250ms. */
  portfolio-feed :global(.broker-deck) {
    display: inline-flex;
    padding-inline-start: 0.3rem;
  }

  portfolio-feed :global(.broker) {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 1.5rem;
    aspect-ratio: 1;
    margin-inline-start: -0.3rem;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--logo-ground);
    outline: 2px solid var(--background);
    transition:
      inline-size var(--duration) var(--ease),
      margin var(--duration) var(--ease),
      opacity var(--duration) var(--ease);
  }

  portfolio-feed :global(.broker:not(:has(img))::before) {
    content: attr(data-monogram);
    font-size: var(--step--2);
    font-weight: var(--font-weight-medium);
    color: var(--logo-ink);
  }

  portfolio-feed :global(.broker img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  portfolio-feed :global(.broker[data-folded]) {
    inline-size: 0;
    margin-inline-start: 0;
    opacity: 0;
    outline: none;
  }

  /* The brokers' tiles stand taller than the kicker's line, so the
     figure keeps a clear step below them. */
  .portfolio-hero .portfolio-figure {
    margin-block-start: var(--space-xs);
  }

  .portfolio-figure {
    min-block-size: 1lh;
    font-size: var(--step-1);
    font-weight: var(--font-weight-display);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
  }

  .portfolio-note {
    min-block-size: 1lh;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }

  .portfolio-hero .sk-line {
    display: block;
    block-size: 0.75em;
  }

  .sk-kicker {
    inline-size: 9rem;
  }

  .sk-figure {
    inline-size: 9rem;
    margin-block-start: 0.2em;
  }

  .sk-note {
    inline-size: 14rem;
  }

  /* The chart. Its slider role makes it a tab stop; the ring shows on
     keyboard focus only. */
  .portfolio-chart {
    inline-size: 100%;
    block-size: 13rem;
    margin-block-start: var(--space-2xs);
    overflow: visible;
    cursor: crosshair;
    touch-action: pan-y;
  }

  portfolio-feed :global(:is(.portfolio-chart, .panel-chart):focus-visible) {
    outline-offset: 0.25rem;
  }

  portfolio-feed :global(.chart-line) {
    fill: none;
    stroke: var(--foreground);
    stroke-width: var(--chart-stroke);
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  portfolio-feed :global(.chart-area) {
    fill: var(--neutral-a2);
  }

  portfolio-feed :global(.chart-ghost) {
    fill: none;
    stroke: var(--chart-ghost);
    stroke-width: var(--chart-stroke-thin);
    stroke-dasharray: var(--chart-dash);
  }

  portfolio-feed :global(:is(.chart-ghost-label, .chart-scrub text)) {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-feature-settings: normal;
    fill: var(--muted-foreground);
  }

  /* The ghost's label sits on lines; a halo of the page keeps it read. */
  portfolio-feed :global(.chart-ghost-label) {
    paint-order: stroke;
    stroke: var(--background);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  /* A holding's line against its cost: the dashed level, the gap washed
     green above it and grey below, the first buy a dot. */
  portfolio-feed :global(.chart-gain) {
    fill: var(--grass-a4);
  }

  portfolio-feed :global(.chart-loss) {
    fill: var(--neutral-a3);
  }

  portfolio-feed :global(.chart-cost) {
    stroke: var(--chart-ghost);
    stroke-width: var(--chart-stroke-thin);
    stroke-dasharray: var(--chart-dash-level);
  }

  portfolio-feed :global(.chart-mark) {
    fill: var(--accent-fill);
    stroke: var(--background);
    stroke-width: var(--chart-halo);
  }

  portfolio-feed :global(.chart-scrub) {
    opacity: 0;
    pointer-events: none;
  }

  portfolio-feed :global(.chart-scrub[data-on]) {
    opacity: 1;
  }

  portfolio-feed :global(.chart-scrub line) {
    stroke: var(--border-strong);
    stroke-width: var(--hairline);
  }

  portfolio-feed :global(.chart-scrub circle) {
    fill: var(--accent-fill);
    stroke: var(--background);
    stroke-width: var(--chart-halo);
  }

  /* The strip: the line again, as a row of graded cells. */
  .portfolio-strip {
    margin-block-start: var(--space-2xs);
  }

  .strip-cells {
    display: flex;
    gap: 2px;
    block-size: 0.625rem;
  }

  portfolio-feed :global(.strip-cell) {
    flex: 1;
    border-radius: var(--radius-xs);
    background-color: var(--heat-0);
  }

  portfolio-feed :global(.strip-cell[data-dir="up"][data-level="1"]) {
    background-color: var(--heat-1);
  }
  portfolio-feed :global(.strip-cell[data-dir="up"][data-level="2"]) {
    background-color: var(--heat-2);
  }
  portfolio-feed :global(.strip-cell[data-dir="up"][data-level="3"]) {
    background-color: var(--heat-3);
  }
  portfolio-feed :global(.strip-cell[data-dir="up"][data-level="4"]) {
    background-color: var(--heat-4);
  }
  portfolio-feed :global(.strip-cell[data-dir="down"][data-level="1"]) {
    background-color: var(--down-1);
  }
  portfolio-feed :global(.strip-cell[data-dir="down"][data-level="2"]) {
    background-color: var(--down-2);
  }
  portfolio-feed :global(.strip-cell[data-dir="down"][data-level="3"]) {
    background-color: var(--down-3);
  }
  portfolio-feed :global(.strip-cell[data-dir="down"][data-level="4"]) {
    background-color: var(--down-4);
  }

  portfolio-feed :global(.strip-cell[data-on]) {
    outline: 1.5px solid var(--foreground);
    outline-offset: 1px;
  }

  /* Range tabs: mono labels, the picked one on a neutral 3 fill. */
  portfolio-feed :global(.range-tabs) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    min-block-size: 1.75rem;
  }

  portfolio-feed :global(.range-tabs button),
  .tab-skeleton {
    block-size: 1.625rem;
    padding-inline: 0.6rem;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--font-weight-medium);
    font-feature-settings: normal;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
  }

  .tab-skeleton {
    display: grid;
    align-content: center;
    inline-size: 2.5rem;
  }

  @media (hover: hover) {
    portfolio-feed :global(.range-tabs button:hover) {
      color: var(--foreground);
    }
  }

  portfolio-feed :global(.range-tabs button[aria-pressed="true"]) {
    color: var(--foreground);
    background-color: var(--muted);
  }

  /* Readout: a sign is part of the figure, not a unit beside it. */
  .portfolio-readout {
    margin-block: var(--space-m);
  }

  portfolio-feed :global(.portfolio-readout .value .unit:first-child) {
    margin-inline: 0 0.04em;
    font-size: inherit;
    color: inherit;
  }

  portfolio-feed :global(.portfolio-readout .value[data-dir="down"]) {
    color: var(--muted-foreground);
  }

  .sk-sub {
    inline-size: 6em;
  }

  /* Allocation: a treemap of the holdings, area by weight, graded by the
     last session or the position's return like the strip (gains in the
     heatmap's greens, losses in ink), cash hatched. The cash-like block
     can be zoomed past through the lens tab on the invested one. */
  /* One row at every width, so zooming never moves the map. */
  .alloc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    margin-block: var(--space-l) var(--space-xs);
  }

  .alloc-head .alloc-title {
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-inline-size: 0;
    min-block-size: 1.75rem;
    margin: 0;
    white-space: nowrap;
  }

  .alloc-head .alloc-modes {
    flex: none;
    min-block-size: 0;
  }

  .alloc-modes .chip-skeleton {
    inline-size: 3.5rem;
  }

  /* Zoomed, the heading is a breadcrumb; its link back keeps the label's
     own letterforms. */
  portfolio-feed :global(.alloc-back) {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--muted-foreground);
    text-decoration: underline;
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 0.2em;
    cursor: zoom-out;
  }

  @media (hover: hover) {
    portfolio-feed :global(.alloc-back:hover) {
      color: var(--foreground);
    }
  }

  portfolio-feed :global(.alloc-back-map) {
    display: block;
    border-radius: var(--radius-xs);
  }

  portfolio-feed :global(.alloc-mini) {
    display: block;
    inline-size: 2.75rem;
    block-size: 1.5rem;
  }

  portfolio-feed :global(.mini-aside) {
    fill: var(--neutral-5);
  }

  portfolio-feed :global(.mini-kept) {
    fill: var(--neutral-8);
  }

  portfolio-feed :global(.mini-ring) {
    fill: none;
    stroke: var(--foreground);
    stroke-width: 24;
  }

  portfolio-feed :global(.alloc-sep) {
    color: var(--muted-foreground);
  }

  portfolio-feed :global(.alloc-here b) {
    font-family: var(--font-mono);
    font-weight: var(--font-weight-medium);
    font-feature-settings: normal;
  }

  /* The map's height comes from the column's width, never its content. */
  .alloc-map {
    position: relative;
    block-size: clamp(15rem, 50cqi, 25rem);
  }

  .alloc-map:not(:has(svg)) {
    border-radius: var(--radius-lg);
    background-color: var(--muted);
  }

  @container (width < 30rem) {
    .alloc-map {
      block-size: 90cqi;
    }

    portfolio-feed :global(.alloc-back-map) {
      display: none;
    }
  }

  portfolio-feed :global(.alloc-svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: hidden;
    touch-action: pan-y;
  }

  portfolio-feed :global(.alloc-tile rect) {
    fill: var(--heat-0);
  }

  portfolio-feed :global(.alloc-tile[data-dir="up"][data-level="1"] rect) {
    fill: var(--heat-1);
  }
  portfolio-feed :global(.alloc-tile[data-dir="up"][data-level="2"] rect) {
    fill: var(--heat-2);
  }
  portfolio-feed :global(.alloc-tile[data-dir="up"][data-level="3"] rect) {
    fill: var(--heat-3);
  }
  portfolio-feed :global(.alloc-tile[data-dir="up"][data-level="4"] rect) {
    fill: var(--heat-4);
  }
  portfolio-feed :global(.alloc-tile[data-dir="down"][data-level="1"] rect) {
    fill: var(--down-1);
  }
  portfolio-feed :global(.alloc-tile[data-dir="down"][data-level="2"] rect) {
    fill: var(--down-2);
  }
  portfolio-feed :global(.alloc-tile[data-dir="down"][data-level="3"] rect) {
    fill: var(--down-3);
  }
  portfolio-feed :global(.alloc-tile[data-dir="down"][data-level="4"] rect) {
    fill: var(--down-4);
  }

  portfolio-feed :global(.alloc-tile[data-cash] rect) {
    stroke: var(--border-strong);
    stroke-width: 0.75;
  }

  portfolio-feed :global(.hatch-ground) {
    fill: var(--background);
  }

  portfolio-feed :global(.hatch-line) {
    stroke: var(--neutral-a9);
    stroke-width: 1;
  }

  portfolio-feed
    :global(.alloc-tile:is([data-on], [data-hover], [data-point]) rect) {
    stroke: var(--foreground);
    stroke-width: 1.5;
  }

  /* Ink on the pale grades, the page's own ground on the strong ones. */
  portfolio-feed :global(.alloc-tile text) {
    font-family: var(--font-mono);
    font-feature-settings: normal;
    fill: var(--foreground);
    text-anchor: middle;
    pointer-events: none;
  }

  portfolio-feed
    :global(.alloc-tile:is([data-level="3"], [data-level="4"]) text) {
    fill: var(--background);
  }

  portfolio-feed :global(.alloc-tick) {
    font-weight: var(--font-weight-medium);
  }

  portfolio-feed :global(.alloc-figure) {
    opacity: 0.85;
  }

  portfolio-feed :global(.alloc-svg [data-size="16"]) {
    font-size: var(--step-0);
  }
  portfolio-feed :global(.alloc-svg [data-size="14"]) {
    font-size: var(--step--1);
  }
  portfolio-feed :global(.alloc-svg [data-size="12"]) {
    font-size: var(--step--2);
  }

  portfolio-feed :global(.alloc-ring) {
    fill: none;
    stroke: var(--foreground);
    stroke-width: 1.5;
    stroke-dasharray: var(--chart-dash-level);
    pointer-events: none;
    visibility: hidden;
  }

  /* The lens's target: the invested block ringed, the rest stepped back. */
  portfolio-feed :global(.alloc-map[data-lens]:not([data-zoomed]) .alloc-ring) {
    visibility: visible;
  }

  portfolio-feed
    :global(.alloc-map[data-lens]:not([data-zoomed]) .alloc-tile[data-aside]) {
    opacity: 0.4;
  }

  portfolio-feed :global(.alloc-map[data-lens] .alloc-svg) {
    cursor: zoom-in;
  }

  /* The lens tab: an ink chip beside the heading. */
  portfolio-feed :global(.alloc-lens) {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.05rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--foreground);
    font-size: var(--step--2);
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    color: var(--background);
    cursor: zoom-in;
  }

  portfolio-feed :global(.alloc-lens svg) {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
  }

  portfolio-feed :global(.alloc-lens:focus-visible) {
    outline-offset: 2px;
  }

  /* The card a hovered tile shows: its mark, name and figures. */
  portfolio-feed :global(.alloc-card) {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: var(--space-2xs);
    inline-size: max-content;
    min-inline-size: 12rem;
    max-inline-size: min(17rem, 100%);
    padding: var(--space-xs) var(--space-s);
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--radius-lg);
    background-color: var(--background);
    font-size: var(--step--1);
    pointer-events: none;
  }

  portfolio-feed :global(.alloc-card-head) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2xs);
  }

  portfolio-feed :global(.alloc-card-names) {
    display: grid;
    min-inline-size: 0;
    line-height: 1.3;
  }

  portfolio-feed :global(.alloc-card-title) {
    font-weight: var(--font-weight-display);
  }

