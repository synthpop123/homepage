---
/**
 * The post's Markdown source, served at `href`: a chip that copies it on
 * click (the Markdown mark turning into a check), beside an arrow that
 * opens it.
 */

import ArrowUpRight from "@/assets/icons/arrow-up-right.svg"
import CheckIcon from "@/assets/icons/check.svg"
import MarkdownIcon from "@/assets/icons/markdown.svg"

type Props = { href: string }

const { href } = Astro.props
---

<copy-markdown>
  <button type="button">
    <span class="glyph" aria-hidden="true">
      <MarkdownIcon data-idle />
      <CheckIcon data-done />
    </span>
    Copy Markdown
  </button>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Open as Markdown"
    title="Open as Markdown"
  >
    <ArrowUpRight aria-hidden="true" />
  </a>
  <span class="sr" aria-live="polite"></span>
</copy-markdown>

<style>
  /* One soft chip split in two — no border, so it sits in the meta row as
     an object rather than a form control; the hairline between the halves
     is the only line it draws. */
  copy-markdown {
    display: inline-flex;
    align-items: stretch;
    margin-inline-start: auto;
    border-radius: var(--radius-md);
    background-color: color-mix(in oklab, var(--muted) 70%, transparent);
    white-space: nowrap;
    overflow: hidden;
  }

  button,
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding-block: 0.25rem;
    color: var(--muted-foreground);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;

    &:hover {
      color: var(--foreground);
      background-color: var(--muted);
    }

    &:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: -2px;
    }

    svg {
      flex: none;
      inline-size: 0.875em;
      block-size: 0.875em;
    }
  }

  button {
    padding-inline: 0.5rem;
  }

  a {
    padding-inline: 0.4rem;
    text-decoration-line: none;
    border-inline-start: 1px solid
      color-mix(in oklab, var(--border) 70%, transparent);
  }

  /* The mark turns into a check in place, so the chip never
     changes width — the label stays put and only the glyph answers. */
  .glyph {
    display: grid;
    place-items: center;

    [data-idle] {
      inline-size: 1.15em;
      block-size: 1.15em;
    }

    > * {
      grid-area: 1 / 1;
      transition:
        opacity 0.2s ease,
        scale 0.2s ease;
    }
  }

  [data-done] {
    opacity: 0;
    scale: 0.5;
  }

  /* Only the glyph answers: brightening the text as well reads as a hover
     stuck on for two seconds after the pointer has left. */
  button[data-state="copied"] {
    [data-idle] {
      opacity: 0;
      scale: 0.5;
    }

    [data-done] {
      opacity: 1;
      scale: 1;
    }
  }

  button[data-state="error"] {
    color: var(--destructive);
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph > * {
      transition: none;
    }
  }
</style>

<script>
  import { copyText } from "@/lib/client/copy"

  for (const el of document.querySelectorAll<HTMLElement>("copy-markdown")) {
    const button = el.querySelector("button")
    const status = el.querySelector("[aria-live]")
    const source = el.querySelector("a")?.href
    if (!button || !status || !source) continue

    let markdown: Promise<string> | undefined
    // Prefetch so clipboard.writeText usually runs during user activation.
    const load = () =>
      (markdown ??= fetch(source)
        .then((res) => {
          if (!res.ok) throw new Error(`${source}: ${res.status}`)
          return res.text()
        })
        .catch((error) => {
          markdown = undefined
          throw error
        }))

    // The click path reports failure; a warm-up that fails is just a
    // cache miss, so swallow it rather than leaving it unhandled.
    const warm = () => void load().catch(() => {})
    el.addEventListener("pointerenter", warm)
    el.addEventListener("focusin", warm)

    button.addEventListener("click", () =>
      copyText(
        button,
        status,
        load(),
        "Copy failed — open the Markdown instead",
      ),
    )
  }
</script>
