---
/**
 * The post's Markdown source, served at `href`: an icon chip at the end
 * of the byline row, the Markdown mark copying it on click (and turning
 * into a check), beside an arrow that opens it.
 */

import ArrowUpRight from "@/assets/icons/arrow-up-right.svg"
import CheckIcon from "@/assets/icons/check.svg"
import MarkdownIcon from "@/assets/icons/markdown.svg"

type Props = { href: string }

const { href } = Astro.props
---

<copy-markdown>
  <button type="button" aria-label="Copy Markdown" title="Copy Markdown">
    <span class="glyph" aria-hidden="true">
      <MarkdownIcon data-idle />
      <CheckIcon data-done />
    </span>
  </button>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Open as Markdown"
    title="Open as Markdown"
  >
    <ArrowUpRight aria-hidden="true" />
  </a>
  <span class="sr" aria-live="polite"></span>
</copy-markdown>

<style>
  /* One chip split in two: a neutral 3 fill, no border, and a hairline
     between the halves. Icons only, so it ends the byline's line instead
     of wrapping onto one of its own. */
  copy-markdown {
    display: inline-flex;
    align-items: stretch;
    margin-inline-start: auto;
    border-radius: var(--radius-md);
    background-color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
  }

  button,
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding-block: 0.25rem;
    color: var(--muted-foreground);
    cursor: pointer;

    &:hover {
      color: var(--foreground);
      background-color: var(--muted-hover);
    }

    &:active {
      background-color: var(--muted-active);
    }

    &:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: -2px;
    }

    svg {
      flex: none;
      inline-size: 0.875em;
      block-size: 0.875em;
    }
  }

  button {
    padding-inline: 0.45rem;
  }

  a {
    padding-inline: 0.4rem;
    text-decoration-line: none;
    border-inline-start: var(--hairline) solid var(--border);
  }

  /* The mark turns into a check in place, so the chip never
     changes width. */
  .glyph {
    display: grid;
    place-items: center;

    [data-idle] {
      inline-size: 1.15em;
      block-size: 1.15em;
    }

    > * {
      grid-area: 1 / 1;
      transition: opacity var(--duration) var(--ease);
    }
  }

  [data-done] {
    opacity: 0;
  }

  button[data-state="copied"] {
    [data-idle] {
      opacity: 0;
    }

    [data-done] {
      opacity: 1;
    }
  }

  button[data-state="error"] {
    color: var(--destructive);
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph > * {
      transition: none;
    }
  }
</style>

<script>
  import { copyText } from "@/lib/client/copy"

  for (const el of document.querySelectorAll<HTMLElement>("copy-markdown")) {
    const button = el.querySelector("button")
    const status = el.querySelector("[aria-live]")
    const source = el.querySelector("a")?.href
    if (!button || !status || !source) continue

    let markdown: Promise<string> | undefined
    // Prefetch so clipboard.writeText usually runs during user activation.
    const load = () =>
      (markdown ??= fetch(source)
        .then((res) => {
          if (!res.ok) throw new Error(`${source}: ${res.status}`)
          return res.text()
        })
        .catch((error) => {
          markdown = undefined
          throw error
        }))

    // The click path reports failure; a warm-up that fails is just a
    // cache miss, so swallow it rather than leaving it unhandled.
    const warm = () => void load().catch(() => {})
    el.addEventListener("pointerenter", warm)
    el.addEventListener("focusin", warm)

    button.addEventListener("click", () =>
      copyText(
        button,
        status,
        load(),
        "Copy failed — open the Markdown instead",
      ),
    )
  }
</script>
