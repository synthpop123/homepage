---
import ArrowUpRight from "@/assets/icons/arrow-up-right.svg"
import CheckIcon from "@/assets/icons/check.svg"
import CopyIcon from "@/assets/icons/copy.svg"

type Props = { href: string }

const { href } = Astro.props
---

<copy-markdown>
  <button type="button">
    <span><CopyIcon aria-hidden="true" />Copy Markdown</span>
    <span><CheckIcon aria-hidden="true" />Copied!</span>
  </button>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View as Markdown"
    title="View as Markdown"
  >
    <ArrowUpRight aria-hidden="true" />
  </a>
</copy-markdown>

<style>
  copy-markdown {
    display: inline-flex;
    align-items: stretch;
    margin-inline-start: auto;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  button,
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375em;
    padding-block: 0.1875rem;
    padding-inline: 0.5rem;
    color: var(--muted-foreground);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;

    &:hover {
      color: var(--foreground);
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
    }

    &:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: -2px;
    }

    svg {
      inline-size: 0.875em;
      block-size: 0.875em;
    }
  }

  button > span {
    display: inline-flex;
    align-items: center;
    gap: 0.375em;
  }

  button > span:last-child {
    display: none;
  }

  button[data-state="copied"] {
    > span:first-child {
      display: none;
    }

    > span:last-child {
      display: inline-flex;
    }
  }

  button[data-state="error"] {
    color: var(--destructive);
  }

  a {
    padding-inline: 0.4375rem;
    text-decoration-line: none;
    border-inline-start: 1px solid var(--border);
  }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>("copy-markdown")) {
    const button = el.querySelector("button")
    const source = el.querySelector("a")?.href
    if (!button || !source) continue

    let markdown: Promise<string> | undefined
    // Prefetch so clipboard.writeText usually runs during user activation.
    const load = () =>
      (markdown ??= fetch(source)
        .then((res) => {
          if (!res.ok) throw new Error(`${source}: ${res.status}`)
          return res.text()
        })
        .catch((error) => {
          markdown = undefined
          throw error
        }))

    // The click path reports failure; a warm-up that fails is just a
    // cache miss, so swallow it rather than leaving it unhandled.
    const warm = () => void load().catch(() => {})
    el.addEventListener("pointerenter", warm)
    el.addEventListener("focusin", warm)

    let reset: ReturnType<typeof setTimeout> | undefined
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(await load())
        button.dataset.state = "copied"
      } catch {
        button.dataset.state = "error"
        button.title = "Copy failed — open the Markdown instead"
      }
      clearTimeout(reset)
      reset = setTimeout(() => {
        delete button.dataset.state
        button.removeAttribute("title")
      }, 2000)
    })
  }
</script>
