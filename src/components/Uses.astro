---
/**
 * The hardware I actually use, grouped by where it lives rather than by
 * category — a thing's place says more about how often it gets touched
 * than its product class does. Static build-time data from `USES`.
 */

import "@/styles/feed.css"
import BookOpenIcon from "@/assets/icons/uses/book-open.svg"
import HeadphonesIcon from "@/assets/icons/uses/headphones.svg"
import KeyboardIcon from "@/assets/icons/uses/keyboard.svg"
import LaptopIcon from "@/assets/icons/uses/laptop.svg"
import MonitorIcon from "@/assets/icons/uses/monitor.svg"
import MouseIcon from "@/assets/icons/uses/mouse.svg"
import SmartphoneIcon from "@/assets/icons/uses/smartphone.svg"
import SpeakerIcon from "@/assets/icons/uses/speaker.svg"
import WatchIcon from "@/assets/icons/uses/watch.svg"
import { USES, type UsesIcon } from "@/consts"

/**
 * One mark per thing, keyed by the `UsesIcon` union — a device list reads
 * as a list of shapes before it reads as words, and the shape is what
 * tells a keyboard from a speaker at a glance. Typed as a full record, so
 * an icon added to `USES` without an SVG here fails the build.
 */
const MARKS: Record<UsesIcon, typeof LaptopIcon> = {
  laptop: LaptopIcon,
  monitor: MonitorIcon,
  keyboard: KeyboardIcon,
  mouse: MouseIcon,
  speaker: SpeakerIcon,
  smartphone: SmartphoneIcon,
  watch: WatchIcon,
  headphones: HeadphonesIcon,
  "book-open": BookOpenIcon,
}
---

<uses-list>
  {USES.map(({ group, items }) => (
    <uses-group>
      <h3 class="uses-label">{group}</h3>
      <dl>
        {items.map(({ name, note, icon }) => {
          const Mark = MARKS[icon]
          return (
            <div>
              <dt>
                {name}
                <span class="mark"><Mark aria-hidden="true" /></span>
              </dt>
              <dd>{note}</dd>
            </div>
          )
        })}
      </dl>
    </uses-group>
  ))}
</uses-list>

<style>
  /* The section sizes itself against its own column rather than the
     viewport: between 64rem and 76rem the sidebar and the table of
     contents take their cut first, so a viewport query would lay out
     three columns while the column itself is still narrow. */
  uses-list {
    display: grid;
    gap: var(--space-l);
    container-type: inline-size;
  }

  uses-group {
    display: grid;
    gap: var(--space-s);
  }

  /* The feeds' uppercase label, bare: the cards under it already say
     where the group starts and ends, so a rule or a count would only
     repeat them. */
  .uses-label {
    margin: 0;
  }

  /* A bento: the first thing in a group is the one it is built around, so
     it takes two cells; a group left one cell short hands the gap to its
     last card rather than leaving a hole. Two columns or three, the rows
     come out full either way for groups of four and five. */
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs);
    margin: 0;

    @container (width >= 34rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  dl > div {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-s);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background-color: color-mix(in oklab, var(--muted) 45%, transparent);
    line-height: 1.4;
    isolation: isolate;

    &:first-child,
    &:last-child:nth-child(even) {
      grid-column: span 2;
    }

    /* Two across, a card is as tall as its words. Three across, the
       words are short enough that the mark would crowd them, so the
       card keeps a little room under them. */
    @container (width >= 34rem) {
      min-block-size: 7rem;
    }
  }

  dt {
    font-weight: var(--font-weight-medium);
    text-wrap: balance;
  }

  dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);
    text-wrap: pretty;
  }

  /* The mark has to live in the dt (a dl's div admits only dt and dd), but
     it is positioned against the card, so where it sits in the markup
     costs the layout nothing. It is the card's backdrop rather than a chip beside its name:
     drawn large, faint and cropped by the corner, it says what the thing
     is before the words do, and costs the text no width. The stroke is
     thinned so it scales up as a line drawing instead of a slab. */
  .mark {
    position: absolute;
    z-index: -1;
    inset-block-end: -0.15em;
    inset-inline-end: -0.15em;
    font-size: 4.5rem;
    line-height: 0;
    color: color-mix(in oklab, var(--foreground) 9%, transparent);
    transition:
      color 0.3s ease,
      transform 0.3s ease;

    & :global(g) {
      stroke-width: 1.25;
    }
  }

  /* The anchor card reads a size up: a bigger name, and a mark with room
     to be the largest thing in the group. */
  dl > div:first-child {
    & dt {
      font-size: var(--step-1);
    }

    & .mark {
      font-size: 7.5rem;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    dl > div:hover .mark {
      color: color-mix(in oklab, var(--foreground) 16%, transparent);
      transform: translate(-0.04em, -0.04em) rotate(-4deg);
    }
  }
</style>
