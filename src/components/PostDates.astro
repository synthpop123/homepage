---
/**
 * When a post was written, and when it last changed. A revised post
 * leads with the newer date, the one that says how current it is, and
 * keeps the first as an aside — `Updated Oct 10, 2026   Published Jul 4`.
 * The first date drops a year the newer one already states.
 */

import { formatDate, formatMonthDay } from "@/lib/utils"

type Props = { date: Date; updated?: Date }

const { date, updated } = Astro.props
const revised =
  updated && formatDate(updated) !== formatDate(date) ? updated : undefined
const first =
  revised && revised.getUTCFullYear() === date.getUTCFullYear()
    ? formatMonthDay(date)
    : formatDate(date)
---

<post-dates>
  {revised ? (
      <>
        <span>
          Updated <time datetime={revised.toISOString()} data-revised>
            {formatDate(revised)}
          </time>
        </span>
        <span data-first>
          <span>Published</span>
          <time datetime={date.toISOString()}>{first}</time>
        </span>
      </>
    ) : (
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    )}
</post-dates>

<style>
  post-dates {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-xs);

    /* On a phone the two dates outgrow the byline's row: they take a
       line of their own. */
    @media (width < 40rem) {
      &:has([data-revised]) {
        flex-basis: 100%;
      }
    }
  }

  [data-revised] {
    color: var(--foreground);
  }

  /* The first date is history: kept, but set back, and never split
     from its label when the row wraps. */
  [data-first] {
    display: inline-flex;
    gap: 0.25em;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
</style>
