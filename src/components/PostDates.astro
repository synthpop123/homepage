---
/**
 * When a post was written, and when it last changed: one date, or a span
 * from the first to the latest — `Jun 16 ⇢ Aug 20, 2026` — read as the
 * post's life so far rather than as two unrelated stamps. The first date
 * drops a year the second already states.
 */

import { formatDate, formatMonthDay } from "@/lib/utils"

type Props = { date: Date; updated?: Date }

const { date, updated } = Astro.props
const revised =
  updated && formatDate(updated) !== formatDate(date) ? updated : undefined
const since =
  revised && revised.getUTCFullYear() === date.getUTCFullYear()
    ? formatMonthDay(date)
    : formatDate(date)
const title = revised
  ? `Published ${formatDate(date)} · Updated ${formatDate(revised)}`
  : undefined
---

<post-dates title={title}>
  {revised ? (
      <>
        <span class="sr">Published</span>
        <time datetime={date.toISOString()}>{since}</time>
        <svg
          viewBox="0 0 24 8"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path class="shaft" d="M1.5 4h17" />
          <path d="M18.5 1.5 21.5 4l-3 2.5" />
        </svg>
        <span class="sr">, updated</span>
        <time datetime={revised.toISOString()} data-revised>
          {formatDate(revised)}
        </time>
      </>
    ) : (
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    )}
</post-dates>

<style>
  post-dates {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);

    &:not(:first-child)::before {
      content: "·";
    }
  }

  /* A dashed stretch between the two dates, arrowed toward the latest:
     time passing, not a separator. */
  svg {
    flex: none;
    inline-size: 1.75em;
    block-size: 0.6em;
    color: color-mix(in oklab, var(--muted-foreground) 55%, transparent);
    stroke-width: 1.25;
  }

  .shaft {
    stroke-dasharray: 1.5 2.5;
  }

  /* The latest date is the one that says how current the post is. */
  [data-revised] {
    color: var(--foreground);
  }

  /* On hover the dashes march toward the newer date. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    post-dates:hover .shaft {
      animation: march 0.6s linear infinite;
    }
  }

  @keyframes march {
    to {
      stroke-dashoffset: -4;
    }
  }
</style>
