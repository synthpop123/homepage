---
import MastodonIcon from "@/assets/icons/mastodon.svg"
import { MASTODON } from "@/consts"

type Props = {
  limit?: number
}

const { limit = MASTODON.limit } = Astro.props
const { instance, username, accountId } = MASTODON

const profileUrl = `${instance}/@${username}`
---

<mastodon-feed
  data-instance={instance}
  data-account-id={accountId}
  data-limit={limit}
  aria-busy="true"
>
  <p class="mastodon-intro">
    Pulled live from my
    <MastodonIcon class="mastodon-mark" aria-hidden="true" />
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>
    instance.
  </p>
  <ol class="mastodon-list">
    {Array.from({ length: 3 }).map(() => (
        <li class="note" data-skeleton aria-hidden="true">
          <span class="sk sk-line" style="inline-size: 92%" />
          <span class="sk sk-line" style="inline-size: 64%" />
          <span
            class="sk sk-line"
            style="inline-size: 5rem; block-size: 0.7em; margin-inline-start: auto"
          />
          <span class="sk sk-media" />
        </li>
      ))}
  </ol>
  <p class="mastodon-fallback" hidden>
    Couldn’t load posts right now — read them on
    <a href={profileUrl} target="_blank" rel="noopener noreferrer">Mastodon</a>.
  </p>
</mastodon-feed>

<script>
  type Emoji = { shortcode: string; url: string; static_url?: string }

  type ImageDim = { width?: number; height?: number }

  type MediaAttachment = {
    type: string
    url: string
    preview_url?: string
    description?: string | null
    meta?: { small?: ImageDim; original?: ImageDim }
  }

  type Status = {
    id: string
    url: string
    content?: string
    created_at: string
    edited_at?: string | null
    emojis?: Emoji[]
    media_attachments?: MediaAttachment[]
    reblog?: unknown
  }

  const ALLOWED = new Set([
    "P",
    "BR",
    "A",
    "SPAN",
    "STRONG",
    "B",
    "EM",
    "I",
    "DEL",
    "CODE",
    "PRE",
    "BLOCKQUOTE",
    "UL",
    "OL",
    "LI",
  ])

  const dateFormatter = new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "Asia/Shanghai",
  })

  const el = (tag: string, className?: string) => {
    const node = document.createElement(tag)
    if (className) node.className = className
    return node
  }

  const stripTags = (html?: string) => (html ?? "").replace(/<[^>]*>/g, "")

  const emojiMap = (emojis?: Emoji[]) => {
    const map: Record<string, string> = {}
    for (const e of emojis ?? []) {
      if (e.shortcode) map[e.shortcode] = e.url || e.static_url || ""
    }
    return map
  }

  const emojify = (text: string, map: Record<string, string>) => {
    const out: (string | Node)[] = []
    let last = 0
    const re = /:([a-zA-Z0-9_]+):/g
    let match: RegExpExecArray | null
    while ((match = re.exec(text))) {
      const url = map[match[1]]
      if (!url) continue
      if (match.index > last) out.push(text.slice(last, match.index))
      const img = el("img", "emoji") as HTMLImageElement
      img.src = url
      img.alt = match[0]
      img.draggable = false
      out.push(img)
      last = re.lastIndex
    }
    if (last < text.length) out.push(text.slice(last))
    return out.length ? out : [text]
  }

  const sanitize = (node: Node, map: Record<string, string>) => {
    const frag = document.createDocumentFragment()
    node.childNodes.forEach((child) => {
      if (child.nodeType === Node.TEXT_NODE) {
        frag.append(...emojify(child.textContent ?? "", map))
      } else if (child.nodeType === Node.ELEMENT_NODE) {
        const source = child as Element
        if (!ALLOWED.has(source.tagName)) {
          frag.append(sanitize(source, map))
          return
        }
        const clone = el(source.tagName.toLowerCase())
        if (source.tagName === "A") {
          const href = source.getAttribute("href") ?? ""
          if (/^https?:\/\//i.test(href)) {
            clone.setAttribute("href", href)
            clone.setAttribute("target", "_blank")
            clone.setAttribute("rel", "nofollow noopener noreferrer")
          }
          const cls = source.getAttribute("class")
          if (cls) clone.setAttribute("class", cls)
        } else if (source.tagName === "SPAN") {
          const cls = source.getAttribute("class")
          if (cls) clone.setAttribute("class", cls)
        }
        clone.append(sanitize(source, map))
        frag.append(clone)
      }
    })
    return frag
  }

  const toFragment = (html: string, map: Record<string, string>) =>
    sanitize(new DOMParser().parseFromString(html, "text/html").body, map)

  const renderMedia = (status: Status) => {
    const images = (status.media_attachments ?? []).filter(
      (m) => m.type === "image",
    )
    if (!images.length) return null

    const media = images[0]
    const figure = el("figure", "note-media")
    const link = el("a") as HTMLAnchorElement
    link.href = media.url
    link.target = "_blank"
    link.rel = "noopener noreferrer"

    const small = media.meta?.small
    const original = media.meta?.original
    const dim = original ?? small
    if (dim?.width && dim?.height) {
      figure.style.aspectRatio = `${dim.width} / ${dim.height}`
    }

    const img = el("img") as HTMLImageElement
    const srcset: string[] = []
    if (media.preview_url && small?.width)
      srcset.push(`${media.preview_url} ${small.width}w`)
    if (original?.width) srcset.push(`${media.url} ${original.width}w`)
    if (srcset.length > 1) {
      img.src = media.preview_url || media.url
      img.srcset = srcset.join(", ")
      img.sizes = "(min-width: 64rem) 42rem, 100vw"
    } else {
      img.src = media.url
    }
    img.alt =
      media.description || stripTags(status.content).trim() || "Attached image"
    img.loading = "lazy"
    img.decoding = "async"
    if (dim?.width && dim?.height) {
      img.width = dim.width
      img.height = dim.height
    }
    const reveal = () => img.classList.add("is-loaded")
    img.addEventListener("load", reveal)
    img.addEventListener("error", () => {
      if (media.preview_url && !img.src.endsWith(media.preview_url)) {
        img.removeAttribute("srcset")
        img.src = media.preview_url
      } else {
        reveal()
      }
    })
    if (img.complete && img.naturalWidth > 0) reveal()
    link.append(img)
    figure.append(link)

    const extra = (status.media_attachments ?? []).length - 1
    if (extra > 0) {
      const badge = el("span", "note-media-more")
      badge.textContent = `+${extra}`
      figure.append(badge)
    }
    return figure
  }

  const renderStatus = (status: Status) => {
    const item = el("li", "note")
    const article = el("article")
    const map = emojiMap(status.emojis)

    if (status.content && stripTags(status.content).trim()) {
      const content = el("prose-content", "note-content")
      content.append(toFragment(status.content, map))
      article.append(content)
    }

    const footer = el("footer", "note-foot")
    const permalink = el("a", "note-time") as HTMLAnchorElement
    permalink.href = status.url
    permalink.target = "_blank"
    permalink.rel = "noopener noreferrer"
    const time = el("time") as HTMLTimeElement
    const date = new Date(status.created_at)
    time.dateTime = date.toISOString()
    time.textContent = dateFormatter.format(date)
    permalink.append(time)
    if (status.edited_at) {
      const edited = el("span", "note-edited")
      edited.textContent = "edited"
      permalink.append(" · ", edited)
    }
    footer.append(permalink)
    article.append(footer)

    const media = renderMedia(status)
    if (media) article.append(media)

    item.append(article)
    return item
  }

  document.querySelectorAll<HTMLElement>("mastodon-feed").forEach((feed) => {
    const list = feed.querySelector<HTMLOListElement>(".mastodon-list")
    const fallback = feed.querySelector<HTMLElement>(".mastodon-fallback")
    const { instance, accountId } = feed.dataset
    if (!instance || !accountId || !list) return

    const limit = Number(feed.dataset.limit) || 20

    fetch(
      `${instance}/api/v1/accounts/${accountId}/statuses?exclude_replies=true&exclude_reblogs=true&limit=${limit}`,
    )
      .then((response) => {
        if (!response.ok) throw new Error(`Request failed: ${response.status}`)
        return response.json() as Promise<Status[]>
      })
      .then((statuses) => {
        const valid = (Array.isArray(statuses) ? statuses : []).filter(
          (status) => !status.reblog,
        )
        if (!valid.length) throw new Error("No statuses")

        const fragment = document.createDocumentFragment()
        for (const status of valid) fragment.append(renderStatus(status))
        list.replaceChildren(fragment)
        feed.setAttribute("aria-busy", "false")
      })
      .catch(() => {
        list.hidden = true
        if (fallback) fallback.hidden = false
        feed.setAttribute("aria-busy", "false")
      })
  })
</script>

<style>
  mastodon-feed {
    display: block;
  }

  .mastodon-intro {
    margin-block: 0 var(--space-l);
    padding-block-end: var(--space-l);
    border-block-end: 1px solid var(--border);
    color: var(--muted-foreground);
  }

  .mastodon-intro a {
    color: var(--foreground);
    text-decoration: underline;
  }

  .mastodon-mark {
    display: inline-block;
    inline-size: 1.1em;
    block-size: 1.1em;
    vertical-align: -0.18em;
  }

  .mastodon-list {
    display: flex;
    flex-direction: column;
  }

  mastodon-feed :global(.note + .note) {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);
  }

  mastodon-feed :global(.note article) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  mastodon-feed :global(.note-content) {
    overflow-wrap: anywhere;
  }

  mastodon-feed :global(.invisible) {
    display: none;
  }

  mastodon-feed :global(.ellipsis::after) {
    content: "…";
  }

  mastodon-feed :global(.emoji) {
    display: inline-block;
    inline-size: 1.25em;
    block-size: 1.25em;
    margin-inline: 0.05em;
    object-fit: contain;
    vertical-align: text-bottom;
  }

  mastodon-feed :global(.note-media) {
    position: relative;
    margin: 0;
    max-block-size: 40rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--muted);
  }

  mastodon-feed :global(.note-media a) {
    display: block;
    block-size: 100%;
  }

  mastodon-feed :global(.note-media img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  mastodon-feed :global(.note-media img.is-loaded) {
    opacity: 1;
  }

  mastodon-feed :global(.note-media-more) {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    padding: 0.1em 0.55em;
    font-size: var(--step--1);
    color: var(--gray-1);
    background-color: color-mix(in oklab, var(--gray-12) 65%, transparent);
    border-radius: var(--radius-full);
    backdrop-filter: blur(var(--blur-sm));
  }

  mastodon-feed :global(.note-foot) {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  mastodon-feed :global(.note-time) {
    margin-inline-start: auto;
    color: var(--muted-foreground);
    text-decoration: none;
  }

  mastodon-feed :global(.note-time:hover) {
    color: var(--foreground);
  }

  .sk {
    background-color: var(--gray-5);
    border-radius: var(--radius-sm);
    animation: mastodon-pulse 1.6s ease-in-out infinite;
  }

  .sk-line {
    display: block;
    block-size: 0.85em;
    margin-block-end: var(--space-2xs);
  }

  .sk-media {
    display: block;
    aspect-ratio: var(--aspect-video);
    border-radius: var(--radius-lg);
  }

  @keyframes mastodon-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sk {
      animation: none;
    }

    mastodon-feed :global(.note-media img) {
      transition: none;
    }
  }
</style>
