---
import ArrowUp from "@/assets/icons/arrow-up.svg"
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import type { MarkdownHeading } from "astro"

type Section = {
  id?: string
  label: string
  open?: boolean
  headings: MarkdownHeading[]
}
type Props = { title: string; sections: Section[] }

const { title, sections } = Astro.props
---

<nav aria-label="Table of contents">
  <toc-progress aria-hidden="true">
    <svg viewBox="0 0 40 40">
      <circle cx="20" cy="20" r="18" />
      <circle cx="20" cy="20" r="18" transform="rotate(-90 20 20)" />
    </svg>
    <span>0%</span>
  </toc-progress>
  <toc-bar data-bar>
    <button type="button" data-toc-top aria-label="Scroll to top">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="8" cy="8" r="6.5" />
        <circle cx="8" cy="8" r="6.5" transform="rotate(-90 8 8)" />
      </svg>
      <ArrowUp aria-hidden="true" />
    </button>
    <label>
      <input type="checkbox" aria-label="Toggle table of contents">
      <toc-current>{title}</toc-current>
      <ChevronIcon aria-hidden="true" />
    </label>
  </toc-bar>
  <ul data-bar>
    {sections.map(({ id, label, open, headings }) =>
        id ? (
          <li data-group>
            {headings.length > 0 ? (
              <details open={open || undefined}>
                <summary>
                  <a href={`#${id}`}>{label}</a>
                  <ChevronIcon aria-hidden="true" />
                </summary>
                <ul>
                  {headings.map(({ depth, slug, text }) => (
                    <li data-depth={depth}>
                      <a href={`#${slug}`}>{text}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={`#${id}`}>{label}</a>
            )}
          </li>
        ) : (
          headings.map(({ depth, slug, text }) => (
            <li data-depth={depth}>
              <a href={`#${slug}`}>{text}</a>
            </li>
          ))
        ),
      )}
  </ul>
</nav>

<style>
  /* How far down the page the reader is, 0 to 1, drawn by both rings.
     Registered so it can be animated: where the browser has scroll-driven
     animations the page's own scroll drives it, off the main thread, and
     the script below only writes the percentage; elsewhere the script
     sets it on every scroll. */
  @property --progress {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  @keyframes toc-progress {
    to {
      --progress: 1;
    }
  }

  nav {
    /* Longhands: the minifier would fold a shorthand and the timeline
       into one `animation`, which can't carry a timeline. */
    @supports (animation-timeline: scroll()) {
      animation-name: toc-progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
    }

    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    max-height: calc(
      100svh -
      var(--page-offset-top) -
      var(--page-offset-bottom)
    );
    font-size: var(--step--1);

    @media (width < 76rem) {
      position: relative;
      top: auto;
      max-height: none;
    }
  }

  toc-progress {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-block-end: var(--space-s);

    > * {
      grid-area: 1 / 1;
    }

    svg {
      inline-size: 100%;
      block-size: 100%;
    }

    circle {
      fill: none;
      stroke: var(--border);
      stroke-width: 2.5;

      &:last-child {
        --circumference: calc(2 * pi * 18px);

        stroke: var(--accent-fill);
        stroke-linecap: round;
        stroke-dasharray: var(--circumference);
        stroke-dashoffset: calc(
          var(--circumference) *
          (1 - var(--progress, 0))
        );
      }
    }

    span {
      font-size: var(--step--2);
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);
    }

    @media (width < 76rem) {
      display: none;
    }
  }

  /* The bar the TOC is below 76rem: the progress ring, then the current
     section, which opens the list. The ring is the way back to the top:
     once the page has scrolled an arrow shows inside it. */
  toc-bar {
    display: none;

    @media (width < 76rem) {
      display: flex;
      align-items: center;
      gap: var(--space-2xs);
    }
  }

  button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    /* A 24px target around a ring the size of the text's line. */
    margin: -0.125rem;
    padding: 0.125rem;
    border-radius: var(--radius-full);
    cursor: pointer;

    > * {
      grid-area: 1 / 1;
    }

    > svg:first-child {
      inline-size: 1.25rem;
      block-size: 1.25rem;

      circle {
        fill: none;
        stroke: var(--border);
        stroke-width: 1.75;

        &:last-child {
          --circumference: calc(2 * pi * 6.5px);

          stroke: var(--accent-fill);
          stroke-dasharray: var(--circumference);
          stroke-dashoffset: calc(
            var(--circumference) *
            (1 - var(--progress, 0))
          );
        }
      }
    }

    > svg:last-child {
      inline-size: 0.625rem;
      block-size: 0.625rem;
      color: var(--foreground);
      visibility: hidden;
    }

    &[data-past] > svg:last-child {
      visibility: visible;
    }
  }

  label {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-2xs);
    min-width: 0;
    cursor: pointer;

    input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    toc-current {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--muted-foreground);
    }

    > svg {
      flex-shrink: 0;
      inline-size: 1em;
      block-size: 1em;
      color: var(--muted-foreground);
    }
  }

  nav:has(input:focus-visible) label {
    @media (width < 76rem) {
      outline: 2px solid var(--ring);
      outline-offset: -2px;
    }
  }

  nav:has(input:checked) label > svg {
    @media (width < 76rem) {
      rotate: 180deg;
    }
  }

  nav > ul {
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media (width < 76rem) {
      display: none;
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      max-block-size: 30svh;
    }
  }

  nav:has(input:checked) > ul {
    @media (width < 76rem) {
      display: flex;
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      color: var(--muted-foreground);

      &:hover,
      &[data-active] {
        color: var(--foreground);
      }

      &[aria-current="location"] {
        font-weight: var(--font-weight-medium);
      }
    }

    li[data-group] {
      font-weight: var(--font-weight-medium);

      &:not(:first-child) {
        margin-block-start: var(--space-2xs);
      }

      summary {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
          display: none;
        }

        a {
          min-inline-size: 0;
        }

        svg {
          flex-shrink: 0;
          margin-inline-start: auto;
          inline-size: 1em;
          block-size: 1em;
          color: var(--muted-foreground);
        }

        &:hover svg {
          color: var(--foreground);
        }
      }

      details[open] > summary svg {
        rotate: 180deg;
      }

      details > ul {
        --shift: 1;

        margin-block-start: var(--space-3xs);
        font-weight: var(--font-weight-normal);
      }

      details:not([open]):has(a[data-active]) summary a {
        color: var(--foreground);
      }
    }

    li[data-depth] {
      padding-inline-start: calc(
        (var(--shift, 0) + var(--indent, 0)) *
        var(--space-xs)
      );
    }

    li[data-depth="3"] {
      --indent: 1;
    }

    li[data-depth="4"] {
      --indent: 2;
    }
  }
</style>

<script>
  import { hashId } from "@/lib/utils"

  ;(() => {
    const nav = document.querySelector<HTMLElement>("page-toc nav")
    if (!nav) return

    const percent = nav.querySelector("toc-progress span")
    // With a scroll timeline the rings follow the scroll in CSS; the
    // percentage is text, so it stays here either way.
    const driven = CSS.supports("animation-timeline: scroll()")
    const progress = () => {
      const max = document.documentElement.scrollHeight - innerHeight
      const read = max > 0 ? Math.min(scrollY / max, 1) : 0
      if (!driven) nav.style.setProperty("--progress", String(read))
      if (percent) percent.textContent = `${Math.round(read * 100)}%`
    }
    // The bar's ring goes back to the top, and says so with an arrow
    // once there is a way to go.
    const top = nav.querySelector<HTMLElement>("[data-toc-top]")
    top?.addEventListener("click", () => window.scrollTo({ top: 0 }))
    const past = () =>
      top?.toggleAttribute("data-past", scrollY > innerHeight * 0.5)
    addEventListener("scroll", progress, { passive: true })
    addEventListener("scroll", past, { passive: true })
    addEventListener("resize", progress, { passive: true })
    progress()
    past()

    const seen = new Map<string, number>()
    const links = new Map<Element, HTMLAnchorElement>()
    for (const a of nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")) {
      const id = hashId(a.hash)
      const nth = seen.get(id) ?? 0
      seen.set(id, nth + 1)
      const target = document.querySelectorAll(`[id="${CSS.escape(id)}"]`)[nth]
      if (target) links.set(target, a)
    }
    // The rail owns visibility of its entries. Watch only the hidden
    // attributes on each target and its ancestors, including cached first paint.
    const syncHidden = () => {
      for (const [target, link] of links) {
        link
          .closest("li")
          ?.toggleAttribute("hidden", !!target.closest("[hidden]"))
      }
      progress()
    }
    const visibility = new MutationObserver(syncHidden)
    const watched = new Set<Element>()
    for (const target of links.keys()) {
      for (let node: Element | null = target; node; node = node.parentElement) {
        if (watched.has(node)) break
        watched.add(node)
        visibility.observe(node, {
          attributes: true,
          attributeFilter: ["hidden"],
        })
      }
    }
    syncHidden()

    const articles = document.querySelectorAll("main article, main section")
    const list = nav.querySelector(":scope > ul")
    const currentLabel = nav.querySelector("toc-current")
    const toggle = nav.querySelector<HTMLInputElement>("input")
    if (articles.length === 0 || !list || links.size === 0) return

    const fallback = currentLabel?.textContent ?? ""

    const scrollPaddingTop =
      Number.parseFloat(
        getComputedStyle(document.documentElement).scrollPaddingBlockStart,
      ) || 0

    const groups = [
      ...nav.querySelectorAll<HTMLDetailsElement>("li[data-group] details"),
    ].map((details) => ({
      details,
      active: details.open,
      anchors: [...details.querySelectorAll<HTMLAnchorElement>("a[href^='#']")],
    }))

    const blockOf = new Map<Element, Element>()
    for (const target of links.keys()) {
      const block = target.closest(
        "prose-content > *, article[data-url], main section",
      )
      if (block && !blockOf.has(block)) blockOf.set(block, target)
    }

    const sectionOf = new Map<Element, Element>()
    for (const article of articles) {
      let current = blockOf.get(article)
      for (const child of article.children) {
        if (child.tagName === "PROSE-CONTENT") {
          for (const block of child.children) {
            current = blockOf.get(block) ?? current
            if (current) sectionOf.set(block, current)
          }
        } else if (current) sectionOf.set(child, current)
      }
    }

    const visible = new Set<Element>()
    let prevActive = new Set<Element>()

    const center = () => {
      const run = [
        ...list.querySelectorAll<HTMLAnchorElement>("a[data-active]"),
      ]
      const first = run[0]
      const last = run[run.length - 1]
      if (!first || !run.every((a) => a.checkVisibility())) return
      const area = list.getBoundingClientRect()
      const runCenter =
        (first.getBoundingClientRect().top +
          last.getBoundingClientRect().bottom) /
        2
      list.scrollTo({
        top: list.scrollTop + runCenter - (area.top + area.height / 2),
      })
    }

    toggle?.addEventListener("change", () => {
      if (toggle.checked) center()
    })
    list.addEventListener("click", (event) => {
      if (toggle && (event.target as Element).closest?.("a")) {
        toggle.checked = false
      }
    })

    const observerOptions = {
      rootMargin: `-${scrollPaddingTop}px 0px 0px`,
    }
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target)
        else visible.delete(entry.target)
      }

      const activeTargets = new Set<Element>()
      for (const block of visible) {
        const target = sectionOf.get(block)
        if (target) activeTargets.add(target)
      }

      let firstActive: HTMLAnchorElement | undefined
      for (const [target, link] of links) {
        const on = activeTargets.has(target)
        link.toggleAttribute("data-active", on)
        link.removeAttribute("aria-current")
        if (on) firstActive ??= link
      }
      firstActive?.setAttribute("aria-current", "location")

      if (currentLabel) {
        const label = firstActive?.textContent?.trim() || fallback
        if (currentLabel.textContent !== label) currentLabel.textContent = label
      }

      for (const group of groups) {
        const active = group.anchors.some((a) => a.hasAttribute("data-active"))
        if (active !== group.active) {
          group.active = active
          if (active) group.details.open = true
        }
      }

      let grew = false
      for (const target of activeTargets) {
        if (!prevActive.has(target)) {
          grew = true
          break
        }
      }
      prevActive = activeTargets
      if (grew) center()
    }, observerOptions)

    for (const block of sectionOf.keys()) observer.observe(block)
  })()
</script>
