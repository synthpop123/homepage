// lkwplus.com as a static-assets-only Worker: no script, just `dist/`.
// Cloudflare Workers Builds runs `bun run build`, then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": true,
  // Workers Builds runs `wrangler preview` for a pull request's branch,
  // which refuses a config without this block. Empty: a preview takes
  // the assets and settings above as they are.
  "previews": {},
  "routes": [{ "pattern": "lkwplus.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Every internal link and canonical URL is slashless
    // (`trailingSlash: "never"` in astro.config.ts), so `/about` serves
    // `about/index.html` directly and `/about/` redirects to it.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
